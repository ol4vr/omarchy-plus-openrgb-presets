def _atomic_text(path: Path, text: str) -> None:
    _private_directory(path.parent)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def _fsync_directory(path: Path) -> None:
    directory_fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def _preserve_evidence(raw: bytes, reference: str, kind: str = "failure") -> Path:
    evidence_root = state_root() / "recovery-evidence"
    _private_directory(state_root())
    _private_directory(evidence_root)
    destination = evidence_root / f"{reference}.{kind}.json"
    try:
        descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        if _read_protected_bytes(destination, f"retained {kind} evidence") != raw:
            raise RecoveryBlocked(
                "Recovery blocked: retained evidence does not match the current record."
            )
        return destination
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
    except BaseException:
        try:
            destination.unlink()
        except FileNotFoundError:
            pass
        raise
    if destination.read_bytes() != raw:
        raise RecoveryBlocked(
            "Recovery blocked: retained evidence readback did not match."
        )
    _fsync_directory(evidence_root)
    return destination


def _preserve_stability_evidence(
    reviewed: ReviewedHardwareHealth, stability: StabilityEvidence
) -> Path:
    evidence_root = state_root() / "recovery-evidence"
    _private_directory(state_root())
    _private_directory(evidence_root)
    destination = evidence_root / (
        f"{reviewed.incident_reference}.hardware-health-observation"
    )
    try:
        destination.mkdir(mode=0o700)
    except FileExistsError:
        _require_private_directory(
            destination, "retained hardware-health observation directory"
        )
    expected = dict(stability.files)
    try:
        existing = {entry.name for entry in destination.iterdir()}
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: retained hardware-health observation is unreadable."
        ) from error
    if not existing.issubset(expected):
        raise RecoveryBlocked(
            "Recovery blocked: retained hardware-health observation has extra files."
        )
    for name, raw in stability.files:
        path = destination / name
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            if (
                _read_protected_bytes(path, f"retained stability evidence {name}")
                != raw
            ):
                raise RecoveryBlocked(
                    "Recovery blocked: retained hardware-health observation changed."
                )
            continue
        try:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(raw)
                handle.flush()
                os.fsync(handle.fileno())
        except BaseException:
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            raise
        if _read_protected_bytes(path, f"retained stability evidence {name}") != raw:
            raise RecoveryBlocked(
                "Recovery blocked: retained hardware-health observation readback changed."
            )
    if {entry.name for entry in destination.iterdir()} != set(expected):
        raise RecoveryBlocked(
            "Recovery blocked: retained hardware-health observation is incomplete."
        )
    _fsync_directory(destination)
    _fsync_directory(evidence_root)
    return destination


