def _process_start_token(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()[19]
    except (IndexError, OSError) as error:
        raise SafetyStop(f"process {pid} identity is unreadable") from error


def _process_argv(pid: int) -> tuple[str, ...]:
    try:
        return tuple(
            item.decode("utf-8", errors="surrogateescape")
            for item in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")[:-1]
        )
    except OSError as error:
        raise SafetyStop(f"process {pid} command is unreadable") from error


def _process_parent(pid: int, proc_root: Path = Path("/proc")) -> int:
    status = (proc_root / str(pid) / "status").read_text(encoding="utf-8")
    for line in status.splitlines():
        if line.startswith("PPid:"):
            return int(line.split(":", 1)[1].strip())
    raise ValueError(f"process {pid} parent is unreadable")


def _is_descendant(pid: int, owner_pid: int, proc_root: Path) -> bool:
    current = pid
    visited: set[int] = set()
    while current > 1 and current not in visited:
        visited.add(current)
        current = _process_parent(current, proc_root)
        if current == owner_pid:
            return True
    return False


def _independent_lifecycle_pids(
    owner_pid: int, proc_root: Path = Path("/proc")
) -> tuple[int, ...]:
    """Return the verified owner and any same-argv non-descendant processes."""

    matches: list[int] = []
    for cmdline_path in proc_root.glob("[0-9]*/cmdline"):
        try:
            pid = int(cmdline_path.parent.name)
            argv = tuple(
                item.decode("utf-8", errors="surrogateescape")
                for item in cmdline_path.read_bytes().split(b"\0")[:-1]
            )
        except (OSError, ValueError):
            continue
        if argv != LIFECYCLE_ARGV:
            continue
        if pid == owner_pid:
            matches.append(pid)
            continue
        try:
            descendant = _is_descendant(pid, owner_pid, proc_root)
        except FileNotFoundError:
            continue
        except (OSError, ValueError):
            descendant = False
        if not descendant:
            matches.append(pid)
    return tuple(sorted(matches))


class _Reader:
    def __init__(self, data: bytes) -> None:
        self.data = data
        self.offset = 0

    def take(self, size: int) -> bytes:
        if size < 0 or self.offset + size > len(self.data):
            raise SafetyStop("OpenRGB returned truncated SDK data")
        value = self.data[self.offset : self.offset + size]
        self.offset += size
        return value

    def u16(self) -> int:
        return struct.unpack("<H", self.take(2))[0]

    def u32(self) -> int:
        return struct.unpack("<I", self.take(4))[0]

    def i32(self) -> int:
        return struct.unpack("<i", self.take(4))[0]

    def string(self) -> str:
        raw = self.take(self.u16())
        if not raw or raw[-1] != 0:
            raise SafetyStop("OpenRGB returned an invalid SDK string")
        return raw[:-1].decode("utf-8", errors="replace")


def _read_exact(connection: socket.socket, size: int) -> bytes:
    data = bytearray()
    while len(data) < size:
        chunk = connection.recv(size - len(data))
        if not chunk:
            raise SafetyStop("OpenRGB closed the SDK connection")
        data.extend(chunk)
    return bytes(data)


def _send_packet(
    connection: socket.socket, index: int, packet: int, payload: bytes = b""
) -> None:
    connection.sendall(HEADER.pack(MAGIC, index, packet, len(payload)) + payload)


def _request(
    connection: socket.socket, index: int, packet: int, payload: bytes = b""
) -> bytes:
    _send_packet(connection, index, packet, payload)
    magic, _index, returned, size = HEADER.unpack(_read_exact(connection, HEADER.size))
    if magic != MAGIC or returned != packet or size > MAX_PACKET_SIZE:
        raise SafetyStop("OpenRGB returned an invalid SDK packet")
    return _read_exact(connection, size)


def _unpack_color(color: int) -> str:
    return f"#{color & 0xFF:02X}{(color >> 8) & 0xFF:02X}{(color >> 16) & 0xFF:02X}"


def _pack_color(color: str) -> int:
    if not re.fullmatch(r"#[0-9A-F]{6}", color):
        raise SafetyStop(f"invalid RGB color: {color}")
    return (
        int(color[1:3], 16) | (int(color[3:5], 16) << 8) | (int(color[5:7], 16) << 16)
    )


def _parse_controller(index: int, data: bytes) -> ControllerSnapshot:
    reader = _Reader(data)
    reader.u32()
    reader.i32()
    name = reader.string()
    for _ in range(4):
        reader.string()
    location = reader.string()
    mode_count = reader.u16()
    active_mode = reader.i32()
    modes: list[str] = []
    for _ in range(mode_count):
        modes.append(reader.string())
        reader.i32()
        reader.u32()
        for _ in range(10):
            reader.u32()
        for _ in range(reader.u16()):
            reader.u32()
    for _ in range(reader.u16()):
        reader.string()
        reader.i32()
        reader.u32()
        reader.u32()
        reader.u32()
        reader.take(reader.u16())
        for _ in range(reader.u16()):
            reader.string()
            reader.i32()
            reader.u32()
            reader.u32()
    led_count = reader.u16()
    for _ in range(led_count):
        reader.string()
        reader.u32()
    colors = tuple(_unpack_color(reader.u32()) for _ in range(reader.u16()))
    mode = modes[active_mode] if 0 <= active_mode < len(modes) else ""
    return ControllerSnapshot(index, name, location, mode, led_count, colors)


class OpenRGBSDK:
    """One non-detecting SDK connection and one serialized write lock."""

    def __init__(self) -> None:
        self.connection: socket.socket | None = None
        self.lock = threading.Lock()

    def open(self) -> None:
        try:
            self.connection = socket.create_connection((HOST, PORT), timeout=2)
            self.connection.settimeout(2)
        except OSError as error:
            raise SafetyStop(f"OpenRGB SDK connection failed: {error}") from error

    def close(self) -> None:
        if self.connection is not None:
            self.connection.close()
            self.connection = None

    def _connection(self) -> socket.socket:
        if self.connection is None:
            raise SafetyStop("OpenRGB SDK is not connected")
        return self.connection

    def inventory(self) -> tuple[ControllerSnapshot, ...]:
        try:
            with self.lock:
                connection = self._connection()
                count_data = _request(connection, 0, REQUEST_CONTROLLER_COUNT)
                if len(count_data) != 4:
                    raise SafetyStop("invalid OpenRGB controller count")
                count = struct.unpack("<I", count_data)[0]
                return tuple(
                    _parse_controller(
                        index,
                        _request(
                            connection,
                            index,
                            REQUEST_CONTROLLER_DATA,
                            struct.pack("<I", PROTOCOL_VERSION),
                        ),
                    )
                    for index in range(count)
                )
        except OSError as error:
            raise SafetyStop(f"OpenRGB SDK inventory failed: {error}") from error

    def active_effects(self) -> tuple[str, ...]:
        try:
            with self.lock:
                connection = self._connection()
                plugins = _Reader(_request(connection, 0, REQUEST_PLUGIN_LIST))
                plugins.u32()
                effects_index = None
                for _ in range(plugins.u16()):
                    name = plugins.string()
                    plugins.string()
                    plugins.string()
                    index = plugins.u32()
                    plugins.u32()
                    if name == EFFECTS_PLUGIN_NAME:
                        effects_index = index
                if effects_index is None:
                    raise SafetyStop("OpenRGB Effects Plugin is not loaded")
                data = _Reader(
                    _request(
                        connection,
                        effects_index,
                        PLUGIN_SPECIFIC,
                        struct.pack("<I", REQUEST_EFFECT_LIST),
                    )
                )
                if data.u32() != REQUEST_EFFECT_LIST:
                    raise SafetyStop("Effects Plugin returned the wrong packet")
                data.u32()
                active: list[str] = []
                for _ in range(data.u16()):
                    effect_name = data.string()
                    data.string()
                    if data.take(1) != b"\0":
                        active.append(effect_name)
                return tuple(active)
        except OSError as error:
            raise SafetyStop(f"Effects SDK query failed: {error}") from error

    def update_leds(self, index: int, colors: Sequence[str]) -> None:
        values = tuple(_pack_color(color) for color in core.validate_colors(colors))
        payload = struct.pack("<IH", 4 + 2 + 4 * len(values), len(values))
        payload += struct.pack(f"<{len(values)}I", *values)
        try:
            with self.lock:
                _send_packet(self._connection(), index, UPDATE_LEDS, payload)
        except OSError as error:
            raise HardwareWriteFailure(f"OpenRGB UPDATELEDS failed: {error}") from error


class LinuxHealth:
    def __init__(
        self,
        server: ServerIdentity,
        lifecycle: LifecycleIdentity,
        sysfs_root: Path = Path("/sys/bus/i2c/devices"),
    ) -> None:
        self.server = server
        self.lifecycle = lifecycle
        self.sysfs_root = sysfs_root
        self.kernel_baseline = ""
        self.kernel_cursor = ""
        self.last_temperatures: dict[str, tuple[int, float]] = {}

    def begin(self) -> None:
        output = self._journal(["-n", "0", "--show-cursor"])
        cursor = self._cursor(output)
        self.kernel_baseline = cursor
        self.kernel_cursor = cursor

    @staticmethod
    def _journal(extra: Sequence[str]) -> str:
        try:
            return subprocess.run(
                ["journalctl", "-b", "-k", "--no-pager", *extra],
                check=True,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
            ).stdout
        except (OSError, subprocess.CalledProcessError) as error:
            raise SafetyStop("current-boot kernel journal is unreadable") from error

    @staticmethod
    def _cursor(output: str) -> str:
        for line in reversed(output.splitlines()):
            if line.startswith("-- cursor: "):
                return line.removeprefix("-- cursor: ")
        raise SafetyStop("journalctl did not return a cursor")

    def verify_immediate_identity(self) -> None:
        if (
            _process_start_token(self.server.pid) != self.server.start_token
            or _process_argv(self.server.pid) != SERVER_ARGV
        ):
            raise SafetyStop("OpenRGB SDK process identity changed")
        if (
            _process_start_token(self.lifecycle.pid) != self.lifecycle.start_token
            or _process_argv(self.lifecycle.pid) != LIFECYCLE_ARGV
        ):
            raise SafetyStop("OpenRGB lifecycle process identity changed")

    def verify_processes(self) -> None:
        self.verify_immediate_identity()
        lifecycle_matches = _independent_lifecycle_pids(self.lifecycle.pid)
        if lifecycle_matches != (self.lifecycle.pid,):
            raise SafetyStop(
                f"expected one OpenRGB lifecycle, found {len(lifecycle_matches)}"
            )
        try:
            listeners = (
                subprocess.run(
                    ["ss", "-H", "-ltnp", f"sport = :{PORT}"],
                    check=True,
                    text=True,
                    capture_output=True,
                )
                .stdout.strip()
                .splitlines()
            )
        except (OSError, subprocess.CalledProcessError) as error:
            raise SafetyStop("OpenRGB listener ownership is unreadable") from error
        if (
            len(listeners) != 1
            or f"{HOST}:{PORT}" not in listeners[0]
            or not re.search(rf"\bpid={self.server.pid}(?:,|\))", listeners[0])
        ):
            raise SafetyStop("OpenRGB SDK listener ownership changed")
        try:
            boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
            suspends = int(Path("/sys/power/suspend_stats/success").read_text().strip())
        except (OSError, ValueError) as error:
            raise SafetyStop("boot or suspend continuity is unreadable") from error
        if (
            boot_id != self.lifecycle.boot_id
            or suspends != self.lifecycle.successful_suspends
        ):
            raise SafetyStop("boot or suspend continuity changed")

    def _temperature_evidence(
        self,
        endpoint: str,
        read_state: str,
        *,
        sensor: str = "temp1_input",
        error: BaseException | None = None,
        value_length: int | None = None,
    ) -> dict[str, object]:
        evidence: dict[str, object] = {
            "failure_kind": "spd5118-temperature",
            "endpoint": endpoint,
            "sensor": f"{endpoint}/hwmon/{sensor}",
            "read_state": read_state,
        }
        if error is not None:
            evidence["exception_type"] = type(error).__name__
            error_number = getattr(error, "errno", None)
            if isinstance(error_number, int):
                evidence["errno"] = error_number
        if value_length is not None:
            evidence["value_length"] = value_length
        previous = self.last_temperatures.get(endpoint)
        if previous is not None:
            evidence["last_successful_temperature_mc"] = previous[0]
            evidence["last_successful_unix"] = previous[1]
        return evidence

    def temperatures(self) -> Mapping[str, int]:
        values: dict[str, int] = {}
        for endpoint in SPD_ENDPOINTS:
            device = self.sysfs_root / endpoint
            try:
                if device.joinpath("driver").resolve().name != "spd5118":
                    raise SafetyStop(
                        f"{endpoint} is not bound to spd5118",
                        evidence=self._temperature_evidence(
                            endpoint, "wrong-driver", sensor="driver"
                        ),
                    )
            except OSError as error:
                raise SafetyStop(
                    f"{endpoint} driver binding is unreadable",
                    evidence=self._temperature_evidence(
                        endpoint,
                        "driver-read-error",
                        sensor="driver",
                        error=error,
                    ),
                ) from error
            paths = glob.glob(str(device / "hwmon/hwmon*/temp1_input"))
            if len(paths) != 1:
                raise SafetyStop(
                    f"{endpoint} has {len(paths)} temperature paths",
                    evidence={
                        **self._temperature_evidence(endpoint, "path-count"),
                        "path_count": len(paths),
                    },
                )
            try:
                raw = Path(paths[0]).read_text(encoding="utf-8")
            except OSError as error:
                raise SafetyStop(
                    f"{endpoint} temperature is unreadable",
                    evidence=self._temperature_evidence(
                        endpoint, "kernel-read-error", error=error
                    ),
                ) from error
            stripped = raw.strip()
            if not stripped:
                raise SafetyStop(
                    f"{endpoint} temperature is empty",
                    evidence=self._temperature_evidence(
                        endpoint, "empty", value_length=len(raw)
                    ),
                )
            try:
                value = int(stripped)
            except ValueError as error:
                raise SafetyStop(
                    f"{endpoint} temperature is malformed",
                    evidence=self._temperature_evidence(
                        endpoint, "malformed", error=error, value_length=len(raw)
                    ),
                ) from error
            if value <= 0:
                raise SafetyStop(
                    f"{endpoint} returned invalid temperature {value}",
                    evidence={
                        **self._temperature_evidence(endpoint, "invalid-value"),
                        "temperature_mc": value,
                    },
                )
            values[endpoint] = value
            self.last_temperatures[endpoint] = (value, time.time())
        return values

    def _verify_kernel_errors_after(self, cursor: str) -> str:
        if not cursor:
            raise SafetyStop("kernel journal baseline is missing")
        output = self._journal(["--after-cursor", cursor, "--show-cursor"])
        next_cursor = self._cursor(output)
        errors = [
            line for line in output.splitlines() if RELEVANT_KERNEL_ERROR.search(line)
        ]
        if errors:
            retained = tuple(line[:500] for line in errors[-8:])
            raise SafetyStop(
                "new relevant kernel error: " + " | ".join(retained),
                evidence={
                    "failure_kind": "kernel-communication",
                    "kernel_messages": retained,
                },
            )
        return next_cursor

    def failure_kernel_evidence(self) -> dict[str, object]:
        """Capture, but do not advance, relevant lines after the last clean cursor."""

        output = self._journal(["--after-cursor", self.kernel_cursor, "--show-cursor"])
        messages = tuple(
            line[:500]
            for line in output.splitlines()
            if RELEVANT_KERNEL_ERROR.search(line)
        )[-8:]
        return {
            "kernel_evidence_status": "captured",
            "kernel_messages": messages,
        }

    def no_new_kernel_errors(self) -> None:
        """Check and advance the writer's incremental journal cursor."""

        self.kernel_cursor = self._verify_kernel_errors_after(self.kernel_cursor)

    def no_kernel_errors_since_baseline(self) -> None:
        """Check the complete startup/resume window without moving its baseline."""

        self._verify_kernel_errors_after(self.kernel_baseline)


class EffectsContract:
    def __init__(self, preset: str, plugin_root: Path) -> None:
        self.expected: Counter[str] = Counter()
        profile_name = PROFILE_BY_PRESET.get(preset)
        if profile_name is None:
            return
        try:
            document = json.loads(
                (plugin_root / "effects-profiles" / profile_name).read_text()
            )
        except (OSError, json.JSONDecodeError) as error:
            raise SafetyStop(
                f"Effects profile is unreadable: {profile_name}"
            ) from error
        effects = document.get("Effects")
        if not isinstance(effects, list) or not effects:
            raise SafetyStop("Effects profile has no effects")
        zone_count = 0
        for effect in effects:
            if not isinstance(effect, dict) or not isinstance(
                effect.get("ControllerZones"), list
            ):
                raise SafetyStop("Effects profile metadata is invalid")
            name = effect.get("EffectClassName")
            if not isinstance(name, str):
                raise SafetyStop("Effects profile effect name is invalid")
            self.expected[LIVE_EFFECT_NAME_BY_CLASS.get(name, name)] += 1
            for zone in effect["ControllerZones"]:
                zone_count += 1
                if not isinstance(zone, dict):
                    raise SafetyStop("Effects profile zone is invalid")
                location = zone.get("location", "")
                if zone.get("name") == core.VERIFIED_DIMMS[0].name or (
                    isinstance(location, str)
                    and "/dev/i2c-10" in location
                    and re.search(r"address 0x1[89ABab]", location)
                ):
                    raise SafetyStop("Effects profile assigns a DDR5 controller")
        if zone_count != 6:
            raise SafetyStop(f"Effects profile has {zone_count} zones; expected six")

    def verify(self, active: Sequence[str]) -> None:
        if Counter(active) != self.expected:
            raise SafetyStop("live Effects instances changed or include DDR5")


def _targets(
    controllers: Sequence[ControllerSnapshot],
) -> dict[core.ControllerIdentity, ControllerSnapshot]:
    if len(controllers) != EXPECTED_CONTROLLER_COUNT:
        raise SafetyStop(f"expected seven controllers, found {len(controllers)}")
    targets: dict[core.ControllerIdentity, ControllerSnapshot] = {}
    for identity in core.VERIFIED_DIMMS:
        matches = [
            item
            for item in controllers
            if item.name == identity.name and item.location == identity.location
        ]
        if len(matches) != 1:
            raise SafetyStop(
                f"expected one DIMM at {identity.location}, found {len(matches)}"
            )
        target = matches[0]
        if (
            target.mode != "Direct"
            or target.led_count != core.LED_COUNT
            or len(target.colors) != core.LED_COUNT
        ):
            raise SafetyStop(f"DIMM is not twelve-LED Direct mode: {identity.location}")
        targets[identity] = target
    return targets


class RuntimeControl:
    def __init__(self) -> None:
        self.root = _runtime_root()
        _private_directory(self.root)
        self.stop_path = self.root / "ram-tetris.stop"
        self.write_lock_path = self.root / "ram-tetris-write.lock"
        self.status_path = self.root / "ram-tetris-status.json"
        self.failure_path = _state_root() / "ram-tetris-failure.json"

    @staticmethod
    def _verify_open_lock(path: Path, descriptor: int | None, label: str) -> None:
        if descriptor is None:
            raise SafetyStop(f"{label} ownership is unavailable")
        try:
            opened = os.fstat(descriptor)
            current = path.lstat()
        except OSError as error:
            raise SafetyStop(f"{label} ownership is unreadable") from error
        if (
            not stat.S_ISREG(current.st_mode)
            or current.st_uid != os.getuid()
            or opened.st_dev != current.st_dev
            or opened.st_ino != current.st_ino
        ):
            raise SafetyStop(f"{label} ownership changed")

    def verify_runtime_ownership(
        self, writer_lock_fd: int | None, write_lock_fd: int | None
    ) -> None:
        if self.failure_path.exists():
            raise SafetyStop("a persistent RAM Tetris failure is active")
        self._verify_open_lock(
            self.root / "ram-tetris.lock", writer_lock_fd, "writer singleton"
        )
        self._verify_open_lock(self.write_lock_path, write_lock_fd, "RGB write gate")

    def stop_request(self) -> StopRequest | None:
        try:
            value = json.loads(self.stop_path.read_text())
        except FileNotFoundError:
            return None
        except (OSError, json.JSONDecodeError) as error:
            raise SafetyStop("RAM Tetris stop request is unreadable") from error
        if not isinstance(value, dict) or value.get("reason") not in STOP_REASONS:
            raise SafetyStop("RAM Tetris stop request is invalid")
        reason = value["reason"]
        if reason in LOCAL_STOP_REASONS:
            return StopRequest(reason)
        lifecycle_pid = value.get("lifecycle_pid")
        lifecycle_start = value.get("lifecycle_start")
        server_pid = value.get("server_pid")
        server_start = value.get("server_start")
        if (
            not isinstance(lifecycle_pid, int)
            or isinstance(lifecycle_pid, bool)
            or lifecycle_pid <= 0
            or not isinstance(lifecycle_start, str)
            or not lifecycle_start
            or not isinstance(server_pid, int)
            or isinstance(server_pid, bool)
            or server_pid <= 0
            or not isinstance(server_start, str)
            or not server_start
        ):
            raise SafetyStop("lifecycle stop request is not authenticated")
        return StopRequest(
            reason,
            lifecycle_pid,
            lifecycle_start,
            server_pid,
            server_start,
        )

    def stop_reason(self) -> str | None:
        try:
            request = self.stop_request()
            return request.reason if request is not None else None
        except SafetyStop:
            return "invalid-stop-request"

    def publish_stop(self, request: StopRequest) -> None:
        value: dict[str, object] = {"reason": request.reason, "time": time.time()}
        if request.reason in LIFECYCLE_STOP_REASONS:
            value.update(
                lifecycle_pid=request.lifecycle_pid,
                lifecycle_start=request.lifecycle_start,
                server_pid=request.server_pid,
                server_start=request.server_start,
            )
        lock_fd = os.open(self.write_lock_path, os.O_WRONLY | os.O_CREAT, 0o600)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            _write_json(self.stop_path, value)
        finally:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
            os.close(lock_fd)

    def status(self, state: str, message: str, **extra: object) -> None:
        _write_json(
            self.status_path,
            {
                "state": state,
                "message": message,
                "pid": os.getpid(),
                "pid_start": _process_start_token(os.getpid()),
                **extra,
            },
        )

    def completed_local_stop(self, pid: int, start_token: str) -> str | None:
        try:
            value = json.loads(self.status_path.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            return None
        if (
            not isinstance(value, dict)
            or value.get("pid") != pid
            or value.get("pid_start") != start_token
        ):
            return None
        if (
            value.get("state") == "stopped"
            and value.get("message") == "RAM Tetris stopped for preset-change"
        ):
            return "preset-change"
        if (
            value.get("state") == "off"
            and value.get("message") == "RAM Tetris off; static DDR5 restored"
        ):
            return "user-off"
        return None

    def writer_started(self, pid: int, start_token: str) -> bool:
        try:
            value = json.loads(self.status_path.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            return False
        return bool(
            isinstance(value, dict)
            and value.get("pid") == pid
            and value.get("pid_start") == start_token
            and value.get("state") in {"starting", "running"}
        )

    def fail(self, message: str, evidence: Mapping[str, object] | None = None) -> None:
        value = {
            "state": "failed",
            "message": message,
            "pid": os.getpid(),
            "time": time.time(),
            "source": _source_provenance(),
        }
        if evidence:
            value["evidence_version"] = 1
            value["details"] = dict(evidence)
        _write_json_if_absent(self.failure_path, value)
        _write_json(self.status_path, value)


class TetrisWriter:
    def __init__(
        self,
        sdk: OpenRGBSDK,
        health: LinuxHealth,
        effects: EffectsContract,
        control: RuntimeControl,
        preset: str,
        write_lock_fd: int | None = None,
        writer_lock_fd: int | None = None,
        checkpoint_interval: float = HEALTH_CHECKPOINT_INTERVAL_SECONDS,
        checkpoint_timeout: float = HEALTH_CHECKPOINT_TIMEOUT_SECONDS,
    ) -> None:
        if checkpoint_interval <= 0 or checkpoint_timeout <= 0:
            raise ValueError("health checkpoint bounds must be positive")
        self.sdk = sdk
        self.health = health
        self.effects = effects
        self.control = control
        self.preset = preset
        self.write_lock_fd = write_lock_fd
        self.writer_lock_fd = writer_lock_fd
        self.checkpoint_interval = checkpoint_interval
        self.checkpoint_timeout = checkpoint_timeout
        self.expected: dict[core.ControllerIdentity, tuple[str, ...]] = {}
        self.last_global_write: float | None = None
        self.last_dimm_write: dict[core.ControllerIdentity, float] = {}
        self.stopping = False
        self.termination_signal: int | None = None
        self.requested_stop: str | None = None
        self.animation_writes = 0
        self.checkpoint: HealthCheckpoint | None = None
        self.checkpoint_failed = False
        self.checkpoint_started_monotonic: float | None = None
        self.checkpoint_started_unix: float | None = None
        self.checkpoint_phase = "idle"

    @contextmanager
    def _write_guard(self):
        if self.write_lock_fd is None:
            yield
            return
        fcntl.flock(self.write_lock_fd, fcntl.LOCK_SH)
        try:
            yield
        finally:
            fcntl.flock(self.write_lock_fd, fcntl.LOCK_UN)

    def request_termination(self, signum: int) -> None:
        self.termination_signal = signum
        self.stopping = True

    def _validated_stop_request(self) -> StopRequest | None:
        request = self.control.stop_request()
        if self.termination_signal is not None and (
            request is None or request.reason not in LIFECYCLE_STOP_REASONS
        ):
            raise SafetyStop(
                "writer termination was not preceded by an authenticated "
                "lifecycle stop request"
            )
        if request is None:
            return None
        if request.reason in LIFECYCLE_STOP_REASONS and (
            request.lifecycle_pid != self.health.lifecycle.pid
            or request.lifecycle_start != self.health.lifecycle.start_token
            or request.server_pid != self.health.server.pid
            or request.server_start != self.health.server.start_token
        ):
            raise SafetyStop("lifecycle stop request identity does not match writer")
        self.requested_stop = request.reason
        self.stopping = True
        return request

    def _lightweight_gate(self, *, require_fresh_checkpoint: bool) -> None:
        self.control.verify_runtime_ownership(self.writer_lock_fd, self.write_lock_fd)
        self.health.verify_immediate_identity()
        if self.checkpoint_failed:
            raise SafetyStop("RAM Tetris health checkpoint previously failed")
        if not _preference():
            if self.requested_stop == "user-off":
                self.stopping = True
            else:
                raise SafetyStop("RAM Tetris preference changed")
        if _selected_preset() != self.preset:
            raise SafetyStop("selected preset changed")
        if not require_fresh_checkpoint:
            return
        if self.checkpoint is None:
            raise SafetyStop("RAM Tetris health checkpoint is unavailable")
        age = time.monotonic() - self.checkpoint.completed_monotonic
        if age < 0 or age > self.checkpoint_interval:
            raise SafetyStop(
                "RAM Tetris health checkpoint is expired",
                evidence={
                    "failure_kind": "checkpoint-expired",
                    "checkpoint_age_ms": round(age * 1000, 3),
                    "checkpoint_interval_ms": round(self.checkpoint_interval * 1000, 3),
                },
            )

    def _full_health_checkpoint(self) -> HealthCheckpoint:
        started_monotonic = time.monotonic()
        started_unix = time.time()
        self.checkpoint_started_monotonic = started_monotonic
        self.checkpoint_started_unix = started_unix
        try:
            with _bounded_operation(
                self.checkpoint_timeout, "RAM Tetris health checkpoint"
            ):
                self.checkpoint_phase = "process-and-listener-identity"
                self.health.verify_processes()
                self.checkpoint_phase = "spd5118-temperatures"
                temperatures = dict(self.health.temperatures())
                self.checkpoint_phase = "kernel-journal"
                self.health.no_new_kernel_errors()
                self.checkpoint_phase = "controller-inventory"
                controllers = _targets(self.sdk.inventory())
                self.checkpoint_phase = "effects-contract"
                self.effects.verify(self.sdk.active_effects())
                self.checkpoint_phase = "controller-state"
                if self.expected:
                    for identity, colors in self.expected.items():
                        if controllers[identity].colors != colors:
                            raise SafetyStop(
                                "DIMM state changed outside the Tetris writer: "
                                f"{identity.location}"
                            )
                completed_monotonic = time.monotonic()
                duration = completed_monotonic - started_monotonic
                if duration < 0 or duration > self.checkpoint_timeout:
                    raise SafetyStop(
                        "RAM Tetris health checkpoint exceeded its deadline",
                        evidence={
                            "failure_kind": "checkpoint-timeout",
                            "checkpoint_duration_ms": round(duration * 1000, 3),
                            "checkpoint_deadline_ms": round(
                                self.checkpoint_timeout * 1000, 3
                            ),
                        },
                    )
                checkpoint = HealthCheckpoint(
                    controllers=controllers,
                    temperatures=temperatures,
                    completed_monotonic=completed_monotonic,
                    completed_unix=time.time(),
                    duration_seconds=duration,
                )
        except SafetyStop as error:
            self.checkpoint_failed = True
            raise SafetyStop(
                str(error),
                evidence={
                    **error.evidence,
                    "checkpoint_phase": self.checkpoint_phase,
                },
            ) from error
        self.checkpoint_phase = "idle"
        self.checkpoint = checkpoint
        return checkpoint

    def _ensure_health_checkpoint(self) -> tuple[HealthCheckpoint, bool]:
        now = time.monotonic()
        if self.checkpoint is not None:
            age = now - self.checkpoint.completed_monotonic
            if age < 0:
                self.checkpoint_failed = True
                raise SafetyStop(
                    "RAM Tetris monotonic checkpoint time moved backwards",
                    evidence={
                        "failure_kind": "checkpoint-clock",
                        "checkpoint_age_ms": round(age * 1000, 3),
                    },
                )
            if age <= self.checkpoint_interval:
                return self.checkpoint, False
        return self._full_health_checkpoint(), True

    def failure_evidence(self, error: SafetyStop) -> dict[str, object]:
        now = time.monotonic()
        details: dict[str, object] = {
            "failure_kind": "safety-stop",
            "writer_progress_count": self.animation_writes,
            "checkpoint_interval_ms": round(self.checkpoint_interval * 1000, 3),
            "checkpoint_deadline_ms": round(self.checkpoint_timeout * 1000, 3),
        }
        details.update(error.evidence)
        if self.checkpoint_started_monotonic is not None:
            details["checkpoint_started_unix"] = self.checkpoint_started_unix
            details["checkpoint_elapsed_ms"] = round(
                max(0.0, now - self.checkpoint_started_monotonic) * 1000, 3
            )
        if self.checkpoint is not None:
            details["last_checkpoint_completed_unix"] = self.checkpoint.completed_unix
            details["last_checkpoint_duration_ms"] = round(
                self.checkpoint.duration_seconds * 1000, 3
            )
            details["last_checkpoint_age_ms"] = round(
                max(0.0, now - self.checkpoint.completed_monotonic) * 1000, 3
            )
            details["last_temperatures_mc"] = dict(self.checkpoint.temperatures)
        if "kernel_messages" not in details:
            try:
                with _bounded_operation(
                    FAILURE_KERNEL_CAPTURE_TIMEOUT_SECONDS,
                    "RAM Tetris failure kernel capture",
                ):
                    details.update(self.health.failure_kernel_evidence())
            except SafetyStop as capture_error:
                details["kernel_evidence_status"] = "unavailable"
                details["kernel_evidence_error"] = str(capture_error)
        return details

    def _sleep_until(self, target: float) -> None:
        while True:
            if self.stopping or self.control.stop_reason() is not None:
                return
            delay = target - time.monotonic()
            if delay <= 0:
                return
            time.sleep(min(delay, 0.05))

    def _write(
        self, identity: core.ControllerIdentity, colors: tuple[str, ...]
    ) -> bool:
        with self._write_guard():
            if self._validated_stop_request() is not None:
                return False
            self._lightweight_gate(require_fresh_checkpoint=False)
            checkpoint, refreshed = self._ensure_health_checkpoint()
            if self._validated_stop_request() is not None:
                return False
            try:
                self._lightweight_gate(require_fresh_checkpoint=True)
            except SafetyStop as error:
                if (
                    refreshed
                    or error.evidence.get("failure_kind") != "checkpoint-expired"
                ):
                    raise
                trigger_age = error.evidence.get("checkpoint_age_ms")
                try:
                    checkpoint = self._full_health_checkpoint()
                except SafetyStop as refresh_error:
                    raise SafetyStop(
                        str(refresh_error),
                        evidence={
                            **refresh_error.evidence,
                            "checkpoint_refresh_attempts": 1,
                            "checkpoint_refresh_result": "health-check-failed",
                            "checkpoint_refresh_trigger_age_ms": trigger_age,
                        },
                    ) from refresh_error
                refreshed = True
                if self._validated_stop_request() is not None:
                    return False
                try:
                    self._lightweight_gate(require_fresh_checkpoint=True)
                except SafetyStop as refresh_error:
                    result = "post-refresh-gate-failed"
                    evidence = {
                        **refresh_error.evidence,
                        "checkpoint_refresh_attempts": 1,
                        "checkpoint_refresh_trigger_age_ms": trigger_age,
                    }
                    if (
                        refresh_error.evidence.get("failure_kind")
                        == "checkpoint-expired"
                    ):
                        self.checkpoint_failed = True
                        result = "refreshed-checkpoint-expired"
                        evidence["refreshed_checkpoint_age_ms"] = (
                            refresh_error.evidence.get("checkpoint_age_ms")
                        )
                    evidence["checkpoint_refresh_result"] = result
                    raise SafetyStop(
                        str(refresh_error), evidence=evidence
                    ) from refresh_error
            if colors == self.expected[identity]:
                raise SafetyStop("scheduler produced a redundant frame")
            self.sdk.update_leds(checkpoint.controllers[identity].index, colors)
        now = time.monotonic()
        self.last_global_write = now
        self.last_dimm_write[identity] = now
        self.expected[identity] = colors
        self.animation_writes += 1
        if refreshed:
            self.control.status(
                "running",
                "RAM Tetris active",
                preset=self.preset,
                writes=self.animation_writes,
                temperatures_mc=dict(checkpoint.temperatures),
                checkpoint_completed_unix=checkpoint.completed_unix,
                checkpoint_duration_ms=round(checkpoint.duration_seconds * 1000, 3),
            )
        return True

    def _restore_static(self) -> bool:
        static = core.static_pattern_for(self.preset)
        for identity in core.VERIFIED_DIMMS:
            with self._write_guard():
                request = self._validated_stop_request()
                if request is None or request.reason != "user-off":
                    return False
                self._lightweight_gate(require_fresh_checkpoint=False)
                with _bounded_operation(
                    self.checkpoint_timeout, "RAM Tetris restoration health gate"
                ):
                    controllers, _ = self._health_gate_for_restoration()
                request = self._validated_stop_request()
                if request is None or request.reason != "user-off":
                    return False
                self._lightweight_gate(require_fresh_checkpoint=False)
                if controllers[identity].colors == static:
                    self.expected[identity] = static
                    continue
                self.sdk.update_leds(controllers[identity].index, static)
                self.expected[identity] = static
                with _bounded_operation(
                    self.checkpoint_timeout, "RAM Tetris restoration verification"
                ):
                    self._health_gate_for_restoration()
        return True

    def _health_gate_for_restoration(
        self,
    ) -> tuple[dict[core.ControllerIdentity, ControllerSnapshot], Mapping[str, int]]:
        self.health.verify_processes()
        if _selected_preset() != self.preset:
            raise SafetyStop("selected preset changed before restoration")
        temperatures = self.health.temperatures()
        self.health.no_new_kernel_errors()
        controllers = _targets(self.sdk.inventory())
        self.effects.verify(self.sdk.active_effects())
        for identity, colors in self.expected.items():
            if controllers[identity].colors != colors:
                raise SafetyStop(
                    f"DIMM state changed before restoration: {identity.location}"
                )
        return controllers, temperatures

    def run(self) -> None:
        with _bounded_operation(
            self.checkpoint_timeout, "RAM Tetris kernel journal baseline"
        ):
            self.health.begin()
        with self._write_guard():
            initial_request = self._validated_stop_request()
            if initial_request is not None and initial_request.reason != "user-off":
                self.control.status(
                    "stopped",
                    f"RAM Tetris stopped for {initial_request.reason}",
                    preset=self.preset,
                    writes=0,
                )
                return
            self._lightweight_gate(require_fresh_checkpoint=False)
            checkpoint, _ = self._ensure_health_checkpoint()
            self._lightweight_gate(require_fresh_checkpoint=True)
        self.expected = {
            identity: target.colors
            for identity, target in checkpoint.controllers.items()
        }
        streams = list(core.default_streams(self.preset))
        origin = time.monotonic()
        self.control.status(
            "running",
            "RAM Tetris active",
            preset=self.preset,
            writes=0,
            temperatures_mc=dict(checkpoint.temperatures),
            checkpoint_completed_unix=checkpoint.completed_unix,
            checkpoint_duration_ms=round(checkpoint.duration_seconds * 1000, 3),
        )
        while not self.stopping:
            if self._validated_stop_request() is not None:
                break
            stream = min(streams, key=lambda item: (item.due, item.identity.location))
            target = origin + float(stream.due)
            if self.last_global_write is not None:
                target = max(target, self.last_global_write + 0.05)
            if stream.identity in self.last_dimm_write:
                target = max(target, self.last_dimm_write[stream.identity] + 0.2)
            self._sleep_until(target)
            if self.stopping:
                break
            colors = stream.frame.colors
            if self._write(stream.identity, colors):
                stream.advance(
                    Fraction.from_float(time.monotonic() - origin).limit_denominator(
                        1_000_000
                    )
                )

        request = self._validated_stop_request()
        reason = request.reason if request is not None else "lifecycle-exit"
        if reason == "user-off":
            if self._restore_static():
                self.control.status(
                    "off",
                    "RAM Tetris off; static DDR5 restored",
                    preset=self.preset,
                    writes=self.animation_writes,
                )
            else:
                request = self._validated_stop_request()
                reason = request.reason if request is not None else "lifecycle-exit"
                self.control.status(
                    "stopped",
                    f"RAM Tetris stopped for {reason}",
                    preset=self.preset,
                    writes=self.animation_writes,
                )
        else:
            self.control.status(
                "stopped",
                f"RAM Tetris stopped for {reason}",
                preset=self.preset,
                writes=self.animation_writes,
            )


def _status_document(control: RuntimeControl) -> dict[str, object]:
    preference = _preference()
    if control.failure_path.exists():
        try:
            failure = json.loads(control.failure_path.read_text())
        except (OSError, json.JSONDecodeError):
            failure = {
                "state": "failed",
                "message": "RAM Tetris failure state is unreadable",
            }
        failure["preference"] = preference
        return failure
    try:
        preset = _selected_preset()
    except SafetyStop:
        preset = "unknown"
    if not preference:
        try:
            status = json.loads(control.status_path.read_text())
        except (OSError, json.JSONDecodeError):
            status = {}
        if control.stop_reason() == "user-off" and status.get("state") == "running":
            return {
                "preference": False,
                "state": "stopping",
                "message": "Stopping; safe static restoration pending",
            }
        return {"preference": False, "state": "off", "message": "Static DDR5 lighting"}
    if preset == "black":
        return {
            "preference": True,
            "state": "paused-black",
            "message": "Enabled; paused for Black preset",
        }
    try:
        status = json.loads(control.status_path.read_text())
    except (OSError, json.JSONDecodeError):
        status = {"state": "waiting", "message": "Enabled; waiting for safe startup"}
    status["preference"] = True
    return status


def _request_stop(
    control: RuntimeControl,
    reason: str,
    lifecycle_pid: int | None = None,
    lifecycle_start: str | None = None,
    server_pid: int | None = None,
    server_start: str | None = None,
) -> None:
    control.publish_stop(
        StopRequest(
            reason,
            lifecycle_pid,
            lifecycle_start,
            server_pid,
            server_start,
        )
    )


def _lifecycle_identity(pid: int, token: str) -> LifecycleIdentity:
    if _process_start_token(pid) != token:
        raise SafetyStop("lifecycle start token does not match")
    try:
        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        suspends = int(Path("/sys/power/suspend_stats/success").read_text().strip())
    except (OSError, ValueError) as error:
        raise SafetyStop("boot or suspend baseline is unreadable") from error
    return LifecycleIdentity(pid, token, boot_id, suspends)


def _run(args: argparse.Namespace) -> int:
    control = RuntimeControl()
    if (
        not _preference()
        or _selected_preset() == "black"
        or control.failure_path.exists()
    ):
        return 0
    lock_path = control.root / "ram-tetris.lock"
    lock_fd = os.open(lock_path, os.O_WRONLY | os.O_CREAT, 0o600)
    write_lock_fd = os.open(control.write_lock_path, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 75
        try:
            if control.stop_request() is not None:
                return 76
        except SafetyStop as error:
            control.fail(str(error))
            print(f"RAM Tetris refused startup: {error}", file=sys.stderr)
            return 1
        control.status("starting", "RAM Tetris writer owns singleton")
        sdk = OpenRGBSDK()
        writer: TetrisWriter | None = None

        def stop(_signum: int, _frame: object) -> None:
            if writer is not None:
                writer.request_termination(_signum)

        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        try:
            lifecycle = _lifecycle_identity(args.lifecycle_pid, args.lifecycle_start)
            server = ServerIdentity(args.server_pid, args.server_start)
            sdk.open()
            preset = _selected_preset()
            writer = TetrisWriter(
                sdk,
                LinuxHealth(server, lifecycle),
                EffectsContract(preset, Path(__file__).resolve().parent),
                control,
                preset,
                write_lock_fd,
                lock_fd,
            )
            writer.run()
        except SafetyStop as error:
            if writer is not None:
                try:
                    request = writer._validated_stop_request()
                except SafetyStop:
                    request = None
                if request is not None and request.reason in LIFECYCLE_STOP_REASONS:
                    control.status(
                        "stopped",
                        f"RAM Tetris stopped for {request.reason}",
                        preset=writer.preset,
                        writes=writer.animation_writes,
                    )
                    return 0
            evidence = writer.failure_evidence(error) if writer is not None else None
            control.fail(str(error), evidence)
            print(f"RAM Tetris stopped without restoration: {error}", file=sys.stderr)
            return 1
        except Exception as error:  # noqa: BLE001 - fail-closed hardware boundary
            control.fail(f"unexpected writer failure: {error}")
            print(
                "RAM Tetris stopped without restoration: "
                f"unexpected writer failure: {error}",
                file=sys.stderr,
            )
            return 1
        finally:
            sdk.close()
        return 0
    finally:
        os.close(write_lock_fd)
        os.close(lock_fd)


def _hardware_health(
    args: argparse.Namespace,
    *,
    attempts: int = 1,
    retry_delay: float = 0.0,
) -> tuple[LifecycleIdentity, ServerIdentity, Mapping[str, int], int]:
    """Validate one complete, bounded hardware-discovery window read-only."""

    if attempts < 1 or retry_delay < 0:
        raise ValueError("hardware health retry bounds are invalid")

    lifecycle = _lifecycle_identity(args.lifecycle_pid, args.lifecycle_start)
    server = ServerIdentity(args.server_pid, args.server_start)
    health = LinuxHealth(server, lifecycle)
    health.begin()
    last_error: SafetyStop | None = None

    for attempt in range(attempts):
        sdk = OpenRGBSDK()
        attempt_error: SafetyStop | None = None
        temperatures: Mapping[str, int] = {}
        dimm_count = 0
        try:
            sdk.open()
            health.verify_processes()
            temperatures = health.temperatures()
            dimm_count = len(_targets(sdk.inventory()))
        except SafetyStop as error:
            attempt_error = error
        finally:
            sdk.close()

        # Always check from the original pre-discovery cursor.  A clean later
        # inventory must never erase an error emitted by an earlier attempt.
        health.no_kernel_errors_since_baseline()
        if attempt_error is None:
            return lifecycle, server, temperatures, dimm_count

        last_error = attempt_error
        if attempt + 1 < attempts:
            time.sleep(retry_delay)

    if last_error is None:  # pragma: no cover - guarded by attempts >= 1
        raise SafetyStop("hardware health validation did not run")
    raise last_error


def _validate_hardware(args: argparse.Namespace) -> int:
    """Run the pre-restore hardware gate without performing an RGB write."""

    lifecycle, server, temperatures, dimm_count = _hardware_health(
        args,
        attempts=HARDWARE_GATE_ATTEMPTS,
        retry_delay=HARDWARE_GATE_RETRY_SECONDS,
    )
    print(
        json.dumps(
            {
                "controller_count": EXPECTED_CONTROLLER_COUNT,
                "dimm_count": dimm_count,
                "lifecycle_pid": lifecycle.pid,
                "lifecycle_start": lifecycle.start_token,
                "server_pid": server.pid,
                "server_start": server.start_token,
                "temperatures_mc": temperatures,
            },
            sort_keys=True,
        )
    )
    return 0


def _validate_health(args: argparse.Namespace) -> int:
    """Run the complete read-only successor gate without starting a writer."""

    lifecycle, server, temperatures, dimm_count = _hardware_health(args)
    sdk = OpenRGBSDK()
    try:
        sdk.open()
        preset = _selected_preset()
        EffectsContract(preset, Path(__file__).resolve().parent).verify(
            sdk.active_effects()
        )
    finally:
        sdk.close()
    print(
        json.dumps(
            {
                "controller_count": EXPECTED_CONTROLLER_COUNT,
                "dimm_count": dimm_count,
                "lifecycle_pid": lifecycle.pid,
                "lifecycle_start": lifecycle.start_token,
                "preset": preset,
                "server_pid": server.pid,
                "server_start": server.start_token,
                "temperatures_mc": temperatures,
            },
            sort_keys=True,
        )
    )
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_subparsers(dest="action", required=True)
    run = actions.add_parser("run")
    run.add_argument("--server-pid", type=int, required=True)
    run.add_argument("--server-start", required=True)
    run.add_argument("--lifecycle-pid", type=int, required=True)
    run.add_argument("--lifecycle-start", required=True)
    validate = actions.add_parser("validate-health")
    validate.add_argument("--server-pid", type=int, required=True)
    validate.add_argument("--server-start", required=True)
    validate.add_argument("--lifecycle-pid", type=int, required=True)
    validate.add_argument("--lifecycle-start", required=True)
    validate_hardware = actions.add_parser("validate-hardware")
    validate_hardware.add_argument("--server-pid", type=int, required=True)
    validate_hardware.add_argument("--server-start", required=True)
    validate_hardware.add_argument("--lifecycle-pid", type=int, required=True)
    validate_hardware.add_argument("--lifecycle-start", required=True)
    actions.add_parser("status")
    actions.add_parser("enable")
    actions.add_parser("disable")
    stop = actions.add_parser("request-stop")
    stop.add_argument(
        "reason",
        choices=("user-off", "preset-change", "suspend", "handoff", "shutdown"),
    )
    stop.add_argument("--server-pid", type=int)
    stop.add_argument("--server-start")
    stop.add_argument("--lifecycle-pid", type=int)
    stop.add_argument("--lifecycle-start")
    actions.add_parser("clear-stop")
    completed_stop = actions.add_parser("completed-local-stop")
    completed_stop.add_argument("--pid", type=int, required=True)
    completed_stop.add_argument("--start", required=True)
    writer_started = actions.add_parser("writer-started")
    writer_started.add_argument("--pid", type=int, required=True)
    writer_started.add_argument("--start", required=True)
    clear_failure = actions.add_parser("clear-failure")
    clear_failure.add_argument(
        "--acknowledge-reviewed-recovery", action="store_true", required=True
    )
    fail = actions.add_parser("fail")
    fail.add_argument("message")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    control = RuntimeControl()
    if args.action == "status":
        print(json.dumps(_status_document(control), sort_keys=True))
        return 0
    if args.action == "validate-health":
        return _validate_health(args)
    if args.action == "validate-hardware":
        return _validate_hardware(args)
    if args.action == "enable":
        _atomic_text(_state_root() / "ram-tetris-enabled", "on\n")
        try:
            control.stop_path.unlink()
        except FileNotFoundError:
            pass
        print("RAM Tetris preference enabled")
        return 0
    if args.action == "disable":
        _request_stop(control, "user-off")
        _atomic_text(_state_root() / "ram-tetris-enabled", "off\n")
        print("RAM Tetris preference disabled; safe static restoration requested")
        return 0
    if args.action == "request-stop":
        identity = (
            args.lifecycle_pid,
            args.lifecycle_start,
            args.server_pid,
            args.server_start,
        )
        if args.reason in LIFECYCLE_STOP_REASONS and any(
            item is None for item in identity
        ):
            raise SystemExit(
                "lifecycle stop request requires lifecycle and server identities"
            )
        if args.reason in LOCAL_STOP_REASONS and any(
            item is not None for item in identity
        ):
            raise SystemExit("local stop request must not carry lifecycle identity")
        _request_stop(
            control,
            args.reason,
            args.lifecycle_pid,
            args.lifecycle_start,
            args.server_pid,
            args.server_start,
        )
        return 0
    if args.action == "clear-stop":
        try:
            control.stop_path.unlink()
        except FileNotFoundError:
            pass
        return 0
    if args.action == "completed-local-stop":
        reason = control.completed_local_stop(args.pid, args.start)
        if reason is None:
            return 1
        print(reason)
        return 0
    if args.action == "writer-started":
        return 0 if control.writer_started(args.pid, args.start) else 1
    if args.action == "clear-failure":
        raise SystemExit(
            "direct failure clearance is disabled; use the classified "
            "lighting-recovery procedure"
        )
    if args.action == "fail":
        control.fail(args.message)
        return 0
    return _run(args)


if __name__ == "__main__":
    raise SystemExit(main())
