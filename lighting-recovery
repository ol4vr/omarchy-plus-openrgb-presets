def _verify_shutdown_race_boundary(state: dict[str, object]) -> None:
    stop_result = state.get("stop_result")
    if (
        state.get("boot_id") != SHUTDOWN_RACE_OLD_BOOT_ID
        or state.get("state") != "stopping"
        or state.get("reason") != "deliberate"
        or state.get("lifecycle_pid") != SHUTDOWN_RACE_LIFECYCLE_PID
        or state.get("lifecycle_start") != SHUTDOWN_RACE_LIFECYCLE_START
        or state.get("server_pid") != SHUTDOWN_RACE_SERVER_PID
        or state.get("server_start") != SHUTDOWN_RACE_SERVER_START
        or _number(state.get("time")) != SHUTDOWN_RACE_BOUNDARY_TIME
        or not isinstance(stop_result, dict)
        or stop_result.get("classification") != "incomplete-lifecycle-exit"
        or stop_result.get("service_result") != "exit-code"
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the old-boot deliberate-shutdown boundary changed."
        )
    if _current_boot_id() == SHUTDOWN_RACE_OLD_BOOT_ID:
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race recovery requires a later clean boot."
        )
    if (
        _process_start(SHUTDOWN_RACE_LIFECYCLE_PID) == SHUTDOWN_RACE_LIFECYCLE_START
        or _process_start(SHUTDOWN_RACE_SERVER_PID) == SHUTDOWN_RACE_SERVER_START
    ):
        raise RecoveryBlocked(
            "Recovery blocked: an old shutdown-race identity is active."
        )


