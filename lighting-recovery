def _wait_for_authoritative_lifecycle_ready(deadline: float) -> None:
    """Wait for the lifecycle's own state record after systemd accepts READY."""
    while True:
        state = _read_service_state().get("state")
        if state == "ready":
            return
        if state in {"failed", "clean-stopped"}:
            raise RecoveryBlocked(
                "Recovery blocked: the single service start did not reach "
                "authoritative lifecycle readiness; manual review is required."
            )
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RecoveryBlocked(
                "Recovery blocked: the single service start did not reach "
                "authoritative lifecycle readiness; manual review is required."
            )
        time.sleep(min(LIFECYCLE_READY_POLL_SECONDS, remaining))


def prepare_document() -> dict[str, object]:
    raw, record = _failure_record()
    message = _failure_message(record)
    failure_class = classify_reason(message)
    failure_time, _ = _timestamp(record)
    if message in LIFECYCLE_RECOVERY_REASONS:
        lifecycle_raw, config_raw = _verify_lifecycle_recovery_preflight(
            record, message
        )
        return {
            "state": "confirmation-required",
            "confirmation_token": _lifecycle_confirmation_token(
                raw, lifecycle_raw, config_raw
            ),
            "incident_reference": _incident_reference(raw),
            "message": (
                "Confirm one reviewed lifecycle start. RAM Tetris will remain OFF."
            ),
        }
    if not failure_class.reviewed_recovery or message not in ELIGIBLE_REASONS:
        raise RecoveryBlocked(
            "Recovery blocked: this incident has no reviewed automatic recovery procedure."
        )
    if failure_time is None:
        raise RecoveryBlocked("Recovery blocked: the incident timestamp is invalid.")
    _verify_service_and_hardware(failure_time)
    return {
        "state": "confirmation-required",
        "confirmation_token": hashlib.sha256(raw).hexdigest(),
        "incident_reference": _incident_reference(raw),
        "message": "Confirm recovery. RAM Tetris will remain OFF.",
    }


def _lifecycle_confirmation_token(
    failure_raw: bytes, lifecycle_raw: bytes, config_raw: bytes
) -> str:
    return hashlib.sha256(
        b"reviewed-lifecycle-boundary\0"
        + failure_raw
        + b"\0"
        + lifecycle_raw
        + b"\0"
        + config_raw
    ).hexdigest()


def _atomic_text(path: Path, text: str) -> None:
    _private_directory(path.parent)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        _fsync_directory(path.parent)
    except BaseException:
        try:
            os.close(descriptor)
        except OSError:
            pass
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def _fsync_directory(path: Path) -> None:
    directory_fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def _preserve_evidence(raw: bytes, reference: str, kind: str = "failure") -> Path:
    evidence_root = state_root() / "recovery-evidence"
    _private_directory(state_root())
    _private_directory(evidence_root)
    destination = evidence_root / f"{reference}.{kind}.json"
    try:
        descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        if (
            _read_protected_bytes(destination, f"retained {kind} evidence")
            != raw
        ):
            raise RecoveryBlocked(
                "Recovery blocked: retained evidence does not match the current record."
            )
        return destination
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
    except BaseException:
        try:
            destination.unlink()
        except FileNotFoundError:
            pass
        raise
    if destination.read_bytes() != raw:
        raise RecoveryBlocked(
            "Recovery blocked: retained evidence readback did not match."
        )
    _fsync_directory(evidence_root)
    return destination


def _preserve_stability_evidence(
    reviewed: ReviewedHardwareHealth, stability: StabilityEvidence
) -> Path:
    evidence_root = state_root() / "recovery-evidence"
    _private_directory(state_root())
    _private_directory(evidence_root)
    destination = evidence_root / (
        f"{reviewed.incident_reference}.hardware-health-observation"
    )
    try:
        destination.mkdir(mode=0o700)
    except FileExistsError:
        _require_private_directory(
            destination, "retained hardware-health observation directory"
        )
    expected = dict(stability.files)
    try:
        existing = {entry.name for entry in destination.iterdir()}
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: retained hardware-health observation is unreadable."
        ) from error
    if not existing.issubset(expected):
        raise RecoveryBlocked(
            "Recovery blocked: retained hardware-health observation has extra files."
        )
    for name, raw in stability.files:
        path = destination / name
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            if _read_protected_bytes(path, f"retained stability evidence {name}") != raw:
                raise RecoveryBlocked(
                    "Recovery blocked: retained hardware-health observation changed."
                )
            continue
        try:
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(raw)
                handle.flush()
                os.fsync(handle.fileno())
        except BaseException:
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            raise
        if _read_protected_bytes(path, f"retained stability evidence {name}") != raw:
            raise RecoveryBlocked(
                "Recovery blocked: retained hardware-health observation readback changed."
            )
    if {entry.name for entry in destination.iterdir()} != set(expected):
        raise RecoveryBlocked(
            "Recovery blocked: retained hardware-health observation is incomplete."
        )
    _fsync_directory(destination)
    _fsync_directory(evidence_root)
    return destination


def _unlink_unchanged_latch(expected: bytes) -> None:
    path = state_root() / "ram-tetris-failure.json"
    _require_private_directory(path.parent, "historical failure-latch directory")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: the failure latch is unavailable."
        ) from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or metadata.st_mode & 0o077
        ):
            raise RecoveryBlocked(
                "Recovery blocked: the failure latch is not protected."
            )
        chunks: list[bytes] = []
        while chunk := os.read(descriptor, 65_536):
            chunks.append(chunk)
        if b"".join(chunks) != expected:
            raise RecoveryBlocked(
                "Recovery blocked: the failure latch changed before clearance."
            )
        path_metadata = path.lstat()
        if (
            path_metadata.st_dev != metadata.st_dev
            or path_metadata.st_ino != metadata.st_ino
        ):
            raise RecoveryBlocked(
                "Recovery blocked: the failure latch identity changed."
            )
        path.unlink()
        _fsync_directory(path.parent)
    finally:
        os.close(descriptor)


def _recover_lifecycle(
    raw: bytes,
    record: dict[str, object],
    confirmation_token: str,
) -> dict[str, object]:
    message = _failure_message(record)
    lifecycle_raw, config_raw = _verify_lifecycle_recovery_preflight(record, message)
    expected_token = _lifecycle_confirmation_token(raw, lifecycle_raw, config_raw)
    if not confirmation_token or confirmation_token != expected_token:
        raise RecoveryBlocked(
            "Recovery blocked: confirmation does not match this lifecycle incident."
        )

    reference = _incident_reference(raw)
    _preserve_evidence(raw, reference)
    _preserve_evidence(lifecycle_raw, reference, "lifecycle-state")
    _preserve_evidence(config_raw, reference, "openrgb-config")
    _atomic_text(state_root() / "ram-tetris-enabled", "off\n")

    failure_path = state_root() / "ram-tetris-failure.json"
    lifecycle_path = state_root() / "lifecycle-service-state.json"
    preference_path = state_root() / "ram-tetris-enabled"
    if (
        preference_path.read_bytes() != b"off\n"
        or failure_path.read_bytes() != raw
        or lifecycle_path.read_bytes() != lifecycle_raw
        or OPENRGB_CONFIG.read_bytes() != config_raw
    ):
        raise RecoveryBlocked(
            "Recovery blocked: preserved boundary evidence changed before acknowledgment."
        )

    acknowledgement = subprocess.run(
        [
            SERVICE_GUARD,
            "acknowledge-reviewed-recovery",
            "--acknowledge-reviewed-recovery",
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if acknowledgement.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: the reviewed service-boundary acknowledgment failed."
        )

    start_deadline = time.monotonic() + SERVICE_START_TIMEOUT
    start = subprocess.run(
        [SYSTEMCTL, "--user", "start", SERVICE_NAME],
        check=False,
        capture_output=True,
        text=True,
        timeout=SERVICE_START_TIMEOUT,
    )
    if start.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: the single service start failed; manual review is required."
        )

    failure_time, _ = _timestamp(record)
    if failure_time is None:  # preflight already rejects this; retain fail-closed form.
        raise RecoveryBlocked("Recovery blocked: the incident timestamp is invalid.")
    _wait_for_authoritative_lifecycle_ready(start_deadline)
    _verify_service_and_hardware(failure_time)
    if failure_path.read_bytes() != raw:
        raise RecoveryBlocked(
            "Recovery blocked: the failure latch changed during service acceptance."
        )
    failure_path.unlink()
    _fsync_directory(failure_path.parent)
    return {
        "state": "recovered",
        "incident_reference": reference,
        "message": "Lighting recovery complete. RAM Tetris remains OFF.",
    }


def recover(confirmation_token: str) -> dict[str, object]:
    root = runtime_root()
    _private_directory(root)
    lock_fd = os.open(root / "lighting-recovery.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RecoveryBlocked(
                "Recovery blocked: another recovery is active."
            ) from error

        raw, record = _failure_record()
        message = _failure_message(record)
        if message in LIFECYCLE_RECOVERY_REASONS:
            return _recover_lifecycle(raw, record, confirmation_token)
        expected_token = hashlib.sha256(raw).hexdigest()
        if not confirmation_token or confirmation_token != expected_token:
            raise RecoveryBlocked(
                "Recovery blocked: confirmation does not match this incident."
            )
        failure_class = classify_reason(message)
        failure_time, _ = _timestamp(record)
        if not failure_class.reviewed_recovery or message not in ELIGIBLE_REASONS:
            raise RecoveryBlocked("Recovery blocked: this incident is not eligible.")
        if failure_time is None:
            raise RecoveryBlocked(
                "Recovery blocked: the incident timestamp is invalid."
            )

        _verify_service_and_hardware(failure_time)
        reference = _incident_reference(raw)
        _preserve_evidence(raw, reference)
        _atomic_text(state_root() / "ram-tetris-enabled", "off\n")

        failure_path = state_root() / "ram-tetris-failure.json"
        if failure_path.read_bytes() != raw:
            raise RecoveryBlocked(
                "Recovery blocked: the failure latch changed during review."
            )
        failure_path.unlink()
        _fsync_directory(failure_path.parent)
        return {
            "state": "recovered",
            "incident_reference": reference,
            "message": "Recovery complete. RAM Tetris remains OFF.",
        }
    finally:
        os.close(lock_fd)


def clear_resolved_lifecycle(
    incident_reference: str,
    latch_sha256: str,
    original_reason: str,
) -> dict[str, object]:
    """Clear only the reviewed, already-resolved LGT-LIF-002 historical latch."""
    root = runtime_root()
    _private_directory(root)
    lock_fd = os.open(root / "lighting-recovery.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RecoveryBlocked(
                "Recovery blocked: another recovery is active."
            ) from error

        first = _historical_clearance_preflight(
            incident_reference, latch_sha256, original_reason
        )
        evidence = _preserve_evidence(
            first.failure_raw,
            HISTORICAL_CLEARANCE_REFERENCE,
            "historical-clearance",
        )
        if (
            _read_protected_bytes(evidence, "historical-clearance evidence")
            != first.failure_raw
        ):
            raise RecoveryBlocked(
                "Recovery blocked: historical-clearance evidence readback changed."
            )

        second = _historical_clearance_preflight(
            incident_reference, latch_sha256, original_reason
        )
        if second != first:
            raise RecoveryBlocked(
                "Recovery blocked: incident or health bindings changed before clearance."
            )
        _unlink_unchanged_latch(first.failure_raw)
        return {
            "state": "cleared",
            "incident_reference": HISTORICAL_CLEARANCE_REFERENCE,
            "message": "Historical lifecycle failure cleared. RAM Tetris remains OFF.",
        }
    finally:
        os.close(lock_fd)


def clear_reviewed_software_race(
    incident_reference: str,
    latch_sha256: str,
    error_code: str,
    original_reason: str,
) -> dict[str, object]:
    """Clear one source-allowlisted, corrected software-race latch."""
    root = runtime_root()
    _private_directory(root)
    lock_fd = os.open(root / "lighting-recovery.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RecoveryBlocked(
                "Recovery blocked: another recovery is active."
            ) from error

        reviewed = _reviewed_software_race_authorization(
            incident_reference, latch_sha256, error_code, original_reason
        )
        first = _software_race_clearance_preflight(
            incident_reference, latch_sha256, error_code, original_reason
        )
        for raw, kind in (
            (first.failure_raw, "failure"),
            (first.current_state_raw, "lifecycle-state"),
            (first.config_raw, "openrgb-config"),
        ):
            _preserve_evidence(raw, reviewed.incident_reference, kind)

        second = _software_race_clearance_preflight(
            incident_reference, latch_sha256, error_code, original_reason
        )
        if second != first:
            raise RecoveryBlocked(
                "Recovery blocked: incident or health bindings changed before clearance."
            )
        for raw, kind in (
            (second.failure_raw, "failure"),
            (second.current_state_raw, "lifecycle-state"),
            (second.config_raw, "openrgb-config"),
        ):
            _preserve_evidence(raw, reviewed.incident_reference, kind)
        _unlink_unchanged_latch(first.failure_raw)
        _verify_software_race_continuity(reviewed, first)
        if (state_root() / "ram-tetris-failure.json").exists():
            raise RecoveryBlocked(
                "Recovery blocked: the reviewed software-race latch remains present."
            )
        return {
            "failure": False,
            "incident_reference": reviewed.incident_reference,
            "message": "Reviewed software-race latch cleared. RAM Tetris remains OFF.",
            "preference": False,
            "state": "off",
        }
    finally:
        os.close(lock_fd)


