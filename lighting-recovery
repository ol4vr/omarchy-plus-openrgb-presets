def _process_start(pid: int) -> str | None:
    try:
        fields = PROC_ROOT.joinpath(str(pid), "stat").read_text().split()
    except OSError:
        return None
    return fields[21] if len(fields) > 21 else None


def _process_argv(pid: int) -> tuple[str, ...]:
    try:
        raw = PROC_ROOT.joinpath(str(pid), "cmdline").read_bytes()
    except OSError:
        return ()
    return tuple(
        part.decode(errors="surrogateescape") for part in raw.split(b"\0") if part
    )


def _process_parent(pid: int) -> int | None:
    try:
        lines = PROC_ROOT.joinpath(str(pid), "status").read_text().splitlines()
    except OSError:
        return None
    for line in lines:
        if line.startswith("PPid:"):
            try:
                return int(line.split()[1])
            except (IndexError, ValueError):
                return None
    return None


def _is_descendant(pid: int, owner: int) -> bool:
    seen: set[int] = set()
    current = pid
    while current > 1 and current not in seen:
        seen.add(current)
        parent = _process_parent(current)
        if parent is None:
            return False
        if parent == owner:
            return True
        current = parent
    return False


def _matching_processes(argv: tuple[str, ...]) -> tuple[int, ...]:
    matches: list[int] = []
    try:
        entries = tuple(PROC_ROOT.iterdir())
    except OSError as error:
        raise RecoveryBlocked("Process ownership is unreadable.") from error
    for entry in entries:
        if entry.name.isdigit() and _process_argv(int(entry.name)) == argv:
            matches.append(int(entry.name))
    return tuple(sorted(matches))


def _process_cgroup(pid: int) -> str | None:
    try:
        lines = PROC_ROOT.joinpath(str(pid), "cgroup").read_text().splitlines()
    except OSError:
        return None
    unified = [line[3:] for line in lines if line.startswith("0::")]
    return unified[0] if len(unified) == 1 and unified[0] else None


def _service_properties(unit: str, properties: tuple[str, ...]) -> dict[str, str]:
    command = [SYSTEMCTL, "--user", "show", unit, "--no-pager"]
    command.extend(f"--property={name}" for name in properties)
    result = subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    if result.returncode != 0:
        raise RecoveryBlocked(f"Recovery blocked: {unit} state is unavailable.")
    values: dict[str, str] = {}
    for line in result.stdout.splitlines():
        name, separator, value = line.partition("=")
        if separator:
            values[name] = value
    if any(name not in values for name in properties):
        raise RecoveryBlocked(f"Recovery blocked: {unit} state is incomplete.")
    return values


