#!/usr/bin/bash

set -o errexit
set -o nounset
set -o pipefail

readonly OPENRGB_BIN="/usr/bin/openrgb"
readonly SETPRIV_BIN="/usr/bin/setpriv"
readonly SCRIPT_DIR="$(/usr/bin/readlink -f "$(/usr/bin/dirname "${BASH_SOURCE[0]}")")"
readonly EFFECTS_SDK="${SCRIPT_DIR}/effects-sdk"
readonly RAM_TETRIS="${RAM_TETRIS:-${SCRIPT_DIR}/ram-tetris}"
readonly RAM_DEVICE="Corsair Dominator Platinum RGB DDR5"
readonly GPU_DEVICE="ASUS TUF GeForce RTX 4090 Gaming OG OC"
readonly ST100_DEVICE="Corsair ST100 RGB"
readonly MAINBOARD_DEVICE="ASUS ROG STRIX Z790-F GAMING WIFI"

readonly STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}/omarchy-plus/openrgb-presets"
readonly STATE_FILE="${STATE_ROOT}/active-preset"
readonly LAST_LOG="${STATE_ROOT}/last-openrgb.log"
readonly LOCK_FILE="${STATE_ROOT}/apply.flock"
readonly FAILURE_FILE="${STATE_ROOT}/ram-tetris-failure.json"
readonly RECOVERY_OUTCOME_FILE="${STATE_ROOT}/lighting-recovery-outcome.json"
readonly USER_ID="$(/usr/bin/id -u)"
readonly RUNTIME_ROOT="${OPENRGB_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/${USER_ID}}/omarchy-plus/openrgb-presets}"
readonly TETRIS_LOCK_FILE="${RUNTIME_ROOT}/ram-tetris.lock"
readonly PRESET_OWNER_FILE="${RUNTIME_ROOT}/preset-operation.state"
readonly RECOVERY_LOCK_FILE="${RUNTIME_ROOT}/lighting-recovery.lock"
readonly LIFECYCLE="${SCRIPT_DIR}/openrgb-lifecycle"
readonly PROBE_TIMEOUT="2s"
readonly PROBE_ATTEMPTS=15

dry_run=false
restore=false
operation_identity=''

usage() {
  /usr/bin/printf '%s\n' \
    'Usage: apply-preset PRESET' \
    '       apply-preset --restore' \
    '       apply-preset --current' \
    '       apply-preset --list' \
    '       apply-preset --dry-run PRESET' \
    '' \
    'Presets:' \
    '  deep-red' \
    '  bright-white' \
    '  deep-blue' \
    '  animated-rainbow' \
    '  neon-rain' \
    '  aurora-comet' \
    '  spectrum-wave' \
    '  matte-black-orange' \
    '  electric-sunrise' \
    '  horde-red' \
    '  alliance-blue' \
    '  black'
}

list_presets() {
  /usr/bin/printf '%s\n' \
    'deep-red' \
    'bright-white' \
    'deep-blue' \
    'animated-rainbow' \
    'neon-rain' \
    'aurora-comet' \
    'spectrum-wave' \
    'matte-black-orange' \
    'electric-sunrise' \
    'horde-red' \
    'alliance-blue' \
    'black'
}

is_preset() {
  case "${1}" in
    deep-red|bright-white|deep-blue|animated-rainbow|neon-rain|aurora-comet|spectrum-wave|matte-black-orange|electric-sunrise|horde-red|alliance-blue|black) return 0 ;;
    *) return 1 ;;
  esac
}

is_guarded_recovery_restore() {
  local current_pid="${PPID}"
  local parent_pid=''
  local argument=''
  local latch_sha256=''
  local depth=0
  local lifecycle_ancestor=false

  if [[ "${restore}" != true || ! -r "${RECOVERY_OUTCOME_FILE}" \
    || ! -e "${RECOVERY_LOCK_FILE}" ]]; then
    return 1
  fi
  if ! /usr/bin/grep -Fq '"outcome":"recovery-in-progress"' \
    "${RECOVERY_OUTCOME_FILE}"; then
    return 1
  fi
  latch_sha256="$(/usr/bin/sha256sum "${FAILURE_FILE}" 2>/dev/null \
    | /usr/bin/awk '{ print $1; exit }' || true)"
  if [[ ! "${latch_sha256}" =~ ^[0-9a-f]{64}$ ]] \
    || ! /usr/bin/grep -Fq "\"latch_sha256\":\"${latch_sha256}\"" \
      "${RECOVERY_OUTCOME_FILE}"; then
    return 1
  fi

  exec 7>"${RECOVERY_LOCK_FILE}"
  if /usr/bin/flock --nonblock 7; then
    /usr/bin/flock --unlock 7
    exec 7>&-
    return 1
  fi

  while [[ "${current_pid}" =~ ^[0-9]+$ && "${current_pid}" -gt 1 \
    && "${depth}" -lt 8 ]]; do
    while IFS= read -r argument; do
      if [[ "${argument}" == "${LIFECYCLE}" ]]; then
        lifecycle_ancestor=true
        break 2
      fi
    done < <(/usr/bin/tr '\0' '\n' <"/proc/${current_pid}/cmdline" 2>/dev/null || true)
    parent_pid="$(/usr/bin/awk '/^PPid:/ { print $2; exit }' \
      "/proc/${current_pid}/status" 2>/dev/null || true)"
    current_pid="${parent_pid}"
    ((depth += 1))
  done
  exec 7>&-
  [[ "${lifecycle_ancestor}" == true ]]
}

static_ram_pattern() {
  case "${1}" in
    deep-red) /usr/bin/printf '%s' '8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000' ;;
    deep-blue) /usr/bin/printf '%s' '000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22' ;;
    bright-white) /usr/bin/printf '%s' 'FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF' ;;
    animated-rainbow|spectrum-wave) /usr/bin/printf '%s' '11FF00,11FF00,8A2BE2,8A2BE2,FFD400,FFD400,FF0040,FF0040,8A2BE2,8A2BE2,11FF00,11FF00' ;;
    neon-rain) /usr/bin/printf '%s' '5500FF,5500FF,11FF00,11FF00,00FF8C,00FF8C,FF00F6,FF00F6,FFD400,FFD400,5500FF,5500FF' ;;
    aurora-comet) /usr/bin/printf '%s' '95FF00,95FF00,00D4FF,00D4FF,8A2BE2,8A2BE2,8A2BE2,8A2BE2,00D4FF,00D4FF,95FF00,95FF00' ;;
    electric-sunrise) /usr/bin/printf '%s' 'FF0040,FF0040,FF0051,FF0051,3C00FF,3C00FF,0044FF,0044FF,FF0051,FF0051,FF0040,FF0040' ;;
    matte-black-orange) /usr/bin/printf '%s' 'FF4400,FF4400,E83B00,E83B00,C92B00,C92B00,501000,501000,E83B00,E83B00,FF4400,FF4400' ;;
    black) /usr/bin/printf '%s' '000000,000000,000000,000000,000000,000000,000000,000000,000000,000000,000000,000000' ;;
    horde-red) /usr/bin/printf '%s' '8B0000,8B0000,680000,680000,4A0000,4A0000,180000,180000,680000,680000,8B0000,8B0000' ;;
    alliance-blue) /usr/bin/printf '%s' '0033AA,0033AA,002788,002788,001A66,001A66,000B22,000B22,002788,002788,0033AA,0033AA' ;;
    *) return 64 ;;
  esac
}

preset_label() {
  case "${1}" in
    deep-red) /usr/bin/printf '%s' 'Static Red' ;;
    bright-white) /usr/bin/printf '%s' 'Static White' ;;
    deep-blue) /usr/bin/printf '%s' 'Static Blue' ;;
    animated-rainbow) /usr/bin/printf '%s' 'Animated Rainbow' ;;
    neon-rain) /usr/bin/printf '%s' 'Neon Rain' ;;
    aurora-comet) /usr/bin/printf '%s' 'Aurora Comet' ;;
    spectrum-wave) /usr/bin/printf '%s' 'Spectrum Wave' ;;
    matte-black-orange) /usr/bin/printf '%s' 'Matte Black Orange' ;;
    electric-sunrise) /usr/bin/printf '%s' 'Electric Sunrise' ;;
    horde-red) /usr/bin/printf '%s' 'For the Horde!' ;;
    alliance-blue) /usr/bin/printf '%s' 'For the Alliance!' ;;
    black) /usr/bin/printf '%s' 'Black (Turn Off RGB)' ;;
  esac
}

print_effects_command() {
  /usr/bin/printf 'DRY RUN:'
  /usr/bin/printf ' %q' "${EFFECTS_SDK}" "$@"
  /usr/bin/printf '\n'
}

normalize_preset() {
  case "${1}" in
    tokyo-night-purple) /usr/bin/printf '%s' 'bright-white' ;;
    *) /usr/bin/printf '%s' "${1}" ;;
  esac
}

print_command() {
  /usr/bin/printf 'DRY RUN:'
  /usr/bin/printf ' %q' "${OPENRGB_BIN}" --nodetect "$@"
  /usr/bin/printf '\n'
}

wait_for_server() {
  local inventory=''
  local controller_count=0
  local ram_count=0
  local gpu_count=0
  local st100_count=0
  local mainboard_count=0
  local attempt

  for ((attempt = 1; attempt <= PROBE_ATTEMPTS; attempt++)); do
    inventory="$(/usr/bin/timeout --signal=TERM --kill-after=1s "${PROBE_TIMEOUT}" \
      "${OPENRGB_BIN}" --nodetect --list-devices 2>&1 || true)"
    controller_count="$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: ' || true)"
    ram_count="$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: Corsair Dominator Platinum RGB DDR5$' || true)"
    gpu_count="$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: ASUS TUF GeForce RTX 4090 Gaming OG OC$' || true)"
    st100_count="$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: Corsair ST100 RGB$' || true)"
    mainboard_count="$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: ASUS ROG STRIX Z790-F GAMING WIFI$' || true)"

    if [[ "${controller_count}" -eq 7 && "${ram_count}" -eq 4 \
      && "${gpu_count}" -eq 1 && "${st100_count}" -eq 1 \
      && "${mainboard_count}" -eq 1 ]]; then
      return 0
    fi

    /usr/bin/sleep 1
  done

  /usr/bin/printf '%s\n' "${inventory}" >"${LAST_LOG}"
  /usr/bin/printf '%s\n' "OpenRGB SDK server did not expose the seven accepted Hugin controllers. Report: ${LAST_LOG}" >&2
  return 1
}

wait_for_effects() {
  local output=''
  local attempt

  for ((attempt = 1; attempt <= PROBE_ATTEMPTS; attempt++)); do
    if output="$(/usr/bin/timeout --signal=TERM --kill-after=1s "${PROBE_TIMEOUT}" \
      "${EFFECTS_SDK}" ready 2>&1)"; then
      return 0
    fi
    /usr/bin/sleep 1
  done

  /usr/bin/printf '%s\n' "${output}" >"${LAST_LOG}"
  /usr/bin/printf '%s\n' "OpenRGB Effects Plugin did not become ready. Report: ${LAST_LOG}" >&2
  return 1
}

guarded_hardware_mutation() {
  local command=("$@")

  if ! "${SETPRIV_BIN}" --pdeathsig TERM "${RAM_TETRIS}" guarded-mutation \
    -- "${command[@]}" \
    >"${LAST_LOG}" 2>&1 9>&- 8>&-; then
    /usr/bin/printf '%s\n' \
      "OpenRGB hardware mutation was refused or failed. Report: ${LAST_LOG}" >&2
    /usr/bin/tail -n 20 "${LAST_LOG}" >&2
    return 1
  fi
}

stop_effects() {
  if [[ "${dry_run}" == true ]]; then
    print_effects_command stop-all
    return 0
  fi

  wait_for_server || return 1
  wait_for_effects || return 1
  if ! guarded_hardware_mutation "${EFFECTS_SDK}" stop-all; then
    /usr/bin/printf '%s\n' "OpenRGB Effects Plugin failed to stop active effects. Report: ${LAST_LOG}" >&2
    /usr/bin/tail -n 20 "${LAST_LOG}" >&2
    return 1
  fi
}

apply_effects_profile() {
  local profile="${1}"
  local expected_effect="${2}"

  if [[ "${dry_run}" == true ]]; then
    print_effects_command load-profile "${profile}" "${expected_effect}"
    return 0
  fi

  wait_for_server || return 1
  wait_for_effects || return 1
  if ! guarded_hardware_mutation \
    "${EFFECTS_SDK}" load-profile "${profile}" "${expected_effect}"; then
    /usr/bin/printf '%s\n' "OpenRGB Effects profile failed. Report: ${LAST_LOG}" >&2
    /usr/bin/tail -n 20 "${LAST_LOG}" >&2
    return 1
  fi
}

apply_ram_static() {
  local color="${1}"

  run_openrgb \
    --device "${RAM_DEVICE}" --mode direct --color "${color}"
}

apply_effects_with_static_ram() {
  local profile="${1}"
  local expected_effect="${2}"
  local ram_color="${3}"

  stop_effects
  apply_effects_profile "${profile}" "${expected_effect}"
  apply_ram_static "${ram_color}"
}

run_openrgb() {
  if [[ "${dry_run}" == true ]]; then
    print_command "$@"
    return 0
  fi

  wait_for_server || return 1

  if ! guarded_hardware_mutation "${OPENRGB_BIN}" --nodetect "$@"; then
    /usr/bin/printf '%s\n' "OpenRGB failed. Report: ${LAST_LOG}" >&2
    /usr/bin/tail -n 20 "${LAST_LOG}" >&2
    return 1
  fi
}

apply_static() {
  local main_color="${1}"
  local st100_base="${2}"
  local st100_logo="${3}"
  local mainboard_colors="${4}"
  local ram_colors="${5}"

  run_openrgb \
    --device "${RAM_DEVICE}" --mode direct --color "${ram_colors}" \
    --device "${GPU_DEVICE}" --mode static --color "${main_color}" \
    --device "${ST100_DEVICE}" --zone 0 --mode direct --color "${st100_base}" \
    --device "${ST100_DEVICE}" --zone 1 --mode direct --color "${st100_logo}" \
    --device "${MAINBOARD_DEVICE}" --mode direct --color "${mainboard_colors}"
}

apply_rainbow() {
  local ram_color="${1}"

  run_openrgb \
    --device "${RAM_DEVICE}" --mode direct --color "${ram_color}" \
    --device "${GPU_DEVICE}" --mode rainbow --speed 50 \
    --device "${ST100_DEVICE}" --zone 0 --mode direct \
      --color FF0000,FF7F00,FFFF00,00FF00,00FFFF,0000FF,8B00FF,FF00FF \
    --device "${ST100_DEVICE}" --zone 1 --mode direct --color 2020FF \
    --device "${MAINBOARD_DEVICE}" --mode rainbow --speed 50
}

apply_preset() {
  local preset="${1}"
  local ram_colors
  ram_colors="$(static_ram_pattern "${preset}")"

  case "${preset}" in
    deep-red)
      stop_effects
      apply_static 8B0000 A00000 A00000 8B0000 "${ram_colors}"
      ;;
    bright-white)
      stop_effects
      apply_static FFFFFF FFFFFF 2020FF FFFFFF "${ram_colors}"
      ;;
    deep-blue)
      stop_effects
      apply_static 000B22 000B22 000B22 000B22 "${ram_colors}"
      ;;
    animated-rainbow)
      stop_effects
      apply_rainbow "${ram_colors}"
      ;;
    neon-rain)
      apply_effects_with_static_ram hugin-rain 'Rain' "${ram_colors}"
      ;;
    aurora-comet)
      apply_effects_with_static_ram hugin-rainbow-comet 'Comet' "${ram_colors}"
      ;;
    spectrum-wave)
      apply_effects_with_static_ram hugin-rainbow-wave 'Rainbow Wave' "${ram_colors}"
      ;;
    matte-black-orange)
      apply_effects_with_static_ram hugin-sunrise-orange-black 'Sunrise' "${ram_colors}"
      ;;
    electric-sunrise)
      apply_effects_with_static_ram hugin-sunrise-blue-red 'Sunrise' "${ram_colors}"
      ;;
    horde-red)
      apply_effects_with_static_ram hugin-sunrise-red-black 'Sunrise' "${ram_colors}"
      ;;
    alliance-blue)
      apply_effects_with_static_ram hugin-sunrise-blue-black 'Sunrise' "${ram_colors}"
      ;;
    black)
      stop_effects
      apply_static 000000 000000 000000 000000 "${ram_colors}"
      ;;
  esac

  if [[ "${dry_run}" == false ]]; then
    /usr/bin/printf '%s\n' "${preset}" >"${STATE_FILE}"
  fi

  /usr/bin/printf 'Preset: %s\nApplied: %s\n' "${preset}" "$(preset_label "${preset}")"
}

main() {
  umask 077

  if [[ "${#}" -eq 0 ]]; then
    usage >&2
    return 64
  fi

  case "${1}" in
    --help|-h)
      usage
      return 0
      ;;
    --list)
      list_presets
      return 0
      ;;
    --current)
      if [[ -r "${STATE_FILE}" ]]; then
        normalize_preset "$(/usr/bin/head -n 1 "${STATE_FILE}")"
        /usr/bin/printf '\n'
      else
        /usr/bin/printf '%s\n' 'bright-white'
      fi
      return 0
      ;;
    --dry-run)
      if [[ "${#}" -ne 2 ]] || ! is_preset "${2}"; then
        usage >&2
        return 64
      fi
      dry_run=true
      apply_preset "${2}"
      return 0
      ;;
    --restore)
      restore=true
      /usr/bin/mkdir -p "${STATE_ROOT}"
      if [[ -r "${STATE_FILE}" ]]; then
        preset="$(normalize_preset "$(/usr/bin/head -n 1 "${STATE_FILE}")")"
      else
        preset='bright-white'
      fi
      ;;
    *)
      if [[ "${#}" -ne 1 ]]; then
        usage >&2
        return 64
      fi
      preset="${1}"
      ;;
  esac

  if ! is_preset "${preset}"; then
    /usr/bin/printf 'Unknown preset: %s\n' "${preset}" >&2
    return 64
  fi

  if [[ -e "${FAILURE_FILE}" || -L "${FAILURE_FILE}" ]]; then
    # The only latch exception is the lifecycle child used by the single guarded
    # recovery start. It must share the exclusive recovery owner and outcome.
    if ! is_guarded_recovery_restore; then
      /usr/bin/printf '%s\n' \
        'Preset application blocked: an active lighting failure requires recovery review.' >&2
      return 75
    fi
  fi

  if [[ ! -x "${OPENRGB_BIN}" ]]; then
    /usr/bin/printf 'OpenRGB is unavailable: %s\n' "${OPENRGB_BIN}" >&2
    return 69
  fi

  if [[ ! -x "${SETPRIV_BIN}" ]]; then
    /usr/bin/printf 'Process-death guard is unavailable: %s\n' "${SETPRIV_BIN}" >&2
    return 69
  fi

  if [[ ! -x "${EFFECTS_SDK}" ]]; then
    /usr/bin/printf 'Effects SDK helper is unavailable: %s\n' "${EFFECTS_SDK}" >&2
    return 69
  fi

  if [[ ! -x "${RAM_TETRIS}" ]]; then
    /usr/bin/printf 'RAM Tetris helper is unavailable: %s\n' "${RAM_TETRIS}" >&2
    return 69
  fi

  /usr/bin/mkdir -p "${STATE_ROOT}"

  exec 9>"${LOCK_FILE}"
  if ! /usr/bin/flock --nonblock 9; then
    /usr/bin/printf '%s\n' 'Another OpenRGB preset operation is already running.' >&2
    return 75
  fi

  /usr/bin/mkdir -p "${RUNTIME_ROOT}"
  operation_pid="$$"
  operation_start="$(/usr/bin/awk '{print $22}' "/proc/$$/stat")"
  operation_identity="${operation_pid} ${operation_start}"
  /usr/bin/printf '%s\n' "${operation_identity}" \
    >"${PRESET_OWNER_FILE}.$$"
  /usr/bin/mv -f -- "${PRESET_OWNER_FILE}.$$" "${PRESET_OWNER_FILE}"
  trap 'if [[ -r "${PRESET_OWNER_FILE}" ]] && [[ "$(/usr/bin/head -n 1 "${PRESET_OWNER_FILE}")" == "${operation_identity}" ]]; then /usr/bin/rm -f -- "${PRESET_OWNER_FILE}"; fi' EXIT
  "${RAM_TETRIS}" request-stop preset-change \
    --operation-pid "${operation_pid}" \
    --operation-start "${operation_start}"
  exec 8>"${TETRIS_LOCK_FILE}"
  if ! /usr/bin/flock --wait 10 8; then
    "${RAM_TETRIS}" fail 'RAM Tetris did not quiesce before preset application'
    /usr/bin/printf '%s\n' 'RAM Tetris did not stop safely; preset was not changed.' >&2
    return 75
  fi

  # The writer singleton and whole-preset lock now close writer admission.  The
  # local marker can be removed before mutation so the same final gate used by
  # Tetris and shutdown remains authoritative.
  if ! "${RAM_TETRIS}" clear-local-stop \
    --operation-pid "${operation_pid}" \
    --operation-start "${operation_start}"; then
    /usr/bin/printf '%s\n' \
      'Preset application refused: a newer stop intent took precedence.' >&2
    return 75
  fi
  trap '"${RAM_TETRIS}" fail '\''Preset application failed while RAM Tetris was quiesced'\''' ERR
  apply_preset "${preset}"
  trap - ERR
}

main "$@"
