[Unit]
Description=Omarchy+ OpenRGB static lighting lifecycle
Documentation=https://github.com/ol4vr/omarchy-plus-openrgb-presets
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=1

[Service]
Type=simple
Environment=PYTHONDONTWRITEBYTECODE=1
SyslogIdentifier=omarchy-plus-openrgb-presets
StandardOutput=journal
StandardError=journal
ExecStart=%h/.config/omarchy/plugins/io.github.ol4vr.openrgb-presets/openrgb-lifecycle
Restart=no
KillMode=mixed
TimeoutStartSec=90
TimeoutStopSec=15
RuntimeDirectory=omarchy-plus/openrgb-presets-static
RuntimeDirectoryMode=0700
UMask=0077

[Install]
WantedBy=graphical-session.target
