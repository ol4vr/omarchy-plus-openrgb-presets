def _shutdown_race_detector_policy(config_raw: bytes) -> dict[str, bool]:
    try:
        value = json.loads(config_raw)
        detectors = value["Detectors"]["detectors"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race detector policy is unreadable."
        ) from error
    policy = {
        DISABLED_DETECTOR: detectors.get(DISABLED_DETECTOR),
        REQUIRED_DETECTOR: detectors.get(REQUIRED_DETECTOR),
    }
    if policy != {DISABLED_DETECTOR: False, REQUIRED_DETECTOR: True}:
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race detector policy changed."
        )
    return policy


def _shutdown_race_relevant_kernel_records() -> tuple[tuple[str, str], ...]:
    result = subprocess.run(
        [
            JOURNALCTL,
            "--boot",
            SHUTDOWN_RACE_RECOVERY_BOOT_ID.replace("-", ""),
            "-k",
            "--output=json",
            "--no-pager",
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if result.returncode != 0 or result.stderr.strip():
        raise RecoveryBlocked(
            "Recovery blocked: current-boot kernel qualification is unreadable."
        )
    relevant: list[tuple[str, str]] = []
    expected_boot = SHUTDOWN_RACE_RECOVERY_BOOT_ID.replace("-", "").lower()
    for raw in result.stdout.splitlines():
        try:
            record = json.loads(raw)
        except json.JSONDecodeError as error:
            raise RecoveryBlocked(
                "Recovery blocked: current-boot kernel qualification is malformed."
            ) from error
        if not isinstance(record, dict):
            raise RecoveryBlocked(
                "Recovery blocked: current-boot kernel qualification is malformed."
            )
        message = record.get("MESSAGE")
        if not isinstance(message, str) or not RELEVANT_KERNEL_ERROR.search(message):
            continue
        boot_id = record.get("_BOOT_ID")
        if not isinstance(boot_id, str) or boot_id.lower() != expected_boot:
            raise RecoveryBlocked(
                "Recovery blocked: relevant kernel evidence belongs to another boot."
            )
        relevant.append((message, raw))
    return tuple(relevant)


def _shutdown_race_kernel_qualification(
    config_raw: bytes,
) -> ShutdownRaceKernelQualification:
    if _current_boot_id() != SHUTDOWN_RACE_RECOVERY_BOOT_ID:
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race kernel qualification belongs to another boot."
        )
    policy = _shutdown_race_detector_policy(config_raw)
    cursor = _capture_kernel_cursor()
    relevant = _shutdown_race_relevant_kernel_records()
    if tuple(message for message, _ in relevant) != (
        SHUTDOWN_RACE_REVIEWED_KERNEL_MESSAGE,
    ):
        raise RecoveryBlocked(
            "Recovery blocked: current-boot kernel evidence is not the exact reviewed registration event."
        )
    document = {
        "schema_version": 1,
        "category": "reviewed-unrelated-ite8853-registration",
        "boot_id": SHUTDOWN_RACE_RECOVERY_BOOT_ID,
        "controller_contract": SHUTDOWN_RACE_CONTROLLER_CONTRACT,
        "detector_policy": policy,
        "detector_policy_sha256": hashlib.sha256(config_raw).hexdigest(),
        "journal_cursor": cursor,
        "journal_record": relevant[0][1],
        "message": SHUTDOWN_RACE_REVIEWED_KERNEL_MESSAGE,
    }
    return ShutdownRaceKernelQualification(
        evidence_raw=(json.dumps(document, sort_keys=True) + "\n").encode(),
        journal_cursor=cursor,
    )


def _verify_shutdown_race_kernel_qualification(
    qualification: ShutdownRaceKernelQualification,
