#!/usr/bin/bash

set -o errexit
set -o nounset
set -o pipefail

readonly OPENRGB_BIN="/usr/bin/openrgb"
readonly OPENRGB_PACKAGE="openrgb-hugin 1.0rc3-3.2"
readonly OPENRGB_SHA256="d0d065994b7328aec2cc0ae2b06a3c9ab8f99f4693aba35bd669e2fea406e301"
readonly SCRIPT_DIR="$(/usr/bin/readlink -f "$(/usr/bin/dirname "${BASH_SOURCE[0]}")")"
readonly EFFECTS_SDK="${SCRIPT_DIR}/effects-sdk"
readonly RAM_DEVICE="Corsair Dominator Platinum RGB DDR5"
readonly GPU_DEVICE="ASUS TUF GeForce RTX 4090 Gaming OG OC"
readonly ST100_DEVICE="Corsair ST100 RGB"
readonly MAINBOARD_DEVICE="ASUS ROG STRIX Z790-F GAMING WIFI"

readonly STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}/omarchy-plus/openrgb-presets"
readonly STATE_FILE="${STATE_ROOT}/active-preset"
readonly RAM_STATE_FILE="${STATE_ROOT}/ram-lighting-enabled"
readonly LAST_LOG="${STATE_ROOT}/last-openrgb.log"
readonly LOCK_FILE="${STATE_ROOT}/apply.flock"
readonly PROBE_TIMEOUT="2s"
readonly COMMAND_TIMEOUT="15s"
readonly PROBE_ATTEMPTS=15
readonly DEFAULT_PRESET="electric-sunrise"
readonly -a SPD_ENDPOINTS=(10-0050 10-0051 10-0052 10-0053)

dry_run=false

usage() {
  /usr/bin/printf '%s\n' \
    'Usage: apply-preset PRESET' \
    '       apply-preset --restore' \
    '       apply-preset --current' \
    '       apply-preset --list' \
    '       apply-preset --ram-on' \
    '       apply-preset --ram-off' \
    '       apply-preset --ram-current' \
    '       apply-preset --dry-run PRESET' \
    '' \
    'Presets:' \
    '  deep-red' \
    '  bright-white' \
    '  deep-blue' \
    '  animated-rainbow' \
    '  neon-rain' \
    '  aurora-comet' \
    '  spectrum-wave' \
    '  matte-black-orange' \
    '  electric-sunrise' \
    '  horde-red' \
    '  alliance-blue' \
    '  black'
}

list_presets() {
  /usr/bin/printf '%s\n' \
    'deep-red' \
    'bright-white' \
    'deep-blue' \
    'animated-rainbow' \
    'neon-rain' \
    'aurora-comet' \
    'spectrum-wave' \
    'matte-black-orange' \
    'electric-sunrise' \
    'horde-red' \
    'alliance-blue' \
    'black'
}

is_preset() {
  case "${1}" in
    deep-red|bright-white|deep-blue|animated-rainbow|neon-rain|aurora-comet|spectrum-wave|matte-black-orange|electric-sunrise|horde-red|alliance-blue|black) return 0 ;;
    *) return 1 ;;
  esac
}

preset_label() {
  case "${1}" in
    deep-red) /usr/bin/printf '%s' 'Deep Red' ;;
    bright-white) /usr/bin/printf '%s' 'Bright White' ;;
    deep-blue) /usr/bin/printf '%s' 'Deep Blue' ;;
    animated-rainbow) /usr/bin/printf '%s' 'Animated Rainbow' ;;
    neon-rain) /usr/bin/printf '%s' 'Neon Rain' ;;
    aurora-comet) /usr/bin/printf '%s' 'Aurora Comet' ;;
    spectrum-wave) /usr/bin/printf '%s' 'Spectrum Wave' ;;
    matte-black-orange) /usr/bin/printf '%s' 'Matte Black Orange' ;;
    electric-sunrise) /usr/bin/printf '%s' 'Electric Sunrise' ;;
    horde-red) /usr/bin/printf '%s' 'Horde Red' ;;
    alliance-blue) /usr/bin/printf '%s' 'Alliance Blue' ;;
    black) /usr/bin/printf '%s' 'Black (Turn Off RGB)' ;;
  esac
}

normalize_preset() {
  case "${1}" in
    tokyo-night-purple) /usr/bin/printf '%s' 'bright-white' ;;
    *) /usr/bin/printf '%s' "${1}" ;;
  esac
}

current_preset() {
  local preset="${DEFAULT_PRESET}"
  if [[ -r "${STATE_FILE}" ]]; then
    preset="$(normalize_preset "$(/usr/bin/head -n 1 "${STATE_FILE}")")"
  fi
  if ! is_preset "${preset}"; then
    preset="${DEFAULT_PRESET}"
  fi
  /usr/bin/printf '%s' "${preset}"
}

ram_lighting_enabled() {
  local value='on'
  if [[ -r "${RAM_STATE_FILE}" ]]; then
    value="$(/usr/bin/head -n 1 "${RAM_STATE_FILE}")"
  fi
  [[ "${value}" == 'on' ]]
}

ram_color_for_preset() {
  case "${1}" in
    deep-red) /usr/bin/printf '%s' '8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000,8B0000' ;;
    bright-white) /usr/bin/printf '%s' 'FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF,FFFFFF' ;;
    deep-blue) /usr/bin/printf '%s' '000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22,000B22' ;;
    animated-rainbow|spectrum-wave) /usr/bin/printf '%s' '11FF00,11FF00,8A2BE2,8A2BE2,FFD400,FFD400,FF0040,FF0040,8A2BE2,8A2BE2,11FF00,11FF00' ;;
    neon-rain) /usr/bin/printf '%s' '5500FF,5500FF,11FF00,11FF00,00FF8C,00FF8C,FF00F6,FF00F6,FFD400,FFD400,5500FF,5500FF' ;;
    aurora-comet) /usr/bin/printf '%s' '95FF00,95FF00,00D4FF,00D4FF,8A2BE2,8A2BE2,8A2BE2,8A2BE2,00D4FF,00D4FF,95FF00,95FF00' ;;
    electric-sunrise) /usr/bin/printf '%s' 'FF0040,FF0040,FF0051,FF0051,3C00FF,3C00FF,0044FF,0044FF,FF0051,FF0051,FF0040,FF0040' ;;
    matte-black-orange) /usr/bin/printf '%s' 'FF4400,FF4400,E83B00,E83B00,C92B00,C92B00,501000,501000,E83B00,E83B00,FF4400,FF4400' ;;
    horde-red) /usr/bin/printf '%s' '8B0000,8B0000,680000,680000,4A0000,4A0000,180000,180000,680000,680000,8B0000,8B0000' ;;
    alliance-blue) /usr/bin/printf '%s' '0033AA,0033AA,002788,002788,001A66,001A66,000B22,000B22,002788,002788,0033AA,0033AA' ;;
    black) /usr/bin/printf '%s' '000000,000000,000000,000000,000000,000000,000000,000000,000000,000000,000000,000000' ;;
  esac
}

print_command() {
  /usr/bin/printf 'DRY RUN:'
  /usr/bin/printf ' %q' "$@"
  /usr/bin/printf '\n'
}

run_child() (
  exec 9>&-
  exec "$@"
)

expected_server_command() {
  /usr/bin/printf '%s' \
    "${OPENRGB_BIN} --noautoconnect --startminimized --server --server-host 127.0.0.1 --server-port 6742"
}

listener_owner_pid() {
  local listener=''
  local pid=''
  listener="$(/usr/bin/ss -H -ltnp 'sport = :6742' 2>/dev/null \
    | /usr/bin/awk '$4 == "127.0.0.1:6742" && index($0, "users:((\"openrgb\",pid=") {print}')"
  [[ -n "${listener}" && "${listener}" != *$'\n'* ]] || return 1
  pid="$(/usr/bin/printf '%s\n' "${listener}" \
    | /usr/bin/sed -nE 's/.*pid=([0-9]+).*/\1/p')"
  [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  /usr/bin/printf '%s' "${pid}"
}

validate_sdk_owner() {
  local pid=''
  local command=''
  local executable=''
  local uid=''
  pid="$(listener_owner_pid)" || return 1
  [[ -r "/proc/${pid}/cmdline" && -r "/proc/${pid}/status" ]] || return 1
  command="$(/usr/bin/tr '\0' ' ' <"/proc/${pid}/cmdline" | /usr/bin/sed 's/ $//')"
  executable="$(/usr/bin/readlink -f "/proc/${pid}/exe")"
  uid="$(/usr/bin/awk '$1 == "Uid:" {print $2}' "/proc/${pid}/status")"
  [[ "${command}" == "$(expected_server_command)" \
    && "${executable}" == "${OPENRGB_BIN}" \
    && "${uid}" == "$(/usr/bin/id -u)" ]] || return 1
  [[ "$(listener_owner_pid)" == "${pid}" ]]
}

validate_package() {
  local installed=''
  local digest=''
  installed="$(/usr/bin/pacman -Q openrgb-hugin 2>/dev/null || true)"
  digest="$(/usr/bin/sha256sum "${OPENRGB_BIN}" 2>/dev/null | /usr/bin/awk '{print $1}')"
  [[ "${installed}" == "${OPENRGB_PACKAGE}" && "${digest}" == "${OPENRGB_SHA256}" ]]
}

validate_spd() {
  local endpoint
  local -a matches=()
  local value=''
  for endpoint in "${SPD_ENDPOINTS[@]}"; do
    matches=(/sys/bus/i2c/devices/"${endpoint}"/hwmon/hwmon*/temp1_input)
    [[ "${#matches[@]}" -eq 1 && -r "${matches[0]}" ]] || return 1
    value="$(/usr/bin/head -n 1 "${matches[0]}")"
    [[ "${value}" =~ ^[0-9]+$ && "${value}" -ge 10000 && "${value}" -le 125000 ]] \
      || return 1
  done
}

controller_inventory() {
  run_child /usr/bin/timeout --signal=TERM --kill-after=1s "${PROBE_TIMEOUT}" \
    "${OPENRGB_BIN}" --nodetect --list-devices 2>&1
}

validate_controllers() {
  local inventory="${1}"
  [[ "$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: ')" -eq 7 \
    && "$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: Corsair Dominator Platinum RGB DDR5$')" -eq 4 \
    && "$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: ASUS TUF GeForce RTX 4090 Gaming OG OC$')" -eq 1 \
    && "$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: Corsair ST100 RGB$')" -eq 1 \
    && "$(/usr/bin/printf '%s\n' "${inventory}" | /usr/bin/grep -Ec '^[0-9]+: ASUS ROG STRIX Z790-F GAMING WIFI$')" -eq 1 ]]
}

validate_effects() {
  run_child /usr/bin/timeout --signal=TERM --kill-after=1s "${PROBE_TIMEOUT}" \
    "${EFFECTS_SDK}" ready >/dev/null 2>&1
}

validate_hardware() {
  local inventory=''
  local attempt
  validate_package || {
    /usr/bin/printf '%s\n' 'OpenRGB package or executable identity is not accepted.' >&2
    return 1
  }
  validate_spd || {
    /usr/bin/printf '%s\n' 'Four healthy SPD5118 temperature endpoints are required.' >&2
    return 1
  }
  for ((attempt = 1; attempt <= PROBE_ATTEMPTS; attempt++)); do
    if validate_sdk_owner \
      && inventory="$(controller_inventory)" \
      && validate_controllers "${inventory}" \
      && validate_effects; then
      return 0
    fi
    /usr/bin/sleep 1
  done
  /usr/bin/printf '%s\n' "${inventory}" >"${LAST_LOG}"
  /usr/bin/printf '%s\n' \
    "OpenRGB SDK ownership, seven-controller inventory, or Effects readiness failed. Report: ${LAST_LOG}" >&2
  return 1
}

run_openrgb() {
  if [[ "${dry_run}" == true ]]; then
    print_command "${OPENRGB_BIN}" --nodetect "$@"
    return 0
  fi
  validate_sdk_owner || {
    /usr/bin/printf '%s\n' 'OpenRGB SDK ownership changed before mutation.' >&2
    return 1
  }
  validate_spd || {
    /usr/bin/printf '%s\n' 'SPD5118 health changed before mutation.' >&2
    return 1
  }
  if ! run_child /usr/bin/timeout --signal=TERM --kill-after=1s "${COMMAND_TIMEOUT}" \
    "${OPENRGB_BIN}" --nodetect "$@" >"${LAST_LOG}" 2>&1; then
    /usr/bin/printf '%s\n' "OpenRGB failed. Report: ${LAST_LOG}" >&2
    return 1
  fi
}

run_effects() {
  if [[ "${dry_run}" == true ]]; then
    print_command "${EFFECTS_SDK}" "$@"
    return 0
  fi
  validate_sdk_owner || {
    /usr/bin/printf '%s\n' 'OpenRGB SDK ownership changed before Effects mutation.' >&2
    return 1
  }
  validate_spd || {
    /usr/bin/printf '%s\n' 'SPD5118 health changed before Effects mutation.' >&2
    return 1
  }
  if ! run_child /usr/bin/timeout --signal=TERM --kill-after=1s "${COMMAND_TIMEOUT}" \
    "${EFFECTS_SDK}" "$@" >"${LAST_LOG}" 2>&1; then
    /usr/bin/printf '%s\n' "OpenRGB Effects operation failed. Report: ${LAST_LOG}" >&2
    return 1
  fi
}

apply_ram_static() {
  local color="${1}"
  run_openrgb --device "${RAM_DEVICE}" --mode direct --color "${color}"
}

effective_ram_color() {
  local preset="${1}"
  if ram_lighting_enabled; then
    ram_color_for_preset "${preset}"
  else
    /usr/bin/printf '%s' '000000'
  fi
}

apply_static_non_ram() {
  local main_color="${1}"
  local st100_base="${2}"
  local st100_logo="${3}"
  local mainboard_colors="${4}"
  run_openrgb \
    --device "${GPU_DEVICE}" --mode static --color "${main_color}" \
    --device "${ST100_DEVICE}" --zone 0 --mode direct --color "${st100_base}" \
    --device "${ST100_DEVICE}" --zone 1 --mode direct --color "${st100_logo}" \
    --device "${MAINBOARD_DEVICE}" --mode direct --color "${mainboard_colors}"
}

apply_rainbow_non_ram() {
  run_openrgb \
    --device "${GPU_DEVICE}" --mode rainbow --speed 50 \
    --device "${ST100_DEVICE}" --zone 0 --mode direct \
      --color FF0000,FF7F00,FFFF00,00FF00,00FFFF,0000FF,8B00FF,FF00FF \
    --device "${ST100_DEVICE}" --zone 1 --mode direct --color 2020FF \
    --device "${MAINBOARD_DEVICE}" --mode rainbow --speed 50
}

apply_preset() {
  local preset="${1}"
  local write_ram="${2:-true}"
  local persist_preset="${3:-true}"
  local ram_color=''
  ram_color="$(effective_ram_color "${preset}")"
  case "${preset}" in
    deep-red) run_effects stop-all; apply_static_non_ram 8B0000 A00000 A00000 8B0000 ;;
    bright-white) run_effects stop-all; apply_static_non_ram FFFFFF FFFFFF 2020FF FFFFFF ;;
    deep-blue) run_effects stop-all; apply_static_non_ram 000B22 000B22 000B22 000B22 ;;
    animated-rainbow) run_effects stop-all; apply_rainbow_non_ram ;;
    neon-rain) run_effects stop-all; run_effects load-profile hugin-rain 'Rain' ;;
    aurora-comet) run_effects stop-all; run_effects load-profile hugin-rainbow-comet 'Comet' ;;
    spectrum-wave) run_effects stop-all; run_effects load-profile hugin-rainbow-wave 'Rainbow Wave' ;;
    matte-black-orange) run_effects stop-all; run_effects load-profile hugin-sunrise-orange-black 'Sunrise' ;;
    electric-sunrise) run_effects stop-all; run_effects load-profile hugin-sunrise-blue-red 'Sunrise' ;;
    horde-red) run_effects stop-all; run_effects load-profile hugin-sunrise-red-black 'Sunrise' ;;
    alliance-blue) run_effects stop-all; run_effects load-profile hugin-sunrise-blue-black 'Sunrise' ;;
    black) run_effects stop-all; apply_static_non_ram 000000 000000 000000 000000 ;;
  esac
  if [[ "${write_ram}" == true ]]; then
    apply_ram_static "${ram_color}"
  fi
  if [[ "${dry_run}" == false && "${persist_preset}" == true ]]; then
    /usr/bin/printf '%s\n' "${preset}" >"${STATE_FILE}"
  fi
  /usr/bin/printf 'Preset: %s\nApplied: %s\n' "${preset}" "$(preset_label "${preset}")"
}

set_ram_lighting() {
  local state="${1}"
  local color='000000'
  if [[ "${state}" == 'on' ]]; then
    color="$(ram_color_for_preset "$(current_preset)")"
  fi
  apply_ram_static "${color}"
  if [[ "${dry_run}" == false ]]; then
    /usr/bin/printf '%s\n' "${state}" >"${RAM_STATE_FILE}"
  fi
  /usr/bin/printf 'RAM lighting: %s\n' "${state}"
}

acquire_mutation_lock() {
  exec 9>"${LOCK_FILE}"
  if ! /usr/bin/flock --nonblock 9; then
    /usr/bin/printf '%s\n' 'Another OpenRGB operation is already running.' >&2
    return 75
  fi
}

main() {
  local action='preset'
  local preset=''
  local write_ram=true
  local persist_preset=true
  umask 077
  [[ "${#}" -gt 0 ]] || { usage >&2; return 64; }
  case "${1}" in
    --help|-h) usage; return 0 ;;
    --list) list_presets; return 0 ;;
    --current) /usr/bin/printf '%s\n' "$(current_preset)"; return 0 ;;
    --ram-current)
      if ram_lighting_enabled; then /usr/bin/printf '%s\n' 'on'; else /usr/bin/printf '%s\n' 'off'; fi
      return 0
      ;;
    --dry-run)
      [[ "${#}" -eq 2 ]] || { usage >&2; return 64; }
      dry_run=true
      case "${2}" in
        --ram-on) action='ram-on' ;;
        --ram-off) action='ram-off' ;;
        *) is_preset "${2}" || { usage >&2; return 64; }; preset="${2}" ;;
      esac
      ;;
    --restore) [[ "${#}" -eq 1 ]] || { usage >&2; return 64; }; preset="$(current_preset)" ;;
    --restore-non-ram)
      [[ "${#}" -eq 1 ]] || { usage >&2; return 64; }
      preset="$(current_preset)"
      write_ram=false
      persist_preset=false
      ;;
    --ram-on) [[ "${#}" -eq 1 ]] || { usage >&2; return 64; }; action='ram-on' ;;
    --ram-off) [[ "${#}" -eq 1 ]] || { usage >&2; return 64; }; action='ram-off' ;;
    *)
      [[ "${#}" -eq 1 ]] && is_preset "${1}" || { usage >&2; return 64; }
      preset="${1}"
      ;;
  esac
  /usr/bin/mkdir -p "${STATE_ROOT}"
  acquire_mutation_lock
  if [[ "${dry_run}" == false ]]; then validate_hardware; fi
  case "${action}" in
    ram-on) set_ram_lighting on ;;
    ram-off) set_ram_lighting off ;;
    preset) apply_preset "${preset}" "${write_ram}" "${persist_preset}" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
