def _verify_stability_samples(raw: bytes) -> None:
    try:
        lines = raw.decode("utf-8").splitlines()
    except UnicodeDecodeError as error:
        raise RecoveryBlocked(
            "Recovery blocked: stability samples are unreadable."
        ) from error
    expected_header = (
        "sample\twall_time\tmonotonic_s\tendpoint\tstatus\ttemp_mc\tdetail"
    )
    if not lines or lines[0] != expected_header or len(lines) != 241:
        raise RecoveryBlocked("Recovery blocked: stability samples are incomplete.")
    expected_endpoints = {"10-0050", "10-0051", "10-0052", "10-0053"}
    samples: dict[int, set[str]] = {}
    sample_clock: dict[int, tuple[str, str]] = {}
    previous_monotonic: float | None = None
    for line in lines[1:]:
        fields = line.split("\t")
        if len(fields) != 7:
            raise RecoveryBlocked("Recovery blocked: stability samples are invalid.")
        sample_text, wall, monotonic, endpoint, status, temperature, detail = fields
        try:
            sample = int(sample_text)
            monotonic_value = float(monotonic)
            temperature_value = int(temperature)
        except ValueError as error:
            raise RecoveryBlocked(
                "Recovery blocked: stability samples are invalid."
            ) from error
        if (
            sample not in range(1, 61)
            or endpoint not in expected_endpoints
            or status != "ok"
            or temperature_value <= 0
            or detail != "-"
        ):
            raise RecoveryBlocked(
                "Recovery blocked: stability samples contain a failed reading."
            )
        _parse_observation_time(wall, "sample timestamp")
        clock = sample_clock.setdefault(sample, (wall, monotonic))
        if clock != (wall, monotonic):
            raise RecoveryBlocked(
                "Recovery blocked: stability sample timing is inconsistent."
            )
        endpoints = samples.setdefault(sample, set())
        if endpoint in endpoints:
            raise RecoveryBlocked(
                "Recovery blocked: stability samples contain a duplicate endpoint."
            )
        endpoints.add(endpoint)
        if len(endpoints) == 4:
            if previous_monotonic is not None and monotonic_value <= previous_monotonic:
                raise RecoveryBlocked(
                    "Recovery blocked: stability sample timing is not monotonic."
                )
            previous_monotonic = monotonic_value
    if set(samples) != set(range(1, 61)) or any(
        endpoints != expected_endpoints for endpoints in samples.values()
    ):
        raise RecoveryBlocked("Recovery blocked: stability samples are incomplete.")


def _verify_stability_summary(raw: bytes) -> None:
    try:
        lines = raw.decode("utf-8").splitlines()
    except UnicodeDecodeError as error:
        raise RecoveryBlocked(
            "Recovery blocked: stability summary is unreadable."
        ) from error
    expected_header = (
        "endpoint\tsamples\tok\tfailures\tmissing\tmalformed\tmin_mc\tmax_mc\tfinal_mc"
    )
    expected_endpoints = {"10-0050", "10-0051", "10-0052", "10-0053"}
    if not lines or lines[0] != expected_header or len(lines) != 5:
        raise RecoveryBlocked("Recovery blocked: stability summary is incomplete.")
    seen: set[str] = set()
    for line in lines[1:]:
        fields = line.split("\t")
        if len(fields) != 9 or fields[0] not in expected_endpoints:
            raise RecoveryBlocked("Recovery blocked: stability summary is invalid.")
        endpoint = fields[0]
        if endpoint in seen:
            raise RecoveryBlocked(
                "Recovery blocked: stability summary contains a duplicate endpoint."
            )
        seen.add(endpoint)
        try:
            samples, ok, failures, missing, malformed, minimum, maximum, final = (
                int(value) for value in fields[1:]
            )
        except ValueError as error:
            raise RecoveryBlocked(
                "Recovery blocked: stability summary is invalid."
            ) from error
        if (
            (samples, ok, failures, missing, malformed) != (60, 60, 0, 0, 0)
            or minimum <= 0
            or maximum < minimum
            or not minimum <= final <= maximum
        ):
            raise RecoveryBlocked(
                "Recovery blocked: stability summary contains a failed reading."
            )
    if seen != expected_endpoints:
        raise RecoveryBlocked("Recovery blocked: stability summary is incomplete.")


def _verify_stability_evidence(
    reviewed: ReviewedHardwareHealth,
) -> StabilityEvidence:
    root = state_root() / "recovery-evidence" / reviewed.stability_directory
    _require_private_directory(root, "SPD5118 stability evidence directory")
    try:
        names = {entry.name for entry in root.iterdir()}
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: SPD5118 stability evidence is unreadable."
        ) from error
    if names != STABILITY_DIRECTORY_FILES:
        raise RecoveryBlocked(
            "Recovery blocked: SPD5118 stability evidence inventory changed."
        )
    files = {
        name: _read_protected_bytes(root / name, f"stability evidence {name}")
        for name in sorted(names)
    }
    manifest_raw = files["manifest.sha256"]
    if hashlib.sha256(manifest_raw).hexdigest() != reviewed.stability_manifest_sha256:
        raise RecoveryBlocked("Recovery blocked: SPD5118 stability manifest changed.")
    try:
        manifest_lines = manifest_raw.decode("ascii").splitlines()
    except UnicodeDecodeError as error:
        raise RecoveryBlocked(
            "Recovery blocked: SPD5118 stability manifest is unreadable."
        ) from error
    manifest: dict[str, str] = {}
    for line in manifest_lines:
        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9][A-Za-z0-9._-]*)", line)
        if match is None or match.group(2) in manifest:
            raise RecoveryBlocked(
                "Recovery blocked: SPD5118 stability manifest is invalid."
            )
        manifest[match.group(2)] = match.group(1)
    if set(manifest) != STABILITY_MANIFEST_FILES:
        raise RecoveryBlocked(
            "Recovery blocked: SPD5118 stability manifest is incomplete."
        )
    for name, expected in manifest.items():
        if hashlib.sha256(files[name]).hexdigest() != expected:
            raise RecoveryBlocked(
                f"Recovery blocked: stability evidence checksum failed: {name}."
            )

    metadata = _key_value_document(files["metadata.txt"], "stability metadata")
    expected_keys = {
        "incident",
        "plugin_version",
        "plugin_revision",
        "latch_sha256_before",
        "kernel_cursor",
        "started",
        "ended",
        "samples_completed",
        "stop_reason",
        "latch_sha256_after",
    }
    if set(metadata) != expected_keys or (
        metadata["incident"] != reviewed.incident_reference
        or metadata["plugin_version"] != "0.4.26"
        or metadata["plugin_revision"] != reviewed.observed_source_revision
        or metadata["latch_sha256_before"] != reviewed.latch_sha256
        or metadata["latch_sha256_after"] != reviewed.latch_sha256
        or metadata["samples_completed"] != "60"
        or metadata["stop_reason"] != "complete"
    ):
        raise RecoveryBlocked("Recovery blocked: stability metadata is invalid.")
    cursor = metadata["kernel_cursor"]
    cursor_boot = JOURNAL_CURSOR_BOOT_ID.search(cursor)
    if (
        cursor_boot is None
        or cursor_boot.group(1).lower() != _current_boot_id().replace("-", "").lower()
    ):
        raise RecoveryBlocked(
            "Recovery blocked: stability evidence belongs to another boot."
        )
    started = _parse_observation_time(metadata["started"], "start time")
    ended = _parse_observation_time(metadata["ended"], "end time")
    if not 60 <= ended - started <= 65 or ended > time.time():
        raise RecoveryBlocked(
            "Recovery blocked: stability observation duration is invalid."
        )
    if files["kernel-reader.stderr"] or files["kernel-relevant.log"]:
        raise RecoveryBlocked(
            "Recovery blocked: stability observation recorded a kernel failure."
        )
    try:
        kernel_lines = files["kernel-all.log"].decode("utf-8").splitlines()
    except UnicodeDecodeError as error:
        raise RecoveryBlocked(
            "Recovery blocked: stability kernel evidence is unreadable."
        ) from error
    if any(
        RELEVANT_KERNEL_ERROR.search(line) or SUSPEND_RESUME_EVENT.search(line)
        for line in kernel_lines
    ):
        raise RecoveryBlocked(
            "Recovery blocked: stability window contains a hardware or sleep event."
        )
    _verify_stability_samples(files["samples.tsv"])
    _verify_stability_summary(files["summary.tsv"])
    return StabilityEvidence(
        files=tuple(sorted(files.items())),
        journal_cursor=cursor,
        observation_start=started,
        observation_end=ended,
    )


def _kernel_history_after_observation(cursor: str) -> None:
    journal = subprocess.run(
        [
            JOURNALCTL,
            "-k",
            "--after-cursor",
            cursor,
            "--show-cursor",
            "--no-pager",
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if journal.returncode != 0 or "-- cursor: " not in journal.stdout:
        raise RecoveryBlocked(
            "Recovery blocked: post-observation kernel history is unreadable."
        )
    if any(RELEVANT_KERNEL_ERROR.search(line) for line in journal.stdout.splitlines()):
        raise RecoveryBlocked(
            "Recovery blocked: a kernel communication error followed the observation."
        )
    if any(SUSPEND_RESUME_EVENT.search(line) for line in journal.stdout.splitlines()):
        raise RecoveryBlocked(
            "Recovery blocked: suspend or resume followed the stability observation."
        )


def _journal_cursor(output: str, label: str) -> str:
    for line in reversed(output.splitlines()):
        if line.startswith("-- cursor: "):
            cursor = line.removeprefix("-- cursor: ").strip()
            if cursor:
                return cursor
    raise RecoveryBlocked(f"Recovery blocked: {label} journal cursor is unavailable.")


def _capture_kernel_cursor() -> str:
    journal = subprocess.run(
        [JOURNALCTL, "-b", "-k", "-n", "0", "--show-cursor", "--no-pager"],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if journal.returncode != 0 or journal.stderr.strip():
        raise RecoveryBlocked(
            "Recovery blocked: the kernel observation baseline is unreadable."
        )
    cursor = _journal_cursor(journal.stdout, "kernel observation baseline")
    cursor_boot = JOURNAL_CURSOR_BOOT_ID.search(cursor)
    if (
        cursor_boot is None
        or cursor_boot.group(1).lower() != _current_boot_id().replace("-", "").lower()
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the kernel observation baseline is from another boot."
        )
    return cursor


def _read_kernel_window(cursor: str) -> tuple[str, tuple[str, ...]]:
    journal = subprocess.run(
        [
            JOURNALCTL,
            "-b",
            "-k",
            "--after-cursor",
            cursor,
            "--show-cursor",
            "--no-pager",
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if journal.returncode != 0 or journal.stderr.strip():
        raise RecoveryBlocked(
            "Recovery blocked: the kernel observation window is unreadable."
        )
    next_cursor = _journal_cursor(journal.stdout, "kernel observation")
    relevant = tuple(
        line
        for line in journal.stdout.splitlines()
        if RELEVANT_KERNEL_ERROR.search(line) or SUSPEND_RESUME_EVENT.search(line)
    )
    if relevant:
        raise RecoveryBlocked(
            "Recovery blocked: the SPD observation encountered a kernel or sleep event."
        )
    return next_cursor, relevant


def _spd_temperature_path(endpoint: str) -> Path:
    if endpoint not in TRANSIENT_SPD_ENDPOINTS:
        raise RecoveryBlocked("Recovery blocked: the SPD endpoint is invalid.")
    device = SPD_SYSFS_ROOT / endpoint
    try:
        if device.joinpath("driver").resolve(strict=True).name != "spd5118":
            raise RecoveryBlocked(
                f"Recovery blocked: {endpoint} is not bound to spd5118."
            )
        paths = tuple(device.glob("hwmon/hwmon*/temp1_input"))
    except OSError as error:
        raise RecoveryBlocked(
            f"Recovery blocked: {endpoint} telemetry is unreadable."
        ) from error
    if len(paths) != 1 or paths[0].is_symlink():
        raise RecoveryBlocked(
            f"Recovery blocked: {endpoint} has an invalid temperature endpoint."
        )
    return paths[0]


def _read_spd_temperature(endpoint: str, path: Path) -> int:
    try:
        raw = path.read_text(encoding="utf-8")
    except OSError as error:
        raise RecoveryBlocked(
            f"Recovery blocked: {endpoint} temperature read failed "
            f"({type(error).__name__}, errno={error.errno})."
        ) from error
    stripped = raw.strip()
    if not stripped:
        raise RecoveryBlocked(f"Recovery blocked: {endpoint} temperature was empty.")
    try:
        value = int(stripped)
    except ValueError as error:
        raise RecoveryBlocked(
            f"Recovery blocked: {endpoint} temperature was malformed."
        ) from error
    if value <= 0:
        raise RecoveryBlocked(f"Recovery blocked: {endpoint} temperature was invalid.")
    return value


def _transient_spd_post_incident_evidence(
    incident: TransientSpdIncident, lifecycle_ready_time: float
) -> bytes:
    """Capture and qualify complete journal history after an SPD incident."""

    qualified_at = time.time()
    kernel = _software_interruption_journal_slice(
        kernel=True,
        since=incident.failure_time,
        until=qualified_at,
        label="transient SPD kernel",
    )
    service = _software_interruption_journal_slice(
        kernel=False,
        since=incident.failure_time,
        until=qualified_at,
        label="transient SPD service",
    )
    if any(
        RELEVANT_KERNEL_ERROR.search(line) or SUSPEND_RESUME_EVENT.search(line)
        for line in kernel.splitlines()
    ):
        raise RecoveryBlocked(
            "Recovery blocked: a kernel communication or suspend event followed "
            "the transient SPD incident."
        )
    if any(POST_READY_SERVICE_FAILURE.search(line) for line in service.splitlines()):
        raise RecoveryBlocked(
            "Recovery blocked: a service failure or ownership transition followed "
            "the transient SPD incident."
        )
    document = {
        "schema_version": 1,
        "category": "transient-spd-post-incident",
        "failure_time": incident.failure_time,
        "lifecycle_ready_time": lifecycle_ready_time,
        "qualified_at": qualified_at,
        "kernel": kernel,
        "service": service,
    }
    return (json.dumps(document, sort_keys=True) + "\n").encode()


def _transient_spd_environment_preflight(
    incident: TransientSpdIncident,
    *,
    require_preference_off: bool = True,
) -> tuple[bytes, bytes, dict[str, object], bytes]:
    current_state_path = state_root() / "lifecycle-service-state.json"
    current_state_raw = _read_protected_bytes(
        current_state_path, "current lifecycle state"
    )
    current = _json_record(current_state_raw, "current lifecycle state")
    current_time = current.get("time")
    if (
        current.get("state") != "ready"
        or current.get("reason") != HISTORICAL_READY_REASON
        or current.get("boot_id") != _current_boot_id()
        or not isinstance(current_time, (int, float))
        or isinstance(current_time, bool)
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the incident has no authoritative healthy lifecycle."
        )
    config_raw = _detector_policy_is_reviewed()
    _verify_historical_running_environment(
        current,
        config_raw,
        require_preference_off=require_preference_off,
    )
    health = _verify_service_and_hardware(None)
    qualification_raw = _transient_spd_post_incident_evidence(
        incident, float(current_time)
    )
    if _failure_record()[0] != incident.failure_raw:
        raise RecoveryBlocked(
            "Recovery blocked: the transient SPD latch changed during review."
        )
    if (
        _read_protected_bytes(current_state_path, "current lifecycle state")
        != current_state_raw
        or _detector_policy_is_reviewed() != config_raw
    ):
        raise RecoveryBlocked(
            "Recovery blocked: service or configuration identity changed during review."
        )
    return current_state_raw, config_raw, health, qualification_raw


def _write_transient_spd_observation(
    directory_name: str,
    payloads: dict[str, bytes],
) -> tuple[Path, str]:
    if not TRANSIENT_SPD_DIRECTORY.fullmatch(directory_name):
        raise RecoveryBlocked(
            "Recovery blocked: observation directory name is invalid."
        )
    if set(payloads) != TRANSIENT_SPD_EVIDENCE_FILES:
        raise RecoveryBlocked("Recovery blocked: observation evidence is incomplete.")
    evidence_root = state_root() / "recovery-evidence"
    _private_directory(state_root())
    _private_directory(evidence_root)
    temporary = Path(tempfile.mkdtemp(prefix=".transient-spd-", dir=evidence_root))
    temporary.chmod(0o700)
    destination = evidence_root / directory_name
    try:
        for name, raw in sorted(payloads.items()):
            path = temporary / name
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(descriptor, "wb") as handle:
                handle.write(raw)
                handle.flush()
                os.fsync(handle.fileno())
        manifest_raw = b"".join(
            f"{hashlib.sha256(payloads[name]).hexdigest()}  {name}\n".encode()
            for name in sorted(payloads)
        )
        manifest_path = temporary / "manifest.sha256"
        descriptor = os.open(manifest_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(manifest_raw)
            handle.flush()
            os.fsync(handle.fileno())
        _fsync_directory(temporary)
        os.rename(temporary, destination)
        _fsync_directory(evidence_root)
    except BaseException:
        if temporary.exists():
            shutil.rmtree(temporary)
        raise
    manifest_sha256 = hashlib.sha256(manifest_raw).hexdigest()
    return destination, manifest_sha256


def observe_transient_spd() -> dict[str, object]:
    """Create one bounded, no-write observation for the current eligible latch."""

    root = runtime_root()
    _private_directory(root)
    lock_fd = os.open(root / "lighting-recovery.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RecoveryBlocked(
                "Recovery blocked: another recovery is active."
            ) from error

        incident = _classify_transient_spd_incident()
        current_state_raw, config_raw, _, qualification_raw = (
            _transient_spd_environment_preflight(incident)
        )
        current = _json_record(current_state_raw, "current lifecycle state")
        lifecycle_pid, lifecycle_start = _identity(current, "lifecycle")
        server_pid, server_start = _identity(current, "server")
        boot_id = _current_boot_id()
        suspend_count = _current_suspend_count()
        paths = {
            endpoint: _spd_temperature_path(endpoint)
            for endpoint in TRANSIENT_SPD_ENDPOINTS
        }
        cursor_start = _capture_kernel_cursor()
        cursor = cursor_start
        started_wall = time.time()
        started_monotonic = time.monotonic()
        lines = ["sample\twall_time\tmonotonic_s\tendpoint\tstatus\ttemp_mc\tdetail"]
        for sample in range(1, TRANSIENT_SPD_OBSERVATION_SAMPLES + 1):
            target = started_monotonic + (
                (sample - 1) * TRANSIENT_SPD_SAMPLE_INTERVAL_SECONDS
            )
            delay = target - time.monotonic()
            if delay > 0:
                time.sleep(delay)
            sample_monotonic = time.monotonic()
            if sample_monotonic - target > TRANSIENT_SPD_MAX_LATE_SECONDS:
                raise RecoveryBlocked(
                    "Recovery blocked: the SPD observation schedule overran."
                )
            if (
                _current_boot_id() != boot_id
                or _current_suspend_count() != suspend_count
                or _process_start(lifecycle_pid) != lifecycle_start
                or _process_start(server_pid) != server_start
                or _failure_record()[0] != incident.failure_raw
            ):
                raise RecoveryBlocked(
                    "Recovery blocked: observation ownership or continuity changed."
                )
            wall = datetime.fromtimestamp(time.time(), UTC).isoformat(
                timespec="microseconds"
            )
            for endpoint in TRANSIENT_SPD_ENDPOINTS:
                value = _read_spd_temperature(endpoint, paths[endpoint])
                lines.append(
                    f"{sample}\t{wall}\t{sample_monotonic:.6f}\t{endpoint}"
                    f"\tok\t{value}\t-"
                )
            cursor, _ = _read_kernel_window(cursor)

        ended_wall = time.time()
        ended_monotonic = time.monotonic()
        if ended_monotonic - started_monotonic > 60.0:
            raise RecoveryBlocked(
                "Recovery blocked: the SPD observation exceeded 60 seconds."
            )
        second_state_raw, second_config_raw, _, _ = (
            _transient_spd_environment_preflight(incident)
        )
        if second_state_raw != current_state_raw or second_config_raw != config_raw:
            raise RecoveryBlocked(
                "Recovery blocked: service identity changed during the observation."
            )
        if _current_suspend_count() != suspend_count or _current_boot_id() != boot_id:
            raise RecoveryBlocked(
                "Recovery blocked: boot or suspend changed during the observation."
            )

        timestamp = (
            datetime.fromtimestamp(started_wall)
            .astimezone()
            .strftime("%Y%m%dT%H%M%S%z")
        )
        directory_name = f"{incident.incident_reference}-transient-spd-{timestamp}"
        metadata = {
            "schema_version": 1,
            "category": "reviewed-transient-spd",
            "plugin_version": "0.4.33",
            "incident": {
                "reference": incident.incident_reference,
                "latch_sha256": incident.latch_sha256,
                "reason": incident.original_reason,
                "endpoint": incident.endpoint,
                "classification": incident.classification,
                "source_revision": incident.source_revision,
                "source_path": incident.source_path,
                "source_sha256": incident.source_sha256,
            },
            "environment": {
                "boot_id": boot_id,
                "suspend_count": suspend_count,
                "lifecycle_pid": lifecycle_pid,
                "lifecycle_start": lifecycle_start,
                "server_pid": server_pid,
                "server_start": server_start,
                "kernel_cursor_start": cursor_start,
                "kernel_cursor_end": cursor,
            },
            "qualification": json.loads(qualification_raw),
            "observation": {
                "started": datetime.fromtimestamp(started_wall, UTC).isoformat(
                    timespec="microseconds"
                ),
                "ended": datetime.fromtimestamp(ended_wall, UTC).isoformat(
                    timespec="microseconds"
                ),
                "samples_completed": 60,
                "readings_completed": 240,
                "status": "complete",
            },
        }
        payloads = {
            "failure-latch.json": incident.failure_raw,
            "kernel-relevant.log": b"",
            "metadata.json": (json.dumps(metadata, sort_keys=True) + "\n").encode(),
            "samples.tsv": ("\n".join(lines) + "\n").encode(),
        }
        destination, manifest_sha256 = _write_transient_spd_observation(
            directory_name, payloads
        )
        observation = _verify_transient_spd_observation(
            incident, directory_name, manifest_sha256
        )
        if dict(observation.files) != payloads | {
            "manifest.sha256": (destination / "manifest.sha256").read_bytes()
        }:
            raise RecoveryBlocked(
                "Recovery blocked: observation readback did not match."
            )
        return {
            "state": "observed",
            "incident_reference": incident.incident_reference,
            "observation_directory": directory_name,
            "stability_manifest_sha256": manifest_sha256,
            "samples": 60,
            "readings": 240,
            "message": "Transient SPD observation complete; latch unchanged.",
        }
    finally:
        os.close(lock_fd)


def _verify_transient_spd_samples(raw: bytes) -> None:
    try:
        lines = raw.decode("utf-8").splitlines()
    except UnicodeDecodeError as error:
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD samples are unreadable."
        ) from error
    header = "sample\twall_time\tmonotonic_s\tendpoint\tstatus\ttemp_mc\tdetail"
    if not lines or lines[0] != header or len(lines) != 241:
        raise RecoveryBlocked("Recovery blocked: transient SPD samples are incomplete.")
    sample_times: dict[int, float] = {}
    sample_walls: dict[int, str] = {}
    endpoints: dict[int, set[str]] = {}
    for line in lines[1:]:
        fields = line.split("\t")
        if len(fields) != 7:
            raise RecoveryBlocked(
                "Recovery blocked: transient SPD samples are invalid."
            )
        sample_text, wall, monotonic, endpoint, status, temperature, detail = fields
        try:
            sample = int(sample_text)
            monotonic_value = float(monotonic)
            temperature_value = int(temperature)
        except ValueError as error:
            raise RecoveryBlocked(
                "Recovery blocked: transient SPD samples are invalid."
            ) from error
        if (
            sample not in range(1, 61)
            or endpoint not in TRANSIENT_SPD_ENDPOINTS
            or status != "ok"
            or temperature_value <= 0
            or detail != "-"
        ):
            raise RecoveryBlocked(
                "Recovery blocked: transient SPD samples contain a failed read."
            )
        _parse_observation_time(wall, "sample timestamp")
        if sample in sample_times and (
            sample_times[sample] != monotonic_value or sample_walls[sample] != wall
        ):
            raise RecoveryBlocked(
                "Recovery blocked: transient SPD sample timing is inconsistent."
            )
        sample_times.setdefault(sample, monotonic_value)
        sample_walls.setdefault(sample, wall)
        seen = endpoints.setdefault(sample, set())
        if endpoint in seen:
            raise RecoveryBlocked(
                "Recovery blocked: transient SPD samples contain a duplicate endpoint."
            )
        seen.add(endpoint)
    if set(sample_times) != set(range(1, 61)) or any(
        seen != set(TRANSIENT_SPD_ENDPOINTS) for seen in endpoints.values()
    ):
        raise RecoveryBlocked("Recovery blocked: transient SPD samples are incomplete.")
    ordered = [sample_times[sample] for sample in range(1, 61)]
    intervals = [later - earlier for earlier, later in pairwise(ordered)]
    if (
        any(interval < 0.75 or interval > 1.25 for interval in intervals)
        or not 58.5 <= ordered[-1] - ordered[0] <= 59.5
    ):
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD sampling cadence is invalid."
        )


def _verify_transient_spd_observation(
    incident: TransientSpdIncident,
    directory_name: str,
    manifest_sha256: str,
) -> TransientSpdObservation:
    if not TRANSIENT_SPD_DIRECTORY.fullmatch(directory_name) or not re.fullmatch(
        r"[0-9a-f]{64}", manifest_sha256
    ):
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD observation binding is invalid."
        )
    root = state_root() / "recovery-evidence" / directory_name
    _require_private_directory(root, "transient SPD observation directory")
    try:
        names = {entry.name for entry in root.iterdir()}
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD observation is unreadable."
        ) from error
    expected_names = TRANSIENT_SPD_EVIDENCE_FILES | {"manifest.sha256"}
    if names != expected_names:
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD observation inventory changed."
        )
    files = {
        name: _read_protected_bytes(root / name, f"transient SPD evidence {name}")
        for name in sorted(names)
    }
    manifest_raw = files["manifest.sha256"]
    if hashlib.sha256(manifest_raw).hexdigest() != manifest_sha256:
        raise RecoveryBlocked("Recovery blocked: transient SPD manifest changed.")
    try:
        manifest_lines = manifest_raw.decode("ascii").splitlines()
    except UnicodeDecodeError as error:
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD manifest is unreadable."
        ) from error
    manifest: dict[str, str] = {}
    for line in manifest_lines:
        match = re.fullmatch(r"([0-9a-f]{64})  ([A-Za-z0-9][A-Za-z0-9._-]*)", line)
        if match is None or match.group(2) in manifest:
            raise RecoveryBlocked(
                "Recovery blocked: transient SPD manifest is invalid."
            )
        manifest[match.group(2)] = match.group(1)
    if set(manifest) != TRANSIENT_SPD_EVIDENCE_FILES:
        raise RecoveryBlocked("Recovery blocked: transient SPD manifest is incomplete.")
    for name, expected in manifest.items():
        if hashlib.sha256(files[name]).hexdigest() != expected:
            raise RecoveryBlocked(
                f"Recovery blocked: transient SPD checksum failed: {name}."
            )
    if files["failure-latch.json"] != incident.failure_raw:
        raise RecoveryBlocked(
            "Recovery blocked: observation latch does not match the current incident."
        )
    if files["kernel-relevant.log"]:
        raise RecoveryBlocked(
            "Recovery blocked: observation contains a kernel or sleep event."
        )
    _verify_transient_spd_samples(files["samples.tsv"])
    metadata = _json_record(files["metadata.json"], "transient SPD metadata")
    legacy_keys = {
        "schema_version",
        "category",
        "plugin_version",
        "incident",
        "environment",
        "observation",
    }
    current_keys = legacy_keys | {"qualification"}
    plugin_version = metadata.get("plugin_version")
    if (
        (plugin_version == "0.4.30" and set(metadata) != legacy_keys)
        or (plugin_version == "0.4.33" and set(metadata) != current_keys)
        or plugin_version not in {"0.4.30", "0.4.33"}
    ):
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD metadata schema is invalid."
        )
    incident_data = metadata.get("incident")
    environment = metadata.get("environment")
    observation = metadata.get("observation")
    qualification = metadata.get("qualification")
    if (
        metadata.get("schema_version") != 1
        or metadata.get("category") != "reviewed-transient-spd"
        or not isinstance(incident_data, dict)
        or not isinstance(environment, dict)
        or not isinstance(observation, dict)
        or incident_data
        != {
            "reference": incident.incident_reference,
            "latch_sha256": incident.latch_sha256,
            "reason": incident.original_reason,
            "endpoint": incident.endpoint,
            "classification": incident.classification,
            "source_revision": incident.source_revision,
            "source_path": incident.source_path,
            "source_sha256": incident.source_sha256,
        }
        or set(environment)
        != {
            "boot_id",
            "suspend_count",
            "lifecycle_pid",
            "lifecycle_start",
            "server_pid",
            "server_start",
            "kernel_cursor_start",
            "kernel_cursor_end",
        }
        or set(observation)
        != {
            "started",
            "ended",
            "samples_completed",
            "readings_completed",
            "status",
        }
    ):
        raise RecoveryBlocked("Recovery blocked: transient SPD metadata is invalid.")
    boot_id = environment.get("boot_id")
    suspend_count = environment.get("suspend_count")
    lifecycle_pid = environment.get("lifecycle_pid")
    lifecycle_start = environment.get("lifecycle_start")
    server_pid = environment.get("server_pid")
    server_start = environment.get("server_start")
    cursor_start = environment.get("kernel_cursor_start")
    cursor_end = environment.get("kernel_cursor_end")
    if (
        not isinstance(boot_id, str)
        or boot_id != _current_boot_id()
        or not isinstance(suspend_count, int)
        or isinstance(suspend_count, bool)
        or suspend_count != _current_suspend_count()
        or not isinstance(lifecycle_pid, int)
        or isinstance(lifecycle_pid, bool)
        or lifecycle_pid <= 0
        or not isinstance(lifecycle_start, str)
        or not lifecycle_start
        or not isinstance(server_pid, int)
        or isinstance(server_pid, bool)
        or server_pid <= 0
        or not isinstance(server_start, str)
        or not server_start
        or not isinstance(cursor_start, str)
        or not isinstance(cursor_end, str)
        or not cursor_start
        or not cursor_end
    ):
        raise RecoveryBlocked(
            "Recovery blocked: observation environment no longer matches."
        )
    for cursor in (cursor_start, cursor_end):
        cursor_boot = JOURNAL_CURSOR_BOOT_ID.search(cursor)
        if (
            cursor_boot is None
            or cursor_boot.group(1).lower() != boot_id.replace("-", "").lower()
        ):
            raise RecoveryBlocked(
                "Recovery blocked: observation cursor belongs to another boot."
            )
    started_value = observation.get("started")
    ended_value = observation.get("ended")
    if not isinstance(started_value, str) or not isinstance(ended_value, str):
        raise RecoveryBlocked("Recovery blocked: observation timestamps are invalid.")
    started = _parse_observation_time(started_value, "start time")
    ended = _parse_observation_time(ended_value, "end time")
    if (
        not 58.0 <= ended - started <= 60.0
        or ended > time.time()
        or observation.get("samples_completed") != 60
        or observation.get("readings_completed") != 240
        or observation.get("status") != "complete"
    ):
        raise RecoveryBlocked(
            "Recovery blocked: observation completion record is invalid."
        )
    if plugin_version == "0.4.33":
        if not isinstance(qualification, dict) or set(qualification) != {
            "schema_version",
            "category",
            "failure_time",
            "lifecycle_ready_time",
            "qualified_at",
            "kernel",
            "service",
        }:
            raise RecoveryBlocked(
                "Recovery blocked: transient SPD qualification evidence is invalid."
            )
        failure_time = qualification.get("failure_time")
        ready_time = qualification.get("lifecycle_ready_time")
        qualified_at = qualification.get("qualified_at")
        kernel = qualification.get("kernel")
        service = qualification.get("service")
        if (
            qualification.get("schema_version") != 1
            or qualification.get("category") != "transient-spd-post-incident"
            or failure_time != incident.failure_time
            or not isinstance(ready_time, (int, float))
            or isinstance(ready_time, bool)
            or not isinstance(qualified_at, (int, float))
            or isinstance(qualified_at, bool)
            or not incident.failure_time <= float(qualified_at) <= started
            or not isinstance(kernel, str)
            or not isinstance(service, str)
            or any(
                RELEVANT_KERNEL_ERROR.search(line) or SUSPEND_RESUME_EVENT.search(line)
                for line in kernel.splitlines()
            )
            or any(
                POST_READY_SERVICE_FAILURE.search(line) for line in service.splitlines()
            )
        ):
            raise RecoveryBlocked(
                "Recovery blocked: transient SPD qualification evidence is invalid."
            )
    return TransientSpdObservation(
        directory_name=directory_name,
        manifest_sha256=manifest_sha256,
        files=tuple(sorted(files.items())),
        metadata_raw=files["metadata.json"],
        journal_cursor=cursor_end,
        observation_start=started,
        observation_end=ended,
        boot_id=boot_id,
        suspend_count=suspend_count,
        lifecycle_pid=lifecycle_pid,
        lifecycle_start=lifecycle_start,
        server_pid=server_pid,
        server_start=server_start,
    )


def _transient_spd_clearance_preflight(
    observation_directory: str,
    stability_manifest_sha256: str,
) -> TransientSpdClearanceBinding:
    incident = _classify_transient_spd_incident()
    observation = _verify_transient_spd_observation(
        incident, observation_directory, stability_manifest_sha256
    )
    if observation.observation_start <= incident.failure_time:
        raise RecoveryBlocked(
            "Recovery blocked: the SPD observation predates the incident."
        )
    current_state_raw, config_raw, _, _ = _transient_spd_environment_preflight(incident)
    current = _json_record(current_state_raw, "current lifecycle state")
    lifecycle_pid, lifecycle_start = _identity(current, "lifecycle")
    server_pid, server_start = _identity(current, "server")
    if (
        (lifecycle_pid, lifecycle_start)
        != (observation.lifecycle_pid, observation.lifecycle_start)
        or (server_pid, server_start)
        != (observation.server_pid, observation.server_start)
        or _current_boot_id() != observation.boot_id
        or _current_suspend_count() != observation.suspend_count
    ):
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle, SDK, boot, or suspend identity changed "
            "after observation."
        )
    _kernel_history_after_observation(observation.journal_cursor)
    installed_source_revision = _verify_corrected_source_revision(
        incident.source_revision
    )
    if _failure_record()[0] != incident.failure_raw:
        raise RecoveryBlocked(
            "Recovery blocked: the transient SPD latch changed during review."
        )
    return TransientSpdClearanceBinding(
        incident=incident,
        current_state_raw=current_state_raw,
        config_raw=config_raw,
        observation=observation,
        installed_source_revision=installed_source_revision,
    )


def _preserve_transient_spd_observation(
    incident: TransientSpdIncident,
    observation: TransientSpdObservation,
) -> Path:
    evidence_root = state_root() / "recovery-evidence"
    _private_directory(state_root())
    _private_directory(evidence_root)
    destination = evidence_root / (
        f"{incident.incident_reference}.transient-spd-observation"
    )
    try:
        destination.mkdir(mode=0o700)
    except FileExistsError:
        _require_private_directory(
            destination, "retained transient SPD observation directory"
        )
    expected = dict(observation.files)
    try:
        existing = {entry.name for entry in destination.iterdir()}
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: retained transient SPD observation is unreadable."
        ) from error
    if not existing.issubset(expected):
        raise RecoveryBlocked(
            "Recovery blocked: retained transient SPD observation has extra files."
        )
    for name, raw in observation.files:
        path = destination / name
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            if _read_protected_bytes(path, f"retained transient SPD {name}") != raw:
                raise RecoveryBlocked(
                    "Recovery blocked: retained transient SPD observation changed."
                )
            continue
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(raw)
            handle.flush()
            os.fsync(handle.fileno())
    if {entry.name for entry in destination.iterdir()} != set(expected):
        raise RecoveryBlocked(
            "Recovery blocked: retained transient SPD observation is incomplete."
        )
    _fsync_directory(destination)
    _fsync_directory(evidence_root)
    return destination


def _verify_transient_spd_continuity(
    binding: TransientSpdClearanceBinding,
) -> None:
    incident = binding.incident
    if (
        _verify_corrected_source_revision(incident.source_revision)
        != binding.installed_source_revision
    ):
        raise RecoveryBlocked(
            "Recovery blocked: installed source changed during clearance."
        )
    observation = _verify_transient_spd_observation(
        incident,
        binding.observation.directory_name,
        binding.observation.manifest_sha256,
    )
    if observation != binding.observation:
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD observation changed during clearance."
        )
    current_state_path = state_root() / "lifecycle-service-state.json"
    current_state_raw = _read_protected_bytes(
        current_state_path, "current lifecycle state"
    )
    current = _json_record(current_state_raw, "current lifecycle state")
    config_raw = _detector_policy_is_reviewed()
    _verify_historical_running_environment(current, config_raw)
    _verify_service_and_hardware(None)
    if (
        current_state_raw != binding.current_state_raw
        or config_raw != binding.config_raw
        or _current_boot_id() != observation.boot_id
        or _current_suspend_count() != observation.suspend_count
    ):
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle or configuration changed during clearance."
        )
    _kernel_history_after_observation(observation.journal_cursor)


def _historical_kernel_evidence(failure_time: float, observation_start: float) -> bytes:
    journal = subprocess.run(
        [
            JOURNALCTL,
            "-k",
            f"--since=@{failure_time}",
            f"--until=@{observation_start}",
            "--no-pager",
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if journal.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: historical kernel evidence is unreadable."
        )
    retained = [
        line
        for line in journal.stdout.splitlines()
        if RELEVANT_KERNEL_ERROR.search(line) or SUSPEND_RESUME_EVENT.search(line)
    ]
    if not retained or not any(
        RELEVANT_KERNEL_ERROR.search(line) and "spd5118" in line.lower()
        for line in retained
    ):
        raise RecoveryBlocked(
            "Recovery blocked: reviewed historical SPD5118 errors are unavailable."
        )
    document = {
        "failure_time": failure_time,
        "observation_start": observation_start,
        "retained_lines": retained,
    }
    return (json.dumps(document, sort_keys=True) + "\n").encode()


def _validate_lifecycle_boundary(
    failure: dict[str, object], message: str, state: dict[str, object]
) -> float:
    if message not in LIFECYCLE_RECOVERY_REASONS:
        raise RecoveryBlocked(
            "Recovery blocked: this failure is not a reviewed lifecycle boundary."
        )
    failure_time, _ = _timestamp(failure)
    state_time = state.get("time")
    if (
        failure_time is None
        or not isinstance(state_time, (int, float))
        or isinstance(state_time, bool)
        or failure_time < float(state_time)
        or failure_time - float(state_time) > 120
    ):
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle and failure evidence do not correlate."
        )
    if (
        state.get("state") != "stopping"
        or state.get("reason") != "deliberate"
        or state.get("boot_id") != _current_boot_id()
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the lifecycle boundary is not an exact deliberate stop."
        )
    lifecycle_pid, lifecycle_start = _identity(state, "lifecycle")
    server_pid, server_start = _identity(state, "server")
    if _process_start(lifecycle_pid) == lifecycle_start:
        raise RecoveryBlocked(
            "Recovery blocked: the recorded lifecycle is still active."
        )
    if _process_start(server_pid) == server_start:
        raise RecoveryBlocked("Recovery blocked: the recorded SDK is still active.")
    return failure_time


def _verify_no_lighting_owners() -> None:
    for argv, label in (
        (LIFECYCLE_ARGV, "lifecycle"),
        (SERVER_ARGV, "SDK"),
        (INHIBITOR_ARGV, "sleep inhibitor"),
        (MONITOR_ARGV, "sleep monitor"),
    ):
        if _matching_processes(argv):
            raise RecoveryBlocked(f"Recovery blocked: a lighting {label} is active.")

    for entry in PROC_ROOT.iterdir():
        if not entry.name.isdigit():
            continue
        argv = _process_argv(int(entry.name))
        if len(argv) >= 3 and Path(argv[1]) == RAM_TETRIS and argv[2] == "run":
            raise RecoveryBlocked("Recovery blocked: a RAM Tetris writer is active.")

    listener = subprocess.run(
        [SS, "-H", "-ltnp", "sport = :6742"],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    if listener.returncode != 0:
        raise RecoveryBlocked("Recovery blocked: SDK listener ownership is unreadable.")
    if listener.stdout.strip():
        raise RecoveryBlocked("Recovery blocked: an SDK listener is already active.")

    root = runtime_root()
    for name, label in (
        ("lifecycle.lock", "lifecycle"),
        ("ram-tetris.lock", "RAM Tetris writer"),
        ("ram-tetris-write.lock", "lighting write"),
    ):
        if _lock_is_owned(root / name):
            raise RecoveryBlocked(f"Recovery blocked: the {label} lock is owned.")


def _verify_lifecycle_environment(
    failure_time: float, *, check_kernel_history: bool = True
) -> bytes:
    _unit_is_reviewed()
    _reviewed_openrgb_package_is_installed()

    service = _service_properties(
        SERVICE_NAME,
        (
            "LoadState",
            "ActiveState",
            "SubState",
            "Result",
            "MainPID",
            "ControlPID",
            "FragmentPath",
            "UnitFileState",
            "WantedBy",
            "PartOf",
            "DropInPaths",
            "NeedDaemonReload",
            "Type",
            "Restart",
            "KillMode",
            "TimeoutStartUSec",
            "TimeoutStopUSec",
        ),
    )
    if (
        service["LoadState"] != "loaded"
        or service["ActiveState"] != "failed"
        or service["SubState"] != "failed"
        or service["Result"] != "exit-code"
        or service["MainPID"] != "0"
        or service["ControlPID"] != "0"
        or service["UnitFileState"] != "enabled"
        or GRAPHICAL_TARGET not in service["WantedBy"].split()
        or GRAPHICAL_TARGET not in service["PartOf"].split()
        or service["DropInPaths"]
        or service["NeedDaemonReload"] != "no"
        or service["Type"] != "notify"
        or service["Restart"] != "no"
        or service["KillMode"] != "mixed"
        or service["TimeoutStartUSec"] != "2min"
        or service["TimeoutStopUSec"] != "20s"
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the lighting service boundary is not inactive and reviewed."
        )
    try:
        fragment = Path(service["FragmentPath"]).resolve(strict=True)
        installed = INSTALLED_UNIT.resolve(strict=True)
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: the lighting unit path is unreadable."
        ) from error
    if fragment != installed:
        raise RecoveryBlocked(
            "Recovery blocked: systemd loaded an unexpected lighting unit."
        )

    target = _service_properties(
        GRAPHICAL_TARGET, ("LoadState", "ActiveState", "SubState")
    )
    if target != {
        "LoadState": "loaded",
        "ActiveState": "active",
        "SubState": "active",
    }:
        raise RecoveryBlocked(
            "Recovery blocked: the graphical session is not an active service owner."
        )

    _verify_no_lighting_owners()
    config_raw = _detector_policy_is_reviewed()
    if check_kernel_history:
        _kernel_errors_since(failure_time)
    return config_raw


def _verify_lifecycle_recovery_preflight(
    failure: dict[str, object], message: str
) -> tuple[bytes, bytes]:
    raw, state = _service_state_record()
    failure_time = _validate_lifecycle_boundary(failure, message, state)
    config_raw = _verify_lifecycle_environment(failure_time)
    if (state_root() / "lifecycle-service-state.json").read_bytes() != raw:
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle evidence changed during review."
        )
    if OPENRGB_CONFIG.read_bytes() != config_raw:
        raise RecoveryBlocked(
            "Recovery blocked: OpenRGB configuration changed during review."
        )
    return raw, config_raw


def _service_state_record() -> tuple[bytes, dict[str, object]]:
    path = state_root() / "lifecycle-service-state.json"
    try:
        raw = path.read_bytes()
        value = json.loads(raw)
    except (
        FileNotFoundError,
        OSError,
        UnicodeDecodeError,
        json.JSONDecodeError,
    ) as error:
        raise RecoveryBlocked(
            "The independent lighting lifecycle state is unavailable."
        ) from error
    if not isinstance(value, dict):
        raise RecoveryBlocked("The independent lighting lifecycle state is invalid.")
    return raw, value


def _read_service_state() -> dict[str, object]:
    return _service_state_record()[1]


def _identity(value: dict[str, object], prefix: str) -> tuple[int, str]:
    pid = value.get(f"{prefix}_pid")
    start = value.get(f"{prefix}_start")
    if (
        not isinstance(pid, int)
        or isinstance(pid, bool)
        or pid <= 0
        or not isinstance(start, str)
        or not start
    ):
        raise RecoveryBlocked(f"The recorded {prefix} identity is incomplete.")
    return pid, start


def _current_boot_id() -> str:
    try:
        value = BOOT_ID_PATH.read_text(encoding="utf-8").strip()
    except OSError as error:
        raise RecoveryBlocked("The current boot identity is unreadable.") from error
    if not value:
        raise RecoveryBlocked("The current boot identity is empty.")
    return value


def _current_suspend_count() -> int:
    try:
        value = int(SUSPEND_COUNT_PATH.read_text(encoding="utf-8").strip())
    except (OSError, ValueError) as error:
        raise RecoveryBlocked(
            "Recovery blocked: the suspend boundary is unreadable."
        ) from error
    if value < 0:
        raise RecoveryBlocked("Recovery blocked: the suspend boundary is invalid.")
    return value


def _lock_is_owned(path: Path) -> bool:
    try:
        parent = path.parent.lstat()
    except FileNotFoundError:
        return False
    if (
        not stat.S_ISDIR(parent.st_mode)
        or parent.st_uid != os.getuid()
        or parent.st_mode & 0o077
    ):
        raise RecoveryBlocked(
            f"Recovery blocked: runtime directory is unsafe: {path.parent.name}"
        )
    try:
        descriptor = os.open(path, os.O_WRONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return False
    try:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        return False
    finally:
        os.close(descriptor)


def _service_quick_health() -> bool:
    try:
        value = _read_service_state()
        lifecycle_pid, lifecycle_start = _identity(value, "lifecycle")
        server_pid, server_start = _identity(value, "server")
        return (
            value.get("state") == "ready"
            and value.get("boot_id") == _current_boot_id()
            and _process_start(lifecycle_pid) == lifecycle_start
            and _process_argv(lifecycle_pid) == LIFECYCLE_ARGV
            and _process_start(server_pid) == server_start
            and _process_argv(server_pid) == SERVER_ARGV
        )
    except RecoveryBlocked:
        return False


def _lifecycle_recovery_candidate(failure: dict[str, object], message: str) -> bool:
    try:
        _, state = _service_state_record()
        _validate_lifecycle_boundary(failure, message, state)
    except RecoveryBlocked:
        return False
    return True


def _run_ram_tetris_status() -> dict[str, object]:
    try:
        result = subprocess.run(
            [RAM_TETRIS, "status"],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return {
            "preference": _preference(),
            "state": "failed",
            "message": "Lighting status is unavailable",
        }
    if result.returncode != 0:
        return {
            "preference": _preference(),
            "state": "failed",
            "message": "Lighting status is unavailable",
        }
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError:
        value = {}
    if not isinstance(value, dict):
        value = {}
    value.setdefault("preference", _preference())
    value.setdefault("state", "waiting")
    value.setdefault("message", "Lighting status is unavailable")
    return value


def status_document() -> dict[str, object]:
    normal = _run_ram_tetris_status()
    try:
        raw, record = _failure_record()
    except RecoveryBlocked:
        return normal | {"failure": False}

    message = _failure_message(record)
    failure_class = classify_reason(message)
    _, timestamp = _timestamp(record)
    service_healthy = _service_quick_health()
    lifecycle_candidate = _lifecycle_recovery_candidate(record, message)
    shutdown_race_candidate = False
    if message == SHUTDOWN_RACE_REASON:
        try:
            _classify_shutdown_race_incident()
        except RecoveryBlocked:
            pass
        else:
            shutdown_race_candidate = True
    transient_spd_candidate = False
    if TRANSIENT_SPD_REASON.fullmatch(message):
        try:
            _classify_transient_spd_incident()
        except RecoveryBlocked:
            pass
        else:
            transient_spd_candidate = True
    scope = failure_class.scope
    if scope == "tetris" and not service_healthy:
        scope = "lighting"
    available = (
        (
            failure_class.reviewed_recovery
            and message in ELIGIBLE_REASONS
            and service_healthy
        )
        or lifecycle_candidate
        or shutdown_race_candidate
        or (transient_spd_candidate and service_healthy)
    )
    recovery_status = (
        "available"
        if available
        else ("manual-review" if failure_class is UNKNOWN_FAILURE else "blocked")
    )
    recovery_summary = (
        "Reviewed old-boot shutdown recovery can be checked."
        if shutdown_race_candidate
        else "Reviewed lifecycle recovery can be checked."
        if lifecycle_candidate
        else "Reviewed 60-second SPD recovery can be checked."
        if transient_spd_candidate and service_healthy
        else "Safe Tetris-only recovery can be checked."
        if available
        else "Manual lifecycle recovery is required."
        if scope == "lighting"
        else "This failure requires manual review."
    )
    return {
        "failure": True,
        "preference": normal.get("preference", _preference()),
        "state": "failed",
        "message": message,
        "code": failure_class.code,
        "description": failure_class.description,
        "incident_reference": _incident_reference(raw),
        "first_detected": timestamp,
        "subsystem": failure_class.subsystem,
        "scope": scope,
        "recovery_status": recovery_status,
        "recovery_summary": recovery_summary,
        "recovery_available": available,
    }


def _verify_service_and_hardware(
    failure_time: float | None,
) -> dict[str, object]:
    value = _read_service_state()
    if value.get("state") != "ready":
        raise RecoveryBlocked(
            "Recovery blocked: the independent lifecycle is not ready."
        )
    if value.get("boot_id") != _current_boot_id():
        raise RecoveryBlocked(
            "Recovery blocked: the lifecycle belongs to a stale boot."
        )

    lifecycle_pid, lifecycle_start = _identity(value, "lifecycle")
    server_pid, server_start = _identity(value, "server")
    if (
        _process_start(lifecycle_pid) != lifecycle_start
        or _process_argv(lifecycle_pid) != LIFECYCLE_ARGV
    ):
        raise RecoveryBlocked("Recovery blocked: lifecycle identity is not healthy.")
    if (
        _process_start(server_pid) != server_start
        or _process_argv(server_pid) != SERVER_ARGV
    ):
        raise RecoveryBlocked("Recovery blocked: SDK identity is not healthy.")

    lifecycle_matches = tuple(
        pid
        for pid in _matching_processes(LIFECYCLE_ARGV)
        if pid == lifecycle_pid or not _is_descendant(pid, lifecycle_pid)
    )
    if lifecycle_matches != (lifecycle_pid,):
        raise RecoveryBlocked("Recovery blocked: lifecycle ownership is ambiguous.")
    if _matching_processes(SERVER_ARGV) != (server_pid,):
        raise RecoveryBlocked("Recovery blocked: SDK ownership is ambiguous.")

    service = subprocess.run(
        [
            SYSTEMCTL,
            "--user",
            "is-active",
            "--quiet",
            "omarchy-plus-openrgb-presets.service",
        ],
        check=False,
        capture_output=True,
        timeout=5,
    )
    if service.returncode != 0:
        raise RecoveryBlocked("Recovery blocked: the lighting service is unavailable.")

    root = runtime_root()
    if not _lock_is_owned(root / "lifecycle.lock"):
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle singleton ownership is missing."
        )
    if _lock_is_owned(root / "ram-tetris.lock"):
        raise RecoveryBlocked("Recovery blocked: a RAM Tetris writer owns its lock.")
    if _lock_is_owned(root / "ram-tetris-write.lock"):
        raise RecoveryBlocked("Recovery blocked: a lighting write is active.")

    for entry in PROC_ROOT.iterdir():
        if not entry.name.isdigit():
            continue
        argv = _process_argv(int(entry.name))
        if len(argv) >= 3 and Path(argv[1]) == RAM_TETRIS and argv[2] == "run":
            raise RecoveryBlocked("Recovery blocked: a RAM Tetris writer is active.")

    health = subprocess.run(
        [
            RAM_TETRIS,
            "validate-health",
            "--server-pid",
            str(server_pid),
            "--server-start",
            server_start,
            "--lifecycle-pid",
            str(lifecycle_pid),
            "--lifecycle-start",
            lifecycle_start,
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=20,
    )
    if health.returncode != 0:
        reason = health.stderr.strip() or "existing health validation failed"
        raise RecoveryBlocked(f"Recovery blocked: {reason}")
    try:
        health_value = json.loads(health.stdout)
    except json.JSONDecodeError as error:
        raise RecoveryBlocked(
            "Recovery blocked: health validation was unreadable."
        ) from error
    if health_value.get("controller_count") != 7 or health_value.get("dimm_count") != 4:
        raise RecoveryBlocked(
            "Recovery blocked: accepted controller inventory is incomplete."
        )
    temperatures = health_value.get("temperatures_mc")
    if not isinstance(temperatures, dict) or set(temperatures) != {
        "10-0050",
        "10-0051",
        "10-0052",
        "10-0053",
    }:
        raise RecoveryBlocked(
            "Recovery blocked: four SPD5118 endpoints were not verified."
        )

    if failure_time is not None:
        _kernel_errors_since(failure_time)
    return health_value


def _verify_historical_authorization(
    incident_reference: str, latch_sha256: str, original_reason: str
) -> None:
    if (
        incident_reference != HISTORICAL_CLEARANCE_REFERENCE
        or latch_sha256 != HISTORICAL_CLEARANCE_LATCH_SHA256
        or original_reason != HISTORICAL_CLEARANCE_REASON
    ):
        raise RecoveryBlocked(
            "Historical clearance refused: authorization does not match the "
            "reviewed incident."
        )


def _verify_historical_acknowledgement(
    failure: dict[str, object], boundary: dict[str, object], current: dict[str, object]
) -> float:
    failure_time = _validate_lifecycle_boundary(
        failure, HISTORICAL_CLEARANCE_REASON, boundary
    )
    current_time = current.get("time")
    boundary_time = boundary.get("time")
    if (
        current.get("state") != "ready"
        or current.get("reason") != HISTORICAL_READY_REASON
        or current.get("boot_id") != _current_boot_id()
        or not isinstance(current_time, (int, float))
        or isinstance(current_time, bool)
        or not isinstance(boundary_time, (int, float))
        or isinstance(boundary_time, bool)
        or float(current_time) <= max(failure_time, float(boundary_time))
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the historical boundary has not been replaced by "
            "an authoritative healthy lifecycle."
        )
    old_lifecycle, old_lifecycle_start = _identity(boundary, "lifecycle")
    old_server, old_server_start = _identity(boundary, "server")
    current_lifecycle, current_lifecycle_start = _identity(current, "lifecycle")
    current_server, current_server_start = _identity(current, "server")
    if (old_lifecycle, old_lifecycle_start) == (
        current_lifecycle,
        current_lifecycle_start,
    ) or (old_server, old_server_start) == (current_server, current_server_start):
        raise RecoveryBlocked(
            "Recovery blocked: the lifecycle acknowledgment boundary is ambiguous."
        )
    return failure_time


def _verify_historical_running_environment(
    current: dict[str, object],
    config_evidence: bytes,
    *,
    require_preference_off: bool = True,
) -> None:
    _unit_is_reviewed()
    _reviewed_openrgb_package_is_installed()

    lifecycle_pid, lifecycle_start = _identity(current, "lifecycle")
    server_pid, server_start = _identity(current, "server")
    service = _service_properties(
        SERVICE_NAME,
        (
            "LoadState",
            "ActiveState",
            "SubState",
            "Result",
            "MainPID",
            "ControlPID",
            "ControlGroup",
            "FragmentPath",
            "UnitFileState",
            "WantedBy",
            "PartOf",
            "DropInPaths",
            "NeedDaemonReload",
            "Type",
            "Restart",
            "KillMode",
            "TimeoutStartUSec",
            "TimeoutStopUSec",
        ),
    )
    if (
        service["LoadState"] != "loaded"
        or service["ActiveState"] != "active"
        or service["SubState"] != "running"
        or service["Result"] != "success"
        or service["MainPID"] != str(lifecycle_pid)
        or service["ControlPID"] != "0"
        or not service["ControlGroup"]
        or service["UnitFileState"] != "enabled"
        or GRAPHICAL_TARGET not in service["WantedBy"].split()
        or GRAPHICAL_TARGET not in service["PartOf"].split()
        or service["DropInPaths"]
        or service["NeedDaemonReload"] != "no"
        or service["Type"] != "notify"
        or service["Restart"] != "no"
        or service["KillMode"] != "mixed"
        or service["TimeoutStartUSec"] != "2min"
        or service["TimeoutStopUSec"] != "20s"
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the running lighting service is not the reviewed boundary."
        )
    try:
        fragment = Path(service["FragmentPath"]).resolve(strict=True)
        installed = INSTALLED_UNIT.resolve(strict=True)
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: the lighting unit path is unreadable."
        ) from error
    if fragment != installed:
        raise RecoveryBlocked(
            "Recovery blocked: systemd loaded an unexpected lighting unit."
        )

    target = _service_properties(
        GRAPHICAL_TARGET, ("LoadState", "ActiveState", "SubState")
    )
    if target != {
        "LoadState": "loaded",
        "ActiveState": "active",
        "SubState": "active",
    }:
        raise RecoveryBlocked(
            "Recovery blocked: the graphical session is not an active service owner."
        )

    if (
        _process_start(lifecycle_pid) != lifecycle_start
        or _process_argv(lifecycle_pid) != LIFECYCLE_ARGV
        or _process_start(server_pid) != server_start
        or _process_argv(server_pid) != SERVER_ARGV
        or _matching_processes(LIFECYCLE_ARGV) != (lifecycle_pid,)
        or _matching_processes(SERVER_ARGV) != (server_pid,)
    ):
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle or SDK ownership is ambiguous."
        )

    inhibitor = _matching_processes(INHIBITOR_ARGV)
    monitor = _matching_processes(MONITOR_ARGV)
    if (
        len(inhibitor) != 1
        or len(monitor) != 1
        or not _is_descendant(server_pid, lifecycle_pid)
        or not _is_descendant(inhibitor[0], lifecycle_pid)
        or not _is_descendant(monitor[0], lifecycle_pid)
    ):
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle child ownership is incomplete or ambiguous."
        )

    expected_cgroup = service["ControlGroup"]
    for pid in (lifecycle_pid, server_pid, inhibitor[0], monitor[0]):
        if _process_cgroup(pid) != expected_cgroup:
            raise RecoveryBlocked(
                "Recovery blocked: lighting process cgroup ownership is ambiguous."
            )

    listener = subprocess.run(
        [SS, "-H", "-ltnp", "sport = :6742"],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    listener_lines = [line for line in listener.stdout.splitlines() if line.strip()]
    if (
        listener.returncode != 0
        or len(listener_lines) != 1
        or "127.0.0.1:6742" not in listener_lines[0]
        or f"pid={server_pid}," not in listener_lines[0]
    ):
        raise RecoveryBlocked(
            "Recovery blocked: SDK listener ownership is incomplete or ambiguous."
        )

    root = runtime_root()
    if not _lock_is_owned(root / "lifecycle.lock"):
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle singleton ownership is missing."
        )
    if _lock_is_owned(root / "ram-tetris.lock"):
        raise RecoveryBlocked("Recovery blocked: a RAM Tetris writer owns its lock.")
    if _lock_is_owned(root / "ram-tetris-write.lock"):
        raise RecoveryBlocked("Recovery blocked: a lighting write is active.")
    if require_preference_off and (
        _read_protected_bytes(
            state_root() / "ram-tetris-enabled", "RAM Tetris preference"
        )
        != b"off\n"
    ):
        raise RecoveryBlocked("Recovery blocked: RAM Tetris preference is not OFF.")
    for entry in PROC_ROOT.iterdir():
        if not entry.name.isdigit():
            continue
        argv = _process_argv(int(entry.name))
        if len(argv) >= 3 and Path(argv[1]) == RAM_TETRIS and argv[2] == "run":
            raise RecoveryBlocked("Recovery blocked: a RAM Tetris writer is active.")

    config_raw = _detector_policy_is_reviewed()
    if config_raw != config_evidence:
        raise RecoveryBlocked(
            "Recovery blocked: OpenRGB configuration changed from protected evidence."
        )


def _historical_clearance_preflight(
    incident_reference: str, latch_sha256: str, original_reason: str
) -> HistoricalClearanceBinding:
    _verify_historical_authorization(incident_reference, latch_sha256, original_reason)
    failure_path = state_root() / "ram-tetris-failure.json"
    failure_raw = _read_protected_bytes(failure_path, "historical failure latch")
    if (
        hashlib.sha256(failure_raw).hexdigest() != HISTORICAL_CLEARANCE_LATCH_SHA256
        or _incident_reference(failure_raw) != HISTORICAL_CLEARANCE_REFERENCE
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the historical failure latch bytes changed."
        )
    failure = _json_record(failure_raw, "historical failure latch")
    if _failure_message(failure) != HISTORICAL_CLEARANCE_REASON:
        raise RecoveryBlocked(
            "Recovery blocked: the historical failure reason changed."
        )

    evidence_root = state_root() / "recovery-evidence"
    failure_evidence = _read_protected_bytes(
        evidence_root / f"{HISTORICAL_CLEARANCE_REFERENCE}.failure.json",
        "original failure evidence",
    )
    boundary_raw = _read_protected_bytes(
        evidence_root / f"{HISTORICAL_CLEARANCE_REFERENCE}.lifecycle-state.json",
        "original lifecycle-boundary evidence",
    )
    config_raw = _read_protected_bytes(
        evidence_root / f"{HISTORICAL_CLEARANCE_REFERENCE}.openrgb-config.json",
        "original OpenRGB configuration evidence",
    )
    if failure_evidence != failure_raw:
        raise RecoveryBlocked(
            "Recovery blocked: original failure evidence does not match the latch."
        )
    if hashlib.sha256(boundary_raw).hexdigest() != HISTORICAL_CLEARANCE_BOUNDARY_SHA256:
        raise RecoveryBlocked(
            "Recovery blocked: original lifecycle-boundary evidence changed."
        )
    if hashlib.sha256(config_raw).hexdigest() != HISTORICAL_CLEARANCE_CONFIG_SHA256:
        raise RecoveryBlocked(
            "Recovery blocked: original OpenRGB configuration evidence changed."
        )

    current_state_path = state_root() / "lifecycle-service-state.json"
    current_state_raw = _read_protected_bytes(
        current_state_path, "current lifecycle state"
    )
    boundary = _json_record(boundary_raw, "original lifecycle-boundary evidence")
    current = _json_record(current_state_raw, "current lifecycle state")
    failure_time = _verify_historical_acknowledgement(failure, boundary, current)
    _verify_historical_running_environment(current, config_raw)
    _verify_service_and_hardware(failure_time)
    return HistoricalClearanceBinding(
        failure_raw=failure_raw,
        boundary_raw=boundary_raw,
        config_raw=config_raw,
        current_state_raw=current_state_raw,
    )


def _software_interruption_journal_slice(
    *,
    kernel: bool,
    since: float,
    until: float | None,
    label: str,
) -> str:
    command = [JOURNALCTL]
    if kernel:
        command.append("-k")
    else:
        command.extend(("--user", "--unit", SERVICE_NAME))
    command.extend((f"--since=@{since}", "--output=short-unix", "--no-pager"))
    if until is not None:
        command.insert(-2, f"--until=@{until}")
    result = subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if result.returncode != 0 or result.stderr.strip():
        raise RecoveryBlocked(f"Recovery blocked: {label} journal is unreadable.")
    return result.stdout


def _software_interruption_journal_evidence(
    failure_time: float,
    readiness_time: float,
) -> bytes:
    """Retain history, while requiring a clean authoritative-ready boundary."""

    if readiness_time <= failure_time:
        raise RecoveryBlocked(
            "Recovery blocked: lifecycle readiness does not follow the incident."
        )
    historical_kernel = _software_interruption_journal_slice(
        kernel=True,
        since=failure_time,
        until=readiness_time,
        label="historical kernel",
    )
    historical_service = _software_interruption_journal_slice(
        kernel=False,
        since=failure_time,
        until=readiness_time,
        label="historical service",
    )
    current_kernel = _software_interruption_journal_slice(
        kernel=True,
        since=readiness_time,
        until=None,
        label="post-readiness kernel",
    )
    current_service = _software_interruption_journal_slice(
        kernel=False,
        since=readiness_time,
        until=None,
        label="post-readiness service",
    )
    if any(
        RELEVANT_KERNEL_ERROR.search(line) or SUSPEND_RESUME_EVENT.search(line)
        for line in current_kernel.splitlines()
    ):
        raise RecoveryBlocked(
            "Recovery blocked: kernel communication or suspend evidence exists "
            "after authoritative lifecycle readiness."
        )
    if any(
        POST_READY_SERVICE_FAILURE.search(line) for line in current_service.splitlines()
    ):
        raise RecoveryBlocked(
            "Recovery blocked: a service failure or transition exists after "
            "authoritative lifecycle readiness."
        )
    document = {
        "schema_version": 1,
        "category": "corrected-software-interruption",
        "failure_time": failure_time,
        "readiness_time": readiness_time,
        "historical_kernel": historical_kernel,
        "historical_service": historical_service,
        "post_readiness_kernel": current_kernel,
        "post_readiness_service": current_service,
    }
    return (json.dumps(document, sort_keys=True) + "\n").encode()


def _shutdown_race_journal_slice(*, kernel: bool) -> str:
