#!/usr/bin/bash

set -o errexit
set -o nounset
set -o pipefail

readonly OPENRGB_BIN="/usr/bin/openrgb"
readonly GDBUS_BIN="/usr/bin/gdbus"
readonly INHIBIT_BIN="/usr/bin/systemd-inhibit"
readonly SETPRIV_BIN="/usr/bin/setpriv"
readonly SETSID_BIN="/usr/bin/setsid"
readonly SS_BIN="/usr/bin/ss"
readonly TIMEOUT_BIN="/usr/bin/timeout"
readonly SCRIPT_DIR="$(/usr/bin/readlink -f "$(/usr/bin/dirname "${BASH_SOURCE[0]}")")"
readonly APPLY_PRESET="${SCRIPT_DIR}/apply-preset"
readonly USER_ID="$(/usr/bin/id -u)"
readonly RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/${USER_ID}}/omarchy-plus/openrgb-presets-static"
readonly LIFECYCLE_LOCK="${RUNTIME_DIR}/lifecycle.flock"
readonly SERVER_LOG="${RUNTIME_DIR}/openrgb-server.log"
readonly RESTORE_TIMEOUT="75s"
readonly RESUME_DELAY="3"
readonly -a SERVER_ARGS=(
  --noautoconnect
  --startminimized
  --server
  --server-host 127.0.0.1
  --server-port 6742
)

server_pid=''
server_start=''
monitor_pid=''
monitor_start=''
monitor_fd=''
inhibitor_pid=''
inhibitor_start=''
lifecycle_fd=''
suspended=false
cleaning=false

log() {
  /usr/bin/printf '%s\n' "$*"
}

process_start() {
  local pid="${1:-}"
  [[ "${pid}" =~ ^[1-9][0-9]*$ && -r "/proc/${pid}/stat" ]] || return 1
  /usr/bin/awk '{print $22}' "/proc/${pid}/stat"
}

same_process() {
  local pid="${1:-}"
  local expected="${2:-}"
  local actual=''
  [[ -n "${expected}" ]] || return 1
  actual="$(process_start "${pid}" 2>/dev/null || true)"
  [[ -n "${actual}" && "${actual}" == "${expected}" ]]
}

process_command() {
  local pid="${1:-}"
  [[ -r "/proc/${pid}/cmdline" ]] || return 1
  /usr/bin/tr '\0' ' ' <"/proc/${pid}/cmdline" | /usr/bin/sed 's/ $//'
}

process_uid() {
  local pid="${1:-}"
  [[ -r "/proc/${pid}/status" ]] || return 1
  /usr/bin/awk '$1 == "Uid:" {print $2}' "/proc/${pid}/status"
}

process_group() {
  /usr/bin/ps -p "${1:-}" -o pgid= 2>/dev/null | /usr/bin/awk '{$1=$1; print}'
}

expected_server_command() {
  /usr/bin/printf '%s' "${OPENRGB_BIN} ${SERVER_ARGS[*]}"
}

listener_owner_pid() {
  local listener=''
  local pid=''
  listener="$("${SS_BIN}" -H -ltnp 'sport = :6742' 2>/dev/null \
    | /usr/bin/awk '$4 == "127.0.0.1:6742" && index($0, "users:((\"openrgb\",pid=") {print}')"
  [[ -n "${listener}" && "${listener}" != *$'\n'* ]] || return 1
  pid="$(/usr/bin/printf '%s\n' "${listener}" \
    | /usr/bin/sed -nE 's/.*pid=([0-9]+).*/\1/p')"
  [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  /usr/bin/printf '%s' "${pid}"
}

is_server_process() {
  local pid="${1:-}"
  local start="${2:-}"
  same_process "${pid}" "${start}" \
    && [[ "$(process_command "${pid}" 2>/dev/null || true)" == "$(expected_server_command)" ]] \
    && [[ "$(/usr/bin/readlink -f "/proc/${pid}/exe" 2>/dev/null || true)" == "${OPENRGB_BIN}" ]] \
    && [[ "$(process_uid "${pid}" 2>/dev/null || true)" == "${USER_ID}" ]]
}

expected_inhibitor_command() {
  /usr/bin/printf '%s' \
    "${INHIBIT_BIN} --what=sleep --who=OpenRGB Presets Static --why=Stop the owned OpenRGB SDK before sleep --mode=delay ${SETPRIV_BIN} --pdeathsig TERM /usr/bin/sleep infinity"
}

is_inhibitor() {
  same_process "${inhibitor_pid}" "${inhibitor_start}" \
    && [[ "$(process_command "${inhibitor_pid}" 2>/dev/null || true)" == "$(expected_inhibitor_command)" ]] \
    && [[ "$(process_uid "${inhibitor_pid}" 2>/dev/null || true)" == "${USER_ID}" ]] \
    && [[ "$(process_group "${inhibitor_pid}" 2>/dev/null || true)" == "${inhibitor_pid}" ]]
}

expected_monitor_command() {
  /usr/bin/printf '%s' \
    "${GDBUS_BIN} monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1"
}

is_monitor() {
  same_process "${monitor_pid}" "${monitor_start}" \
    && [[ "$(process_command "${monitor_pid}" 2>/dev/null || true)" == "$(expected_monitor_command)" ]] \
    && [[ "$(process_uid "${monitor_pid}" 2>/dev/null || true)" == "${USER_ID}" ]]
}

is_server_ready() {
  is_server_process "${server_pid}" "${server_start}" \
    && [[ "$(listener_owner_pid 2>/dev/null || true)" == "${server_pid}" ]]
}

acquire_lifecycle() {
  /usr/bin/mkdir -p "${RUNTIME_DIR}"
  exec {lifecycle_fd}>"${LIFECYCLE_LOCK}"
  /usr/bin/flock --nonblock "${lifecycle_fd}"
}

close_lifecycle_for_child() {
  if [[ "${lifecycle_fd}" =~ ^[0-9]+$ ]]; then
    eval "exec ${lifecycle_fd}>&-"
  fi
}

launch_server() {
  local attempt
  if [[ -n "$(listener_owner_pid 2>/dev/null || true)" ]]; then
    /usr/bin/printf '%s\n' 'Port 6742 already has an owner; refusing to launch another SDK.' >&2
    return 1
  fi
  (
    close_lifecycle_for_child
    exec "${OPENRGB_BIN}" "${SERVER_ARGS[@]}" >>"${SERVER_LOG}" 2>&1
  ) &
  server_pid=$!
  for attempt in {1..20}; do
    server_start="$(process_start "${server_pid}" 2>/dev/null || true)"
    [[ -n "${server_start}" ]] && break
    /usr/bin/sleep 0.05
  done
  [[ -n "${server_start}" ]] || return 1
  for attempt in {1..50}; do
    if is_server_ready; then
      log "OpenRGB SDK ready as PID ${server_pid}"
      return 0
    fi
    is_server_process "${server_pid}" "${server_start}" || return 1
    /usr/bin/sleep 0.1
  done
  /usr/bin/printf '%s\n' 'OpenRGB SDK did not acquire its authenticated loopback listener.' >&2
  return 1
}

stop_server() {
  local attempt
  if [[ -z "${server_pid}" ]]; then
    return 0
  fi
  if ! same_process "${server_pid}" "${server_start}"; then
    server_pid=''
    server_start=''
    return 0
  fi
  if ! is_server_process "${server_pid}" "${server_start}"; then
    /usr/bin/printf '%s\n' 'Tracked SDK identity changed; refusing to signal it.' >&2
    return 1
  fi
  kill -TERM "${server_pid}"
  for attempt in {1..20}; do
    if ! same_process "${server_pid}" "${server_start}"; then
      wait "${server_pid}" 2>/dev/null || true
      server_pid=''
      server_start=''
      log 'OpenRGB SDK stopped'
      return 0
    fi
    /usr/bin/sleep 0.1
  done
  is_server_process "${server_pid}" "${server_start}" || {
    /usr/bin/printf '%s\n' 'SDK identity changed before escalation; refusing SIGKILL.' >&2
    return 1
  }
  kill -KILL "${server_pid}"
  wait "${server_pid}" 2>/dev/null || true
  server_pid=''
  server_start=''
  log 'OpenRGB SDK required bounded SIGKILL'
}

restore_preset() {
  local mode="${1:-full}"
  local argument='--restore'
  if [[ "${mode}" == 'non-ram' ]]; then
    argument='--restore-non-ram'
  fi
  "${TIMEOUT_BIN}" --signal=TERM --kill-after=2s "${RESTORE_TIMEOUT}" \
    "${APPLY_PRESET}" "${argument}"
}

start_inhibitor() {
  local attempt
  (
    close_lifecycle_for_child
    exec "${SETPRIV_BIN}" --pdeathsig TERM "${SETSID_BIN}" "${INHIBIT_BIN}" \
      --what=sleep \
      --who='OpenRGB Presets Static' \
      --why='Stop the owned OpenRGB SDK before sleep' \
      --mode=delay \
      "${SETPRIV_BIN}" --pdeathsig TERM /usr/bin/sleep infinity
  ) &
  inhibitor_pid=$!
  inhibitor_start="$(process_start "${inhibitor_pid}")"
  for attempt in {1..20}; do
    is_inhibitor && return 0
    same_process "${inhibitor_pid}" "${inhibitor_start}" || break
    /usr/bin/sleep 0.05
  done
  /usr/bin/printf '%s\n' 'Sleep inhibitor failed exact identity validation.' >&2
  return 1
}

release_inhibitor() {
  if is_inhibitor; then
    kill -TERM -- "-${inhibitor_pid}" 2>/dev/null || true
    wait "${inhibitor_pid}" 2>/dev/null || true
  elif same_process "${inhibitor_pid}" "${inhibitor_start}"; then
    /usr/bin/printf '%s\n' 'Inhibitor identity changed; refusing to signal it.' >&2
  fi
  inhibitor_pid=''
  inhibitor_start=''
}

start_monitor() {
  local attempt
  coproc SLEEP_MONITOR {
    close_lifecycle_for_child
    exec "${SETPRIV_BIN}" --pdeathsig TERM /usr/bin/stdbuf -oL \
      "${GDBUS_BIN}" monitor --system \
      --dest org.freedesktop.login1 \
      --object-path /org/freedesktop/login1
  }
  monitor_pid="${SLEEP_MONITOR_PID}"
  monitor_start="$(process_start "${monitor_pid}")"
  monitor_fd="${SLEEP_MONITOR[0]}"
  for attempt in {1..20}; do
    is_monitor && return 0
    same_process "${monitor_pid}" "${monitor_start}" || break
    /usr/bin/sleep 0.05
  done
  /usr/bin/printf '%s\n' 'logind monitor failed exact identity validation.' >&2
  return 1
}

stop_monitor() {
  if is_monitor; then
    kill -TERM "${monitor_pid}" 2>/dev/null || true
    wait "${monitor_pid}" 2>/dev/null || true
  elif same_process "${monitor_pid}" "${monitor_start}"; then
    /usr/bin/printf '%s\n' 'Monitor identity changed; refusing to signal it.' >&2
  fi
  monitor_pid=''
  monitor_start=''
  monitor_fd=''
}

prepare_sleep() {
  [[ "${suspended}" == false ]] || return 0
  suspended=true
  stop_server
  release_inhibitor
}

resume_from_sleep() {
  [[ "${suspended}" == true ]] || return 0
  suspended=false
  start_inhibitor
  /usr/bin/sleep "${RESUME_DELAY}"
  launch_server
  restore_preset non-ram
}

cleanup() {
  local result=0
  [[ "${cleaning}" == false ]] || return 0
  cleaning=true
  stop_server || result=1
  release_inhibitor
  stop_monitor
  return "${result}"
}

request_shutdown() {
  cleanup
  exit $?
}

check_dependencies() {
  local dependency
  for dependency in \
    "${OPENRGB_BIN}" "${GDBUS_BIN}" "${INHIBIT_BIN}" "${SETPRIV_BIN}" \
    "${SETSID_BIN}" "${SS_BIN}" "${TIMEOUT_BIN}" "${APPLY_PRESET}"; do
    [[ -x "${dependency}" ]] || {
      /usr/bin/printf 'Missing executable: %s\n' "${dependency}" >&2
      return 69
    }
  done
}

main() {
  local line=''
  umask 077
  if [[ "${1:-}" == '--check' && "${#}" -eq 1 ]]; then
    check_dependencies
    return 0
  fi
  [[ "${#}" -eq 0 ]] || {
    /usr/bin/printf '%s\n' 'Usage: openrgb-lifecycle [--check]' >&2
    return 64
  }
  check_dependencies
  acquire_lifecycle || {
    /usr/bin/printf '%s\n' 'Another static OpenRGB lifecycle owns the lock.' >&2
    return 75
  }
  trap cleanup EXIT
  trap request_shutdown INT TERM HUP
  start_inhibitor
  launch_server
  restore_preset
  start_monitor
  while true; do
    line=''
    if IFS= read -r -t 1 line <&"${monitor_fd}"; then
      case "${line}" in
        *'org.freedesktop.login1.Manager.PrepareForSleep (true,)'*) prepare_sleep ;;
        *'org.freedesktop.login1.Manager.PrepareForSleep (false,)'*) resume_from_sleep ;;
      esac
    elif ! is_monitor; then
      /usr/bin/printf '%s\n' 'logind sleep monitor exited.' >&2
      return 1
    fi
    if [[ "${suspended}" == false ]] && ! is_server_process "${server_pid}" "${server_start}"; then
      /usr/bin/printf '%s\n' 'Owned OpenRGB SDK exited; refusing automatic restart.' >&2
      return 1
    fi
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
