@contextmanager
def _bounded_operation(seconds: float, operation: str):
    """Bound a main-thread hardware operation without creating another worker."""

    if seconds <= 0:
        raise ValueError("operation deadline must be positive")
    if threading.current_thread() is not threading.main_thread():
        raise SafetyStop(f"{operation} cannot establish its deadline")
    previous_timer = signal.getitimer(signal.ITIMER_REAL)
    if previous_timer[0] > 0 or previous_timer[1] > 0:
        raise SafetyStop(f"{operation} found an active process deadline")
    previous_handler = signal.getsignal(signal.SIGALRM)

    def deadline_expired(_signum: int, _frame: object) -> None:
        raise SafetyStop(
            f"{operation} exceeded its {seconds:.3f} second deadline",
            evidence={
                "failure_kind": "operation-timeout",
                "operation": operation,
                "deadline_ms": round(seconds * 1000),
            },
        )

    signal.signal(signal.SIGALRM, deadline_expired)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)


def _state_root() -> Path:
    base = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    return base / "omarchy-plus/openrgb-presets"


def _runtime_root() -> Path:
    value = os.environ.get("OPENRGB_RUNTIME_DIR") or os.environ.get("XDG_RUNTIME_DIR")
    if not value:
        value = f"/run/user/{os.getuid()}"
    return Path(value) / (
        "" if os.environ.get("OPENRGB_RUNTIME_DIR") else "omarchy-plus/openrgb-presets"
    )


def _private_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    metadata = path.lstat()
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.getuid():
        raise SafetyStop(f"unsafe runtime directory: {path}")
    path.chmod(0o700)


def _atomic_text(path: Path, value: str) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(value)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, path)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _atomic_text_if_absent(path: Path, value: str) -> bool:
    """Publish private state atomically without replacing retained evidence."""

    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            output.write(value)
            output.flush()
            os.fsync(output.fileno())
        try:
            os.link(temporary, path)
        except FileExistsError:
            return False
        return True
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass


def _write_json(path: Path, value: object) -> None:
    _atomic_text(path, json.dumps(value, sort_keys=True) + "\n")


def _write_json_if_absent(path: Path, value: object) -> bool:
    return _atomic_text_if_absent(path, json.dumps(value, sort_keys=True) + "\n")


def _source_provenance() -> dict[str, str]:
    """Return bounded source identity for future recovery classification."""

    try:
        revision = subprocess.run(
            [
                "/usr/bin/git",
                "-C",
                str(Path(__file__).resolve().parent),
                "rev-parse",
                "HEAD",
            ],
            check=False,
            capture_output=True,
            text=True,
            timeout=2,
        )
        value = revision.stdout.strip()
        if revision.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", value):
            value = "unavailable"
    except (OSError, subprocess.TimeoutExpired):
        value = "unavailable"
    try:
        source_sha256 = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
    except OSError:
        source_sha256 = "unavailable"
    return {
        "component": "ram-tetris",
        "version": SOURCE_VERSION,
        "revision": value,
        "path": SOURCE_PATH,
        "sha256": source_sha256,
    }


