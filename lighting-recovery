    )
    journal_record = document.get("journal_record")
    try:
        retained_record = (
            json.loads(journal_record) if isinstance(journal_record, str) else None
        )
    except json.JSONDecodeError:
        retained_record = None
    expected_boot = SHUTDOWN_RACE_RECOVERY_BOOT_ID.replace("-", "").lower()
    if (
        set(document)
        != {
            "schema_version",
            "category",
            "boot_id",
            "controller_contract",
            "detector_policy",
            "detector_policy_sha256",
            "journal_cursor",
            "journal_record",
            "message",
        }
        or document.get("schema_version") != 1
        or document.get("category") != "reviewed-unrelated-ite8853-registration"
        or document.get("boot_id") != SHUTDOWN_RACE_RECOVERY_BOOT_ID
        or document.get("controller_contract")
        != list(SHUTDOWN_RACE_CONTROLLER_CONTRACT)
        or document.get("detector_policy") != policy
        or document.get("detector_policy_sha256")
        != hashlib.sha256(config_raw).hexdigest()
        or document.get("journal_cursor") != qualification.journal_cursor
        or document.get("message") != SHUTDOWN_RACE_REVIEWED_KERNEL_MESSAGE
        or not isinstance(retained_record, dict)
        or retained_record.get("MESSAGE") != SHUTDOWN_RACE_REVIEWED_KERNEL_MESSAGE
        or not isinstance(retained_record.get("_BOOT_ID"), str)
        or retained_record["_BOOT_ID"].lower() != expected_boot
    ):
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race kernel qualification changed."
        )
    relevant = _shutdown_race_relevant_kernel_records()
    if tuple(message for message, _ in relevant) != (
        SHUTDOWN_RACE_REVIEWED_KERNEL_MESSAGE,
    ):
        raise RecoveryBlocked(
            "Recovery blocked: current-boot kernel evidence changed after qualification."
        )
    _kernel_history_after_observation(qualification.journal_cursor)


def _shutdown_race_recovery_preflight(
    *,
