def _truncate(value: str, limit: int) -> str:
    normalized = " ".join(value.split())
    if len(normalized) <= limit:
        return normalized
    return normalized[: limit - 1].rstrip() + "…"


def _sanitized_reason(value: str) -> str:
    value = PRIVATE_HOME_PATH.sub("[private-path]", value)
    return SENSITIVE_VALUE.sub(lambda match: f"{match.group(1)}=[redacted]", value)


def diagnostics_text() -> str:
    value = status_document()
    if not value.get("failure"):
        return "OpenRGB Lighting Recovery\nStatus: no preserved failure\n"
    return "\n".join(
        (
            "OpenRGB Lighting Recovery",
            f"Error code: {value['code']}",
            f"Incident: {value['incident_reference']}",
            f"First detected: {value['first_detected']}",
            f"Affected subsystem: {value['subsystem']}",
            f"Recovery: {value['recovery_status']}",
            f"Description: {value['description']}",
            "Backend reason: "
            + _truncate(_sanitized_reason(str(value["message"])), MAX_COPY_REASON),
            "",
        )
    )


def copy_diagnostics(print_only: bool) -> int:
    text = diagnostics_text()
    if print_only:
        print(text, end="")
        return 0
    result = subprocess.run(
        [WL_COPY, "--type", "text/plain;charset=utf-8"],
        input=text,
        text=True,
        check=False,
        timeout=5,
    )
    if result.returncode != 0:
        raise RecoveryBlocked("Diagnostics could not be copied.")
    print(json.dumps({"state": "copied", "message": "Diagnostics copied."}))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_subparsers(dest="action", required=True)
    actions.add_parser("status")
    actions.add_parser("prepare")
    recover_parser = actions.add_parser("recover")
    recover_parser.add_argument("--confirm", required=True)
    historical = actions.add_parser("clear-resolved-lifecycle")
    historical.add_argument("--incident-reference", required=True)
    historical.add_argument("--latch-sha256", required=True)
    historical.add_argument("--original-reason", required=True)
    historical.add_argument(
        "--acknowledge-historical-clearance", action="store_true", required=True
    )
    software_race = actions.add_parser("clear-reviewed-software-race")
    software_race.add_argument("--incident-reference", required=True)
    software_race.add_argument("--latch-sha256", required=True)
    software_race.add_argument("--error-code", required=True)
    software_race.add_argument("--original-reason", required=True)
    software_race.add_argument(
        "--acknowledge-reviewed-software-race", action="store_true", required=True
    )
    software_interruption = actions.add_parser("clear-reviewed-software-interruption")
    software_interruption.add_argument("--incident-reference", required=True)
    software_interruption.add_argument("--latch-sha256", required=True)
    software_interruption.add_argument("--error-code", required=True)
    software_interruption.add_argument("--original-reason", required=True)
    software_interruption.add_argument(
        "--acknowledge-reviewed-software-interruption",
        action="store_true",
        required=True,
    )
    hardware_health = actions.add_parser("clear-reviewed-hardware-health")
    hardware_health.add_argument("--incident-reference", required=True)
    hardware_health.add_argument("--latch-sha256", required=True)
    hardware_health.add_argument("--error-code", required=True)
    hardware_health.add_argument("--original-reason", required=True)
    hardware_health.add_argument("--stability-manifest-sha256", required=True)
    hardware_health.add_argument(
        "--acknowledge-reviewed-hardware-health", action="store_true", required=True
    )
    observe_spd = actions.add_parser("observe-transient-spd")
    observe_spd.add_argument(
        "--acknowledge-read-only-observation", action="store_true", required=True
    )
    transient_spd = actions.add_parser("clear-reviewed-transient-spd")
    transient_spd.add_argument("--observation-directory", required=True)
    transient_spd.add_argument("--stability-manifest-sha256", required=True)
    transient_spd.add_argument(
        "--acknowledge-reviewed-transient-spd",
        action="store_true",
        required=True,
    )
    copy_parser = actions.add_parser("copy-diagnostics")
    copy_parser.add_argument("--print", action="store_true")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        if args.action == "status":
            print(json.dumps(status_document(), sort_keys=True))
            return 0
        if args.action == "prepare":
            print(json.dumps(prepare_document(), sort_keys=True))
            return 0
        if args.action == "recover":
            print(json.dumps(recover(args.confirm), sort_keys=True))
            return 0
        if args.action == "clear-resolved-lifecycle":
            print(
                json.dumps(
                    clear_resolved_lifecycle(
                        args.incident_reference,
                        args.latch_sha256,
                        args.original_reason,
                    ),
                    sort_keys=True,
                )
            )
            return 0
        if args.action == "clear-reviewed-software-race":
            print(
                json.dumps(
                    clear_reviewed_software_race(
                        args.incident_reference,
                        args.latch_sha256,
                        args.error_code,
                        args.original_reason,
                    ),
                    sort_keys=True,
                )
            )
            return 0
        if args.action == "clear-reviewed-software-interruption":
            print(
                json.dumps(
                    clear_reviewed_software_interruption(
                        args.incident_reference,
                        args.latch_sha256,
                        args.error_code,
                        args.original_reason,
                    ),
                    sort_keys=True,
                )
            )
            return 0
        if args.action == "clear-reviewed-hardware-health":
            print(
                json.dumps(
                    clear_reviewed_hardware_health(
                        args.incident_reference,
                        args.latch_sha256,
                        args.error_code,
                        args.original_reason,
                        args.stability_manifest_sha256,
                    ),
                    sort_keys=True,
                )
            )
            return 0
        if args.action == "observe-transient-spd":
            print(json.dumps(observe_transient_spd(), sort_keys=True))
            return 0
        if args.action == "clear-reviewed-transient-spd":
            print(
                json.dumps(
                    clear_reviewed_transient_spd(
                        args.observation_directory,
                        args.stability_manifest_sha256,
                    ),
                    sort_keys=True,
                )
            )
            return 0
        return copy_diagnostics(args.print)
    except (RecoveryBlocked, OSError, subprocess.TimeoutExpired) as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
