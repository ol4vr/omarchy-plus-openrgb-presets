class SafetyStop(RuntimeError):
    """A mandatory health gate failed; no further hardware write is allowed."""

    def __init__(
        self, message: str, *, evidence: Mapping[str, object] | None = None
    ) -> None:
        super().__init__(message)
        self.evidence = dict(evidence or {})


class HardwareWriteFailure(SafetyStop):
    """The SDK write itself failed, so restoration is forbidden."""


