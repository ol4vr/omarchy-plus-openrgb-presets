def _wait_for_authoritative_lifecycle_ready(deadline: float) -> None:
    """Wait for the lifecycle's own state record after systemd accepts READY."""
    while True:
        state = _read_service_state().get("state")
        if state == "ready":
            return
        if state in {"failed", "clean-stopped"}:
            raise RecoveryBlocked(
                "Recovery blocked: the single service start did not reach "
                "authoritative lifecycle readiness; manual review is required."
            )
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RecoveryBlocked(
                "Recovery blocked: the single service start did not reach "
                "authoritative lifecycle readiness; manual review is required."
            )
        time.sleep(min(LIFECYCLE_READY_POLL_SECONDS, remaining))


def prepare_document() -> dict[str, object]:
    raw, record = _failure_record()
    message = _failure_message(record)
    failure_class = classify_reason(message)
    failure_time, _ = _timestamp(record)
    if message == SHUTDOWN_RACE_REASON:
        binding = _shutdown_race_recovery_preflight(require_preference_off=False)
        return {
            "state": "confirmation-required",
            "confirmation_token": _shutdown_race_confirmation_token(binding),
            "incident_reference": binding.incident.incident_reference,
            "recovery_kind": "old-boot-shutdown-race",
            "message": (
                "Confirm one reviewed lifecycle start. RAM Tetris will remain OFF."
            ),
        }
    if message in LIFECYCLE_RECOVERY_REASONS:
        lifecycle_raw, config_raw = _verify_lifecycle_recovery_preflight(
            record, message
        )
        return {
            "state": "confirmation-required",
            "confirmation_token": _lifecycle_confirmation_token(
                raw, lifecycle_raw, config_raw
            ),
            "incident_reference": _incident_reference(raw),
            "message": (
                "Confirm one reviewed lifecycle start. RAM Tetris will remain OFF."
            ),
        }
    if TRANSIENT_SPD_REASON.fullmatch(message):
        incident = _classify_transient_spd_incident()
        _transient_spd_environment_preflight(incident, require_preference_off=False)
        return {
            "state": "confirmation-required",
            "confirmation_token": _transient_spd_confirmation_token(raw),
            "incident_reference": incident.incident_reference,
            "recovery_kind": "transient-spd",
            "message": (
                "Confirm one 60-second SPD observation and reviewed clearance. "
                "RAM Tetris will remain OFF."
            ),
        }
    if not failure_class.reviewed_recovery or message not in ELIGIBLE_REASONS:
        raise RecoveryBlocked(
            "Recovery blocked: this incident has no reviewed automatic recovery procedure."
        )
    if failure_time is None:
        raise RecoveryBlocked("Recovery blocked: the incident timestamp is invalid.")
    _verify_service_and_hardware(failure_time)
    return {
        "state": "confirmation-required",
        "confirmation_token": hashlib.sha256(raw).hexdigest(),
        "incident_reference": _incident_reference(raw),
        "message": "Confirm recovery. RAM Tetris will remain OFF.",
    }


