#!/usr/bin/bash

set -o errexit
set -o nounset
set -o pipefail

readonly OPENRGB_BIN="${OPENRGB_BIN:-/usr/bin/openrgb}"
readonly GDBUS_BIN="${GDBUS_BIN:-/usr/bin/gdbus}"
readonly STDBUF_BIN="${STDBUF_BIN:-/usr/bin/stdbuf}"
readonly INHIBIT_BIN="${INHIBIT_BIN:-/usr/bin/systemd-inhibit}"
readonly INHIBIT_PROCESS_PREFIX="${INHIBIT_PROCESS_PREFIX:-${INHIBIT_BIN}}"
readonly SETSID_BIN="${SETSID_BIN:-/usr/bin/setsid}"
readonly SETPRIV_BIN="${SETPRIV_BIN:-/usr/bin/setpriv}"
readonly SS_BIN="${SS_BIN:-/usr/bin/ss}"
readonly PS_BIN="${PS_BIN:-/usr/bin/ps}"
readonly TIMEOUT_BIN="${TIMEOUT_BIN:-/usr/bin/timeout}"
readonly SLEEP_BIN="${SLEEP_BIN:-/usr/bin/sleep}"
readonly CAT_BIN="${CAT_BIN:-/usr/bin/cat}"
readonly FLOCK_BIN="${FLOCK_BIN:-/usr/bin/flock}"
readonly MKDIR_BIN="${MKDIR_BIN:-/usr/bin/mkdir}"
readonly MV_BIN="${MV_BIN:-/usr/bin/mv}"
readonly TR_BIN="${TR_BIN:-/usr/bin/tr}"
readonly SYSTEMD_NOTIFY_BIN="${SYSTEMD_NOTIFY_BIN:-/usr/bin/systemd-notify}"
readonly PROC_ROOT="${PROC_ROOT:-/proc}"
readonly SCRIPT_PATH="$(/usr/bin/readlink -f "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR="$(/usr/bin/dirname "${SCRIPT_PATH}")"
readonly APPLY_PRESET="${APPLY_PRESET:-${SCRIPT_DIR}/apply-preset}"
readonly RAM_TETRIS="${RAM_TETRIS:-${SCRIPT_DIR}/ram-tetris}"
readonly SERVICE_GUARD="${OPENRGB_SERVICE_GUARD:-${SCRIPT_DIR}/openrgb-service-guard}"
readonly USER_ID="${OPENRGB_USER_ID:-$(/usr/bin/id -u)}"
readonly RUNTIME_DIR="${OPENRGB_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/${USER_ID}}/omarchy-plus/openrgb-presets}"
readonly LIFECYCLE_LOCK_FILE="${RUNTIME_DIR}/lifecycle.lock"
readonly SERVER_LOG_FILE="${OPENRGB_SERVER_LOG:-${RUNTIME_DIR}/openrgb-server.log}"
readonly TETRIS_LOG_FILE="${OPENRGB_TETRIS_LOG:-${RUNTIME_DIR}/ram-tetris.log}"
readonly STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}/omarchy-plus/openrgb-presets"
readonly TETRIS_PREFERENCE_FILE="${STATE_ROOT}/ram-tetris-enabled"
readonly ACTIVE_PRESET_FILE="${STATE_ROOT}/active-preset"
readonly TETRIS_FAILURE_FILE="${STATE_ROOT}/ram-tetris-failure.json"
readonly TETRIS_STATUS_FILE="${RUNTIME_DIR}/ram-tetris-status.json"
readonly TETRIS_STOP_FILE="${RUNTIME_DIR}/ram-tetris.stop"
readonly TETRIS_LOCK_FILE="${RUNTIME_DIR}/ram-tetris.lock"
readonly TETRIS_WRITE_LOCK_FILE="${RUNTIME_DIR}/ram-tetris-write.lock"
readonly USER_MANAGER_COMMAND="${USER_MANAGER_COMMAND:-/usr/lib/systemd/systemd --user}"
readonly RESTORE_TIMEOUT="75s"
readonly RESUME_DELAY="${OPENRGB_RESUME_DELAY:-3}"
readonly -a OPENRGB_SERVER_ARGS=(
  --noautoconnect
  --startminimized
  --server
  --server-host 127.0.0.1
  --server-port 6742
)

server_pid=''
server_start_time=''
server_origin='none'
restore_pid=''
tetris_pid=''
tetris_start_time=''
inhibitor_pid=''
inhibitor_start_time=''
monitor_pid=''
monitor_start_time=''
monitor_fd=''
lifecycle_lock_fd=''
suspended=false
shutting_down=false
service_mode=false
service_ready=false

log() {
  /usr/bin/printf '%s\n' "$*"
}

is_running() {
  local pid="${1:-}"
  [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
}

process_start_time() {
  local pid="${1:-}"
  [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -r "${PROC_ROOT}/${pid}/stat" ]] || return 1
  /usr/bin/awk '{print $22}' "${PROC_ROOT}/${pid}/stat"
}

is_same_process() {
  local pid="${1:-}"
  local expected_start="${2:-}"
  local actual_start=''

  [[ -n "${expected_start}" ]] || return 1
  actual_start="$(process_start_time "${pid}" 2>/dev/null || true)"
  [[ -n "${actual_start}" && "${actual_start}" == "${expected_start}" ]]
}

process_command() {
  local pid="${1:-}"
  [[ "${pid}" =~ ^[1-9][0-9]*$ ]] || return 1
  [[ -r "${PROC_ROOT}/${pid}/cmdline" ]] || return 1
  "${TR_BIN}" '\0' ' ' <"${PROC_ROOT}/${pid}/cmdline" | /usr/bin/sed 's/ $//'
}

process_parent() {
  local pid="${1:-}"
  [[ -r "${PROC_ROOT}/${pid}/status" ]] || return 1
  /usr/bin/awk '$1 == "PPid:" {print $2}' "${PROC_ROOT}/${pid}/status"
}

process_uid() {
  local pid="${1:-}"
  [[ -r "${PROC_ROOT}/${pid}/status" ]] || return 1
  /usr/bin/awk '$1 == "Uid:" {print $2}' "${PROC_ROOT}/${pid}/status"
}

process_cgroup() {
  local pid="${1:-}"
  [[ -r "${PROC_ROOT}/${pid}/cgroup" ]] || return 1
  "${CAT_BIN}" "${PROC_ROOT}/${pid}/cgroup"
}

process_group() {
  local pid="${1:-}"
  "${PS_BIN}" -p "${pid}" -o pgid= 2>/dev/null | /usr/bin/awk '{$1=$1; print}'
}

legacy_inhibitor_command() {
  /usr/bin/printf '%s' "${INHIBIT_BIN} --what=sleep --who=OpenRGB Presets --why=Stop OpenRGB before system sleep --mode=delay ${SLEEP_BIN} infinity"
}

legacy_monitor_command() {
  /usr/bin/printf '%s' "${GDBUS_BIN} monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1"
}

current_inhibitor_command() {
  /usr/bin/printf '%s' "${INHIBIT_PROCESS_PREFIX} --what=sleep --who=OpenRGB Presets --why=Stop OpenRGB before system sleep --mode=delay ${SETPRIV_BIN} --pdeathsig TERM ${SLEEP_BIN} infinity"
}

is_owned_current_inhibitor() {
  local pid="${1:-}"
  local start_time="${2:-}"
  is_same_process "${pid}" "${start_time}" \
    && [[ "$(process_command "${pid}" 2>/dev/null || true)" == "$(current_inhibitor_command)" ]] \
    && [[ "$(process_group "${pid}" 2>/dev/null || true)" == "${pid}" ]]
}

classify_legacy_process() {
  local candidate_pid="${1:-}"
  local candidate_start="${2:-}"
  local active_pid="${3:-}"
  local active_start="${4:-}"
  local expected_command="${5:-}"
  local require_group_leader="${6:-false}"
  local candidate_parent=''
  local candidate_cgroup=''
  local active_cgroup=''

  if ! is_same_process "${candidate_pid}" "${candidate_start}" \
    || ! is_same_process "${active_pid}" "${active_start}" \
    || [[ "$(process_uid "${candidate_pid}" 2>/dev/null || true)" != "${USER_ID}" ]] \
    || [[ "$(process_command "${candidate_pid}" 2>/dev/null || true)" != "${expected_command}" ]] \
    || [[ "${require_group_leader}" == true \
      && "$(process_group "${candidate_pid}" 2>/dev/null || true)" != "${candidate_pid}" ]]; then
    /usr/bin/printf '%s\n' 'ineligible'
    return 1
  fi

  candidate_cgroup="$(process_cgroup "${candidate_pid}" 2>/dev/null || true)"
  active_cgroup="$(process_cgroup "${active_pid}" 2>/dev/null || true)"
  if [[ -z "${candidate_cgroup}" || "${candidate_cgroup}" != "${active_cgroup}" ]]; then
    /usr/bin/printf '%s\n' 'ineligible'
    return 1
  fi

  candidate_parent="$(process_parent "${candidate_pid}" 2>/dev/null || true)"
  if [[ "${candidate_parent}" == "${active_pid}" ]]; then
    /usr/bin/printf '%s\n' 'legitimate'
    return 0
  fi
  if [[ "$(process_command "${candidate_parent}" 2>/dev/null || true)" == "${USER_MANAGER_COMMAND}" ]]; then
    /usr/bin/printf '%s\n' 'stale-legacy'
    return 0
  fi

  /usr/bin/printf '%s\n' 'ineligible'
  return 1
}

classify_legacy_inhibitor() {
  classify_legacy_process "${1:-}" "${2:-}" "${3:-}" "${4:-}" \
    "$(legacy_inhibitor_command)" true
}

classify_legacy_monitor() {
  local monitor_pid="${1:-}"
  local monitor_start="${2:-}"
  local active_pid="${3:-}"
  local active_start="${4:-}"
  local inhibitor_candidate_pid="${5:-}"
  local inhibitor_candidate_start="${6:-}"
  local monitor_class=''
  local inhibitor_class=''

  monitor_class="$(classify_legacy_process \
    "${monitor_pid}" "${monitor_start}" "${active_pid}" "${active_start}" \
    "$(legacy_monitor_command)" false 2>/dev/null || true)"
  inhibitor_class="$(classify_legacy_inhibitor \
    "${inhibitor_candidate_pid}" "${inhibitor_candidate_start}" \
    "${active_pid}" "${active_start}" 2>/dev/null || true)"

  if [[ "${monitor_class}" != "${inhibitor_class}" \
    || "${monitor_class}" != @(legitimate|stale-legacy) \
    || ! "${monitor_start}" =~ ^[0-9]+$ \
    || ! "${inhibitor_candidate_start}" =~ ^[0-9]+$ \
    || "${monitor_start}" -lt "${inhibitor_candidate_start}" \
    || $((monitor_start - inhibitor_candidate_start)) -gt 500 ]]; then
    /usr/bin/printf '%s\n' 'ineligible'
    return 1
  fi

  /usr/bin/printf '%s\n' "${monitor_class}"
}

close_fd() {
  local fd="${1:-}"
  [[ "${fd}" =~ ^[0-9]+$ ]] || return 0
  eval "exec ${fd}>&-"
}

close_lock_for_child() {
  close_fd "${lifecycle_lock_fd}"
}

mark_service_state() {
  local state="${1}"
  local reason="${2:-}"
  local lifecycle_start=''
  local -a command

  [[ "${service_mode}" == true ]] || return 0
  lifecycle_start="$(process_start_time $$)"
  command=(
    "${SERVICE_GUARD}" mark "${state}"
    --lifecycle-pid "$$"
    --lifecycle-start "${lifecycle_start}"
  )
  if [[ -n "${server_pid}" && -n "${server_start_time}" ]]; then
    command+=(--server-pid "${server_pid}" --server-start "${server_start_time}")
  fi
  if [[ -n "${reason}" ]]; then
    command+=(--reason "${reason}")
  fi
  "${command[@]}"
}

notify_service_status() {
  [[ "${service_mode}" == true ]] || return 0
  "${SYSTEMD_NOTIFY_BIN}" --status="$*"
}

verify_tetris_lock_released() {
  local verify_fd=''
  local old_umask=''

  old_umask="$(umask)"
  umask 077
  exec {verify_fd}>"${TETRIS_LOCK_FILE}"
  umask "${old_umask}"
  if ! "${FLOCK_BIN}" -n "${verify_fd}"; then
    close_fd "${verify_fd}"
    return 1
  fi
  close_fd "${verify_fd}"
}

acquire_lifecycle_lock() {
  local old_umask
  old_umask="$(umask)"
  umask 077
  "${MKDIR_BIN}" -p -- "${RUNTIME_DIR}"
  exec {lifecycle_lock_fd}>"${LIFECYCLE_LOCK_FILE}"
  umask "${old_umask}"
  "${FLOCK_BIN}" -n "${lifecycle_lock_fd}"
}

stop_process() {
  local pid="${1:-}"
  local name="${2}"
  local attempt

  if ! is_running "${pid}"; then
    return 0
  fi

  kill -TERM "${pid}" 2>/dev/null || true
  for attempt in {1..20}; do
    if ! is_running "${pid}"; then
      wait "${pid}" 2>/dev/null || true
      log "${name} stopped"
      return 0
    fi
    "${SLEEP_BIN}" 0.1
  done

  kill -KILL "${pid}" 2>/dev/null || true
  wait "${pid}" 2>/dev/null || true
  log "${name} required SIGKILL"
}

stop_restore() {
  if is_running "${restore_pid}"; then
    stop_process "${restore_pid}" "Preset restore"
  fi
  restore_pid=''
}

is_tetris_process() {
  local pid="${1:-}"
  local start_time="${2:-}"
  local command=''

  is_same_process "${pid}" "${start_time}" || return 1
  command="$(process_command "${pid}" 2>/dev/null || true)"
  [[ "${command}" == "/usr/bin/python3 ${RAM_TETRIS} run --server-pid ${server_pid} --server-start ${server_start_time} --lifecycle-pid $$ --lifecycle-start $(process_start_time $$)" ]]
}

tetris_preference_enabled() {
  [[ -r "${TETRIS_PREFERENCE_FILE}" ]] \
    && [[ "$(/usr/bin/head -n 1 "${TETRIS_PREFERENCE_FILE}")" == on ]]
}

tetris_selected_preset() {
  if [[ -r "${ACTIVE_PRESET_FILE}" ]]; then
    /usr/bin/head -n 1 "${ACTIVE_PRESET_FILE}"
  else
    /usr/bin/printf '%s' bright-white
  fi
}

clear_tetris_identity() {
  tetris_pid=''
  tetris_start_time=''
}

tetris_local_stop_requested() {
  [[ -r "${TETRIS_STOP_FILE}" ]] \
    && /usr/bin/grep -Eq \
      '"reason"[[:space:]]*:[[:space:]]*"(user-off|preset-change)"' \
      "${TETRIS_STOP_FILE}"
}

start_tetris() {
  local attempt
  local lifecycle_start=''

  [[ "${suspended}" == false ]] || return 0
  tetris_preference_enabled || return 0
  [[ "$(tetris_selected_preset)" != black ]] || return 0
  [[ ! -e "${TETRIS_FAILURE_FILE}" ]] || return 0
  is_server_listener "${server_pid}" "${server_start_time}" || return 1
  if is_tetris_process "${tetris_pid}" "${tetris_start_time}"; then
    return 0
  fi
  clear_tetris_identity
  lifecycle_start="$(process_start_time $$)"
  (
    close_lock_for_child
    exec "${SETPRIV_BIN}" --pdeathsig TERM "${RAM_TETRIS}" run \
      --server-pid "${server_pid}" \
      --server-start "${server_start_time}" \
      --lifecycle-pid "$$" \
      --lifecycle-start "${lifecycle_start}" >>"${TETRIS_LOG_FILE}" 2>&1
  ) &
  tetris_pid=$!
  tetris_start_time=''
  for attempt in {1..20}; do
    tetris_start_time="$(process_start_time "${tetris_pid}" 2>/dev/null || true)"
    if is_tetris_process "${tetris_pid}" "${tetris_start_time}"; then
      log "RAM Tetris started as PID ${tetris_pid} (start ${tetris_start_time})"
      return 0
    fi
    if ! is_running "${tetris_pid}"; then
      break
    fi
    "${SLEEP_BIN}" 0.05
  done
  wait "${tetris_pid}" 2>/dev/null || true
  clear_tetris_identity
  return 1
}

stop_tetris() {
  local reason="${1:-handoff}"
  local attempt
  local lifecycle_start=''
  local stop_lock_fd=''
  local stop_temp=''
  local stop_time=''
  local old_umask=''

  if [[ -z "${tetris_pid}" ]]; then
    return 0
  fi
  if ! is_tetris_process "${tetris_pid}" "${tetris_start_time}"; then
    log "Refusing stop request for changed RAM Tetris PID ${tetris_pid}"
    return 1
  fi

  if [[ "${reason}" == @(handoff|suspend|shutdown) ]]; then
    lifecycle_start="$(process_start_time $$)"
    is_server_listener "${server_pid}" "${server_start_time}" || return 1
    old_umask="$(umask)"
    umask 077
    exec {stop_lock_fd}>"${TETRIS_WRITE_LOCK_FILE}"
    umask "${old_umask}"
    "${FLOCK_BIN}" "${stop_lock_fd}"
    stop_temp="${TETRIS_STOP_FILE}.$$"
    stop_time="${EPOCHREALTIME}"
    if ! (
      umask 077
      /usr/bin/printf \
        '{"lifecycle_pid":%s,"lifecycle_start":"%s","reason":"%s","server_pid":%s,"server_start":"%s","time":%s}\n' \
        "$$" "${lifecycle_start}" "${reason}" \
        "${server_pid}" "${server_start_time}" "${stop_time}" >"${stop_temp}"
    ) || ! "${MV_BIN}" -f -- "${stop_temp}" "${TETRIS_STOP_FILE}"; then
      close_fd "${stop_lock_fd}"
      log "Failed to establish authenticated RAM Tetris ${reason} stop"
      return 1
    fi
    close_fd "${stop_lock_fd}"
  elif ! "${RAM_TETRIS}" request-stop "${reason}" >/dev/null 2>&1; then
    log "Failed to establish RAM Tetris ${reason} stop"
    return 1
  fi

  for attempt in {1..100}; do
    if ! is_same_process "${tetris_pid}" "${tetris_start_time}"; then
      wait "${tetris_pid}" 2>/dev/null || true
      clear_tetris_identity
      return 0
    fi
    "${SLEEP_BIN}" 0.05
  done
  if is_tetris_process "${tetris_pid}" "${tetris_start_time}"; then
    kill -TERM "${tetris_pid}" 2>/dev/null || true
    wait "${tetris_pid}" 2>/dev/null || true
  else
    log "Refusing to signal changed RAM Tetris PID ${tetris_pid}"
    return 1
  fi
  clear_tetris_identity
}

reconcile_tetris() {
  if [[ -n "${tetris_pid}" ]] && ! is_same_process "${tetris_pid}" "${tetris_start_time}"; then
    wait "${tetris_pid}" 2>/dev/null || true
    clear_tetris_identity
    if [[ ! -e "${TETRIS_FAILURE_FILE}" ]] \
      && ! tetris_local_stop_requested; then
      "${RAM_TETRIS}" fail 'RAM Tetris writer exited unexpectedly; static restoration was not attempted' >/dev/null 2>&1 || true
    fi
  fi
  if ! tetris_preference_enabled; then
    [[ -z "${tetris_pid}" ]] || stop_tetris user-off
    return 0
  fi
  if [[ "$(tetris_selected_preset)" == black ]]; then
    [[ -z "${tetris_pid}" ]] || stop_tetris preset-change
    return 0
  fi
  [[ -n "${restore_pid}" ]] || start_tetris
}

expected_server_command() {
  /usr/bin/printf '%s' "${OPENRGB_BIN} ${OPENRGB_SERVER_ARGS[*]}"
}

listener_owner_pid() {
  local listener=''
  local pid=''

  listener="$("${SS_BIN}" -H -ltnp 'sport = :6742' 2>/dev/null \
    | /usr/bin/awk '$4 == "127.0.0.1:6742" && index($0, "users:((\"openrgb\",pid=") {print}')"
  if [[ -z "${listener}" || "${listener}" == *$'\n'* ]]; then
    return 1
  fi

  pid="$(/usr/bin/printf '%s\n' "${listener}" \
    | /usr/bin/sed -nE 's/.*pid=([0-9]+).*/\1/p')"
  if [[ -z "${pid}" ]]; then
    return 1
  fi

  /usr/bin/printf '%s' "${pid}"
}

is_server_process() {
  local pid="${1:-}"
  local start_time="${2:-}"

  is_same_process "${pid}" "${start_time}" \
    && [[ "$(process_command "${pid}" 2>/dev/null || true)" == "$(expected_server_command)" ]]
}

is_server_listener() {
  local pid="${1:-}"
  local start_time="${2:-}"
  local owner=''

  is_server_process "${pid}" "${start_time}" || return 1
  owner="$(listener_owner_pid 2>/dev/null || true)"
  [[ "${owner}" == "${pid}" ]] || return 1
  is_server_process "${pid}" "${start_time}" || return 1
  [[ "$(listener_owner_pid 2>/dev/null || true)" == "${pid}" ]]
}

find_existing_server() {
  local pid=''
  local start_time=''

  pid="$(listener_owner_pid 2>/dev/null || true)"
  [[ -n "${pid}" ]] || return 1
  start_time="$(process_start_time "${pid}" 2>/dev/null || true)"
  [[ -n "${start_time}" ]] || return 1
  is_server_listener "${pid}" "${start_time}" || return 1

  /usr/bin/printf '%s %s\n' "${pid}" "${start_time}"
}

clear_server_identity() {
  server_pid=''
  server_start_time=''
  server_origin='none'
}

launch_server() {
  local attempt

  (
    close_lock_for_child
    exec "${SETPRIV_BIN}" --pdeathsig TERM \
      "${OPENRGB_BIN}" "${OPENRGB_SERVER_ARGS[@]}" >>"${SERVER_LOG_FILE}" 2>&1
  ) &
  server_pid=$!
  server_start_time=''
  server_origin='launched'

  for attempt in {1..20}; do
    server_start_time="$(process_start_time "${server_pid}" 2>/dev/null || true)"
    if [[ -n "${server_start_time}" ]]; then
      log "OpenRGB server started as PID ${server_pid} (start ${server_start_time})"
      return 0
    fi
    "${SLEEP_BIN}" 0.05
  done

  if is_running "${server_pid}"; then
    log "Refusing to track OpenRGB PID ${server_pid} without a start-time identity"
  fi
  clear_server_identity
  return 1
}

start_restore() {
  local attempt
  local lifecycle_start=''
  local validated=false

  lifecycle_start="$(process_start_time $$)"
  for attempt in {1..15}; do
    if "${RAM_TETRIS}" validate-hardware \
      --server-pid "${server_pid}" \
      --server-start "${server_start_time}" \
      --lifecycle-pid "$$" \
      --lifecycle-start "${lifecycle_start}" >/dev/null; then
      validated=true
      break
    fi
    "${SLEEP_BIN}" 1
  done
  if [[ "${validated}" == false ]]; then
    /usr/bin/printf '%s\n' 'Pre-restore hardware health validation failed; refusing preset write' >&2
    return 1
  fi
  (
    close_lock_for_child
    exec "${SETPRIV_BIN}" --pdeathsig TERM \
      "${TIMEOUT_BIN}" --signal=TERM --kill-after=2s "${RESTORE_TIMEOUT}" \
      "${APPLY_PRESET}" --restore
  ) &
  restore_pid=$!
}

start_server() {
  local existing_pid=''
  local existing_start_time=''

  if is_server_listener "${server_pid}" "${server_start_time}"; then
    return 0
  fi

  if is_server_process "${server_pid}" "${server_start_time}"; then
    log "Refusing to replace tracked OpenRGB PID ${server_pid}: listener ownership is not verified"
    return 1
  fi
  clear_server_identity

  if read -r existing_pid existing_start_time < <(find_existing_server); then
    server_pid="${existing_pid}"
    server_start_time="${existing_start_time}"
    server_origin='adopted'
    log "Reusing OpenRGB SDK server PID ${server_pid} (start ${server_start_time})"
  else
    launch_server
  fi

  start_restore
}

detach_server() {
  stop_restore
  if is_server_process "${server_pid}" "${server_start_time}"; then
    log "Leaving ${server_origin} OpenRGB SDK server PID ${server_pid} running for lifecycle handoff"
  fi
  clear_server_identity
}

stop_server() {
  local reason="${1:-deliberate shutdown}"
  local attempt

  stop_restore
  if [[ -z "${server_pid}" ]]; then
    clear_server_identity
    return 0
  fi

  if ! is_same_process "${server_pid}" "${server_start_time}"; then
    log "Tracked OpenRGB PID ${server_pid} no longer has start identity ${server_start_time}; not signaling"
    clear_server_identity
    return 0
  fi
  if ! is_server_listener "${server_pid}" "${server_start_time}"; then
    log "Refusing to signal OpenRGB PID ${server_pid} for ${reason}: process or listener identity changed"
    return 1
  fi

  kill -TERM "${server_pid}" 2>/dev/null || true
  for attempt in {1..20}; do
    if ! is_same_process "${server_pid}" "${server_start_time}"; then
      wait "${server_pid}" 2>/dev/null || true
      log "OpenRGB server stopped for ${reason}"
      clear_server_identity
      return 0
    fi
    "${SLEEP_BIN}" 0.1
  done

  if ! is_server_listener "${server_pid}" "${server_start_time}"; then
    log "Refusing to escalate OpenRGB PID ${server_pid} for ${reason}: listener ownership changed"
    return 1
  fi
  kill -KILL "${server_pid}" 2>/dev/null || true
  wait "${server_pid}" 2>/dev/null || true
  log "OpenRGB server required SIGKILL for ${reason}"
  clear_server_identity
}

start_inhibitor() {
  local attempt

  if is_owned_current_inhibitor "${inhibitor_pid}" "${inhibitor_start_time}"; then
    return 0
  fi

  inhibitor_pid=''
  inhibitor_start_time=''

  (
    close_lock_for_child
    exec "${SETPRIV_BIN}" --pdeathsig TERM "${SETSID_BIN}" "${INHIBIT_BIN}" \
      --what=sleep \
      --who='OpenRGB Presets' \
      --why='Stop OpenRGB before system sleep' \
      --mode=delay \
      "${SETPRIV_BIN}" --pdeathsig TERM "${SLEEP_BIN}" infinity
  ) &
  inhibitor_pid=$!
  inhibitor_start_time="$(process_start_time "${inhibitor_pid}")"
  for attempt in {1..20}; do
    if is_owned_current_inhibitor "${inhibitor_pid}" "${inhibitor_start_time}"; then
      log "Sleep delay inhibitor started as process group ${inhibitor_pid}"
      return 0
    fi
    if ! is_same_process "${inhibitor_pid}" "${inhibitor_start_time}"; then
      break
    fi
    "${SLEEP_BIN}" 0.05
  done

  if is_same_process "${inhibitor_pid}" "${inhibitor_start_time}"; then
    stop_process "${inhibitor_pid}" "Unrecognized inhibitor"
  else
    wait "${inhibitor_pid}" 2>/dev/null || true
  fi
  inhibitor_pid=''
  inhibitor_start_time=''
  /usr/bin/printf '%s\n' 'Sleep delay inhibitor failed to start with the expected identity' >&2
  return 1
}

release_inhibitor() {
  if ! is_owned_current_inhibitor "${inhibitor_pid}" "${inhibitor_start_time}"; then
    if is_same_process "${inhibitor_pid}" "${inhibitor_start_time}"; then
      log "Refusing to signal unrecognized inhibitor PID ${inhibitor_pid}"
    fi
    inhibitor_pid=''
    inhibitor_start_time=''
    return 0
  fi

  if is_owned_current_inhibitor "${inhibitor_pid}" "${inhibitor_start_time}"; then
    kill -TERM -- "-${inhibitor_pid}" 2>/dev/null || true
    wait "${inhibitor_pid}" 2>/dev/null || true
  else
    log "Refusing to signal changed inhibitor PID ${inhibitor_pid}"
  fi
  log "Sleep delay inhibitor released"
  inhibitor_pid=''
  inhibitor_start_time=''
}

start_monitor() {
  coproc SLEEP_MONITOR {
    close_lock_for_child
    exec "${SETPRIV_BIN}" --pdeathsig TERM "${STDBUF_BIN}" -oL \
      "${GDBUS_BIN}" monitor \
      --system \
      --dest org.freedesktop.login1 \
      --object-path /org/freedesktop/login1
  }
  monitor_pid="${SLEEP_MONITOR_PID}"
  monitor_start_time="$(process_start_time "${monitor_pid}")"
  monitor_fd="${SLEEP_MONITOR[0]}"
  log "logind sleep monitor started as PID ${monitor_pid}"
}

stop_monitor() {
  if is_same_process "${monitor_pid}" "${monitor_start_time}"; then
    stop_process "${monitor_pid}" "logind sleep monitor"
  fi
  monitor_pid=''
  monitor_start_time=''
  monitor_fd=''
}

handle_sleep_signal() {
  local sleeping="${1}"

  if [[ "${sleeping}" == true ]]; then
    if [[ "${suspended}" == true ]]; then
      return 0
    fi
    suspended=true
    log "PrepareForSleep(true): stopping OpenRGB"
    if ! stop_tetris suspend; then
      /usr/bin/printf '%s\n' 'RAM Tetris could not be stopped safely before sleep' >&2
    fi
    if ! stop_server 'suspend'; then
      /usr/bin/printf '%s\n' 'OpenRGB could not be stopped safely before sleep' >&2
    fi
    release_inhibitor
    return 0
  fi

  if [[ "${suspended}" == false ]]; then
    return 0
  fi
  suspended=false
  log "PrepareForSleep(false): scheduling OpenRGB restart"
  start_inhibitor
  "${SLEEP_BIN}" "${RESUME_DELAY}"
  start_server
}

validate_service_health() {
  local lifecycle_start=''

  [[ "${service_mode}" == true ]] || return 0
  lifecycle_start="$(process_start_time $$)"
  is_server_listener "${server_pid}" "${server_start_time}" || return 1
  is_owned_current_inhibitor "${inhibitor_pid}" "${inhibitor_start_time}" || return 1
  is_same_process "${monitor_pid}" "${monitor_start_time}" || return 1
  "${RAM_TETRIS}" validate-health \
    --server-pid "${server_pid}" \
    --server-start "${server_start_time}" \
    --lifecycle-pid "$$" \
    --lifecycle-start "${lifecycle_start}" >/dev/null
}

notify_service_ready() {
  [[ "${service_mode}" == true ]] || return 0
  validate_service_health
  if tetris_preference_enabled \
    && [[ "$(tetris_selected_preset)" != black ]] \
    && [[ ! -e "${TETRIS_FAILURE_FILE}" ]]; then
    is_tetris_process "${tetris_pid}" "${tetris_start_time}" || return 1
  elif [[ -n "${tetris_pid}" ]]; then
    return 1
  fi
  mark_service_state ready 'independent lifecycle health validation complete'
  "${SYSTEMD_NOTIFY_BIN}" --ready \
    --status="OpenRGB lifecycle ready: SDK ${server_pid}/${server_start_time}"
  service_ready=true
}

cleanup() {
  local mode="${1:-handoff}"
  local tetris_reason='handoff'
  local failed=false

  if [[ "${shutting_down}" == true ]]; then
    return 0
  fi
  shutting_down=true
  if [[ "${mode}" == deliberate ]]; then
    tetris_reason='shutdown'
  fi
  mark_service_state stopping "${mode}" || failed=true
  notify_service_status "Stopping OpenRGB lifecycle (${mode})" || true

  stop_tetris "${tetris_reason}" || failed=true
  verify_tetris_lock_released || failed=true

  case "${mode}" in
    handoff)
      detach_server || failed=true
      ;;
    deliberate)
      stop_server 'deliberate lifecycle shutdown' || failed=true
      ;;
    *)
      /usr/bin/printf 'Unknown cleanup mode: %s\n' "${mode}" >&2
      return 64
      ;;
  esac
  release_inhibitor || failed=true
  stop_monitor || failed=true
  if [[ "${failed}" == true ]]; then
    return 1
  fi
  mark_service_state clean-stopped "${mode}"
}

request_shutdown() {
  local mode='handoff'

  if [[ "${service_mode}" == true ]]; then
    mode='deliberate'
  fi
  if cleanup "${mode}"; then
    exit 0
  fi
  exit 1
}

request_handoff() {
  if cleanup handoff; then
    exit 0
  fi
  exit 1
}

exit_cleanup() {
  local exit_status=$?
  local mode='handoff'

  trap - EXIT
  if [[ "${service_mode}" == true ]]; then
    mode='deliberate'
  fi
  if ! cleanup "${mode}"; then
    exit_status=1
  fi
  exit "${exit_status}"
}

check_dependencies() {
  local dependency
  local failed=false

  for dependency in \
    "${OPENRGB_BIN}" "${GDBUS_BIN}" "${STDBUF_BIN}" "${INHIBIT_BIN}" \
    "${SETSID_BIN}" "${SETPRIV_BIN}" "${SS_BIN}" "${PS_BIN}" "${TIMEOUT_BIN}" \
    "${SLEEP_BIN}" "${CAT_BIN}" "${FLOCK_BIN}" "${MKDIR_BIN}" "${MV_BIN}" \
      "${TR_BIN}" "${APPLY_PRESET}" "${SERVICE_GUARD}" "${SYSTEMD_NOTIFY_BIN}"; do
    if [[ ! -x "${dependency}" ]]; then
      /usr/bin/printf 'Missing executable: %s\n' "${dependency}" >&2
      failed=true
    fi
  done

  if [[ ! -x "${RAM_TETRIS}" ]]; then
    /usr/bin/printf 'Missing executable: %s\n' "${RAM_TETRIS}" >&2
    failed=true
  fi

  if [[ "${failed}" == true ]]; then
    return 69
  fi
  log 'OpenRGB lifecycle dependencies: ready'
}

main() {
  if [[ "${1:-}" == '--classify-legacy-monitor' ]]; then
    if [[ "${#}" -ne 7 ]]; then
      /usr/bin/printf '%s\n' \
        'Usage: openrgb-lifecycle --classify-legacy-monitor PID START_TIME ACTIVE_PID ACTIVE_START_TIME INHIBITOR_PID INHIBITOR_START_TIME' >&2
      return 64
    fi
    classify_legacy_monitor "${2}" "${3}" "${4}" "${5}" "${6}" "${7}"
    return
  fi
  if [[ "${1:-}" == '--classify-legacy-inhibitor' ]]; then
    if [[ "${#}" -ne 5 ]]; then
      /usr/bin/printf '%s\n' \
        'Usage: openrgb-lifecycle --classify-legacy-inhibitor PID START_TIME ACTIVE_PID ACTIVE_START_TIME' >&2
      return 64
    fi
    classify_legacy_inhibitor "${2}" "${3}" "${4}" "${5}"
    return
  fi
  if [[ "${1:-}" == '--check' ]]; then
    check_dependencies
    return 0
  fi
  if [[ "${1:-}" == '--service' && "${#}" -eq 1 ]]; then
    service_mode=true
  elif [[ "${#}" -ne 0 ]]; then
    /usr/bin/printf '%s\n' 'Usage: openrgb-lifecycle [--check|--service]' >&2
    return 64
  elif [[ "${#}" -eq 0 ]]; then
    /usr/bin/printf '%s\n' 'Direct startup refused; use the supervised user service' >&2
    return 64
  fi

  check_dependencies >/dev/null
  if ! acquire_lifecycle_lock; then
    log 'Another OpenRGB lifecycle owns the runtime lock; retrying through the service supervisor'
    return 75
  fi
  trap exit_cleanup EXIT
  trap request_shutdown INT TERM HUP
  trap request_handoff USR1
  mark_service_state starting 'acquired lifecycle singleton'
  notify_service_status 'Starting OpenRGB lifecycle'

  start_inhibitor
  start_server

  start_monitor

  while true; do
    line=''
    if IFS= read -r -t 1 line <&"${monitor_fd}"; then
      case "${line}" in
        *'org.freedesktop.login1.Manager.PrepareForSleep (true,)'*)
          handle_sleep_signal true
          ;;
        *'org.freedesktop.login1.Manager.PrepareForSleep (false,)'*)
          handle_sleep_signal false
          ;;
      esac
    elif ! is_running "${monitor_pid}"; then
      /usr/bin/printf '%s\n' 'logind sleep monitor exited unexpectedly' >&2
      return 1
    fi

    if [[ -n "${restore_pid}" ]] && ! is_running "${restore_pid}"; then
      if wait "${restore_pid}"; then
        restore_pid=''
        if ! reconcile_tetris; then
          /usr/bin/printf '%s\n' 'RAM Tetris reconciliation failed during lifecycle startup' >&2
          return 1
        fi
        if [[ "${service_ready}" == false ]] && ! notify_service_ready; then
          /usr/bin/printf '%s\n' 'Independent lifecycle health validation failed' >&2
          return 1
        fi
      else
        "${RAM_TETRIS}" fail 'Saved preset restoration failed; RAM Tetris was not started' >/dev/null 2>&1 || true
        if [[ "${service_ready}" == false ]]; then
          return 1
        fi
      fi
      restore_pid=''
    fi

    if [[ "${suspended}" == false ]]; then
      reconcile_tetris || true
    fi

    if [[ "${suspended}" == false ]] \
      && ! is_owned_current_inhibitor "${inhibitor_pid}" "${inhibitor_start_time}"; then
      /usr/bin/printf '%s\n' 'Sleep delay inhibitor exited unexpectedly; refusing automatic recovery' >&2
      return 1
    fi

    if [[ "${suspended}" == false ]] \
      && ! is_server_listener "${server_pid}" "${server_start_time}"; then
      /usr/bin/printf '%s\n' 'OpenRGB server identity changed unexpectedly; refusing automatic replacement' >&2
      return 1
    fi
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
