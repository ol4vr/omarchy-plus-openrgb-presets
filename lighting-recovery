    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise RecoveryBlocked(
            "Recovery blocked: the failure latch is unavailable."
        ) from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or metadata.st_mode & 0o077
        ):
            raise RecoveryBlocked(
                "Recovery blocked: the failure latch is not protected."
            )
        chunks: list[bytes] = []
        while chunk := os.read(descriptor, 65_536):
            chunks.append(chunk)
        if b"".join(chunks) != expected:
            raise RecoveryBlocked(
                "Recovery blocked: the failure latch changed before clearance."
            )
        path_metadata = path.lstat()
        if (
            path_metadata.st_dev != metadata.st_dev
            or path_metadata.st_ino != metadata.st_ino
        ):
            raise RecoveryBlocked(
                "Recovery blocked: the failure latch identity changed."
            )
        path.unlink()
        _fsync_directory(path.parent)
    finally:
        os.close(descriptor)


def _recover_lifecycle(
    raw: bytes,
    record: dict[str, object],
    confirmation_token: str,
) -> dict[str, object]:
    message = _failure_message(record)
    lifecycle_raw, config_raw = _verify_lifecycle_recovery_preflight(record, message)
    expected_token = _lifecycle_confirmation_token(raw, lifecycle_raw, config_raw)
    if not confirmation_token or confirmation_token != expected_token:
        raise RecoveryBlocked(
            "Recovery blocked: confirmation does not match this lifecycle incident."
        )

    reference = _incident_reference(raw)
    _preserve_evidence(raw, reference)
    _preserve_evidence(lifecycle_raw, reference, "lifecycle-state")
    _preserve_evidence(config_raw, reference, "openrgb-config")
    _atomic_text(state_root() / "ram-tetris-enabled", "off\n")

    failure_path = state_root() / "ram-tetris-failure.json"
    lifecycle_path = state_root() / "lifecycle-service-state.json"
    preference_path = state_root() / "ram-tetris-enabled"
    if (
        preference_path.read_bytes() != b"off\n"
        or failure_path.read_bytes() != raw
        or lifecycle_path.read_bytes() != lifecycle_raw
        or OPENRGB_CONFIG.read_bytes() != config_raw
    ):
        raise RecoveryBlocked(
            "Recovery blocked: preserved boundary evidence changed before acknowledgment."
        )

    acknowledgement = subprocess.run(
        [
            SERVICE_GUARD,
            "acknowledge-reviewed-recovery",
            "--acknowledge-reviewed-recovery",
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if acknowledgement.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: the reviewed service-boundary acknowledgment failed."
        )

    start_deadline = time.monotonic() + SERVICE_START_TIMEOUT
    start = subprocess.run(
        [SYSTEMCTL, "--user", "start", SERVICE_NAME],
        check=False,
        capture_output=True,
        text=True,
        timeout=SERVICE_START_TIMEOUT,
    )
    if start.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: the single service start failed; manual review is required."
        )

    failure_time, _ = _timestamp(record)
    if failure_time is None:  # preflight already rejects this; retain fail-closed form.
        raise RecoveryBlocked("Recovery blocked: the incident timestamp is invalid.")
    _wait_for_authoritative_lifecycle_ready(start_deadline)
    _verify_service_and_hardware(failure_time)
    if failure_path.read_bytes() != raw:
        raise RecoveryBlocked(
            "Recovery blocked: the failure latch changed during service acceptance."
        )
    failure_path.unlink()
    _fsync_directory(failure_path.parent)
    return {
        "state": "recovered",
        "incident_reference": reference,
        "message": "Lighting recovery complete. RAM Tetris remains OFF.",
    }


def _verify_shutdown_race_running_continuity(
    binding: ShutdownRaceRecoveryBinding,
) -> bytes:
    if (
        _verify_shutdown_race_corrected_source() != binding.installed_source_revision
        or _current_boot_id() != binding.current_boot_id
        or _preference()
    ):
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race source, boot, or preference changed."
        )
    failure_raw, _ = _failure_record()
    if failure_raw != binding.incident.failure_raw:
        raise RecoveryBlocked(
            "Recovery blocked: the shutdown-race latch changed during restoration."
        )
    if (
        _detector_policy_is_reviewed() != binding.config_raw
        or _shutdown_race_historical_evidence() != binding.historical_journal_raw
    ):
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race configuration or history changed."
        )
    _verify_shutdown_race_kernel_qualification(
        binding.current_boot_kernel, binding.config_raw
    )
    ready_raw, ready = _service_state_record()
    if (
        ready.get("state") != "ready"
        or ready.get("reason") != HISTORICAL_READY_REASON
        or ready.get("boot_id") != binding.current_boot_id
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the single service start is not authoritatively ready."
        )
    _verify_service_and_hardware(None)
    return ready_raw


def _recover_shutdown_race(confirmation_token: str) -> dict[str, object]:
    binding = _shutdown_race_recovery_preflight(require_preference_off=False)
    expected_token = _shutdown_race_confirmation_token(binding)
    if not confirmation_token or confirmation_token != expected_token:
        raise RecoveryBlocked(
            "Recovery blocked: confirmation does not match this shutdown-race incident."
        )

    incident = binding.incident
    for raw, kind in (
        (incident.failure_raw, "failure"),
        (binding.boundary_raw, "lifecycle-state"),
        (binding.config_raw, "openrgb-config"),
        (binding.historical_journal_raw, "shutdown-race-journal"),
        (
            binding.current_boot_kernel.evidence_raw,
            "current-boot-kernel-qualification",
        ),
    ):
        _preserve_evidence(raw, incident.incident_reference, kind)
    _atomic_text(state_root() / "ram-tetris-enabled", "off\n")

    second = _shutdown_race_recovery_preflight(
        require_preference_off=True,
        kernel_qualification=binding.current_boot_kernel,
    )
    if second != binding:
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race evidence changed before acknowledgment."
        )

    acknowledgement = subprocess.run(
        [
            SERVICE_GUARD,
            "acknowledge-reviewed-recovery",
            "--acknowledge-reviewed-recovery",
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=10,
    )
    if acknowledgement.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: the reviewed stale-boundary acknowledgment failed."
        )
    acknowledged = _read_service_state()
    if (
        acknowledged.get("state") != "clean-stopped"
        or acknowledged.get("reason") != "acknowledged-reviewed-recovery"
        or acknowledged.get("boot_id") != binding.current_boot_id
        or _failure_record()[0] != incident.failure_raw
        or _preference()
    ):
        raise RecoveryBlocked(
            "Recovery blocked: stale-boundary acknowledgment was not isolated."
        )

    start_deadline = time.monotonic() + SERVICE_START_TIMEOUT
    start = subprocess.run(
        [SYSTEMCTL, "--user", "start", SERVICE_NAME],
        check=False,
        capture_output=True,
        text=True,
        timeout=SERVICE_START_TIMEOUT,
    )
    if start.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: the single service start failed; manual review is required."
        )

    _wait_for_authoritative_lifecycle_ready(start_deadline)
    ready_raw = _verify_shutdown_race_running_continuity(binding)
    if _verify_shutdown_race_running_continuity(binding) != ready_raw:
        raise RecoveryBlocked(
            "Recovery blocked: service identity changed during final acceptance."
        )
    _verify_service_and_hardware(None)
    if _preference():
        raise RecoveryBlocked(
            "Recovery blocked: RAM Tetris preference changed before clearance."
        )
    _verify_shutdown_race_kernel_qualification(
        binding.current_boot_kernel, binding.config_raw
    )
    _unlink_unchanged_latch(incident.failure_raw)
    return {
        "state": "recovered",
        "incident_reference": incident.incident_reference,
        "message": "Shutdown-race recovery complete. RAM Tetris remains OFF.",
    }


def _recover_transient_spd(confirmation_token: str) -> dict[str, object]:
    """Run the existing transient-SPD observation and clearance exactly once."""

    root = runtime_root()
    _private_directory(root)
    lock_fd = os.open(root / "lighting-recovery.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RecoveryBlocked(
                "Recovery blocked: another recovery is active."
            ) from error

        incident = _classify_transient_spd_incident()
        expected_token = _transient_spd_confirmation_token(incident.failure_raw)
        if not confirmation_token or confirmation_token != expected_token:
            raise RecoveryBlocked(
                "Recovery blocked: confirmation does not match this transient SPD incident."
            )
        current_state_raw, config_raw, _, qualification_raw = (
            _transient_spd_environment_preflight(incident, require_preference_off=False)
        )
        for raw, kind in (
            (incident.failure_raw, "failure"),
            (current_state_raw, "lifecycle-state"),
            (config_raw, "openrgb-config"),
            (qualification_raw, "transient-spd-qualification"),
        ):
            _preserve_evidence(raw, incident.incident_reference, kind)
        _atomic_text(state_root() / "ram-tetris-enabled", "off\n")
        if (
            _failure_record()[0] != incident.failure_raw
            or _read_protected_bytes(
                state_root() / "ram-tetris-enabled", "RAM Tetris preference"
            )
            != b"off\n"
        ):
            raise RecoveryBlocked(
                "Recovery blocked: incident or preference changed while disabling "
                "RAM Tetris."
            )
    finally:
        os.close(lock_fd)

    observation = observe_transient_spd()
    directory = observation.get("observation_directory")
    manifest_sha256 = observation.get("stability_manifest_sha256")
    if not isinstance(directory, str) or not isinstance(manifest_sha256, str):
        raise RecoveryBlocked(
            "Recovery blocked: transient SPD observation result is incomplete."
        )
    result = clear_reviewed_transient_spd(directory, manifest_sha256)
    result["message"] = "Transient SPD recovery complete. RAM Tetris remains OFF."
    return result


def recover(confirmation_token: str) -> dict[str, object]:
    _, initial_record = _failure_record()
    if _failure_message(initial_record) == SHUTDOWN_RACE_REASON:
        root = runtime_root()
        _private_directory(root)
        lock_fd = os.open(
            root / "lighting-recovery.lock", os.O_WRONLY | os.O_CREAT, 0o600
        )
        try:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as error:
                raise RecoveryBlocked(
                    "Recovery blocked: another recovery is active."
                ) from error
            return _recover_shutdown_race(confirmation_token)
        finally:
            os.close(lock_fd)
    if TRANSIENT_SPD_REASON.fullmatch(_failure_message(initial_record)):
        return _recover_transient_spd(confirmation_token)

    root = runtime_root()
    _private_directory(root)
    lock_fd = os.open(root / "lighting-recovery.lock", os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as error:
            raise RecoveryBlocked(
                "Recovery blocked: another recovery is active."
            ) from error

        raw, record = _failure_record()
        message = _failure_message(record)
        if message in LIFECYCLE_RECOVERY_REASONS:
            return _recover_lifecycle(raw, record, confirmation_token)
        expected_token = hashlib.sha256(raw).hexdigest()
        if not confirmation_token or confirmation_token != expected_token:
            raise RecoveryBlocked(
                "Recovery blocked: confirmation does not match this incident."
            )
        failure_class = classify_reason(message)
        failure_time, _ = _timestamp(record)
        if not failure_class.reviewed_recovery or message not in ELIGIBLE_REASONS:
            raise RecoveryBlocked("Recovery blocked: this incident is not eligible.")
        if failure_time is None:
            raise RecoveryBlocked(
                "Recovery blocked: the incident timestamp is invalid."
            )

        _verify_service_and_hardware(failure_time)
        reference = _incident_reference(raw)
        _preserve_evidence(raw, reference)
        _atomic_text(state_root() / "ram-tetris-enabled", "off\n")

        failure_path = state_root() / "ram-tetris-failure.json"
        if failure_path.read_bytes() != raw:
            raise RecoveryBlocked(
                "Recovery blocked: the failure latch changed during review."
            )
        failure_path.unlink()
        _fsync_directory(failure_path.parent)
        return {
            "state": "recovered",
            "incident_reference": reference,
            "message": "Recovery complete. RAM Tetris remains OFF.",
        }
    finally:
        os.close(lock_fd)


