class RecoveryBlocked(RuntimeError):
    """A recovery safety gate refused to continue."""


def _private_directory(path: Path) -> None:
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    metadata = path.lstat()
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_mode & 0o077
    ):
        raise RecoveryBlocked(f"Recovery state directory is unsafe: {path.name}")


def state_root() -> Path:
    return (
        Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
        / "omarchy-plus"
        / "openrgb-presets"
    )


def runtime_root() -> Path:
    return Path(
        os.environ.get(
            "OPENRGB_RUNTIME_DIR",
            str(
                Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
                / "omarchy-plus"
                / "openrgb-presets"
            ),
        )
    )


def _require_private_directory(path: Path, label: str) -> None:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise RecoveryBlocked(f"Recovery blocked: {label} is unavailable.") from error
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or metadata.st_mode & 0o077
    ):
        raise RecoveryBlocked(f"Recovery blocked: {label} is not protected.")


def _read_protected_bytes(path: Path, label: str) -> bytes:
    _require_private_directory(path.parent, f"{label} directory")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise RecoveryBlocked(f"Recovery blocked: {label} is unavailable.") from error
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != os.getuid()
            or metadata.st_mode & 0o077
        ):
            raise RecoveryBlocked(f"Recovery blocked: {label} is not protected.")
        chunks: list[bytes] = []
        while chunk := os.read(descriptor, 65_536):
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def _json_record(raw: bytes, label: str) -> dict[str, object]:
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RecoveryBlocked(f"Recovery blocked: {label} is unreadable.") from error
    if not isinstance(value, dict):
        raise RecoveryBlocked(f"Recovery blocked: {label} is invalid.")
    return value


def classify_reason(message: str) -> FailureClass:
    exact = EXACT_FAILURES.get(message)
    if exact is not None:
        return exact
    for prefixes, failure_class in PREFIX_FAILURES:
        if message.startswith(prefixes):
            return failure_class
    return UNKNOWN_FAILURE


def _failure_record() -> tuple[bytes, dict[str, object]]:
    path = state_root() / "ram-tetris-failure.json"
    try:
        raw = path.read_bytes()
    except FileNotFoundError as error:
        raise RecoveryBlocked("No preserved lighting failure is present.") from error
    try:
        value = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise RecoveryBlocked(
            "The preserved lighting failure record is unreadable."
        ) from error
    if not isinstance(value, dict):
        raise RecoveryBlocked("The preserved lighting failure record is invalid.")
    return raw, value


def _failure_message(value: dict[str, object]) -> str:
    message = value.get("message")
    return (
        message if isinstance(message, str) and message else "unreadable failure reason"
    )


def _incident_reference(raw: bytes) -> str:
    return "LR-" + hashlib.sha256(raw).hexdigest()[:16].upper()


def _verify_corrected_source_revision(minimum_revision: str) -> str:
    status = subprocess.run(
        [GIT, "-C", str(ROOT), "status", "--porcelain", "--untracked-files=no"],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    if status.returncode != 0 or status.stdout:
        raise RecoveryBlocked(
            "Recovery blocked: the installed OpenRGB Presets source is not clean."
        )
    revision = subprocess.run(
        [GIT, "-C", str(ROOT), "rev-parse", "HEAD"],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    current = revision.stdout.strip()
    if revision.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40}", current):
        raise RecoveryBlocked(
            "Recovery blocked: the installed OpenRGB Presets revision is unreadable."
        )
    ancestry = subprocess.run(
        [
            GIT,
            "-C",
            str(ROOT),
            "merge-base",
            "--is-ancestor",
            minimum_revision,
            current,
        ],
        check=False,
        capture_output=True,
        text=True,
        timeout=5,
    )
    if ancestry.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: the installed OpenRGB Presets revision does not "
            "contain the reviewed minimum revision."
        )
    return current


def _source_blob_sha256(revision: str, source_path: str) -> str:
    if not re.fullmatch(r"[0-9a-f]{40}", revision) or source_path != "ram-tetris":
        raise RecoveryBlocked("Recovery blocked: failure source provenance is invalid.")
    source = subprocess.run(
        [GIT, "-C", str(ROOT), "show", f"{revision}:{source_path}"],
        check=False,
        capture_output=True,
        timeout=5,
    )
    if source.returncode != 0:
        raise RecoveryBlocked(
            "Recovery blocked: failure source provenance is unavailable."
        )
    return hashlib.sha256(source.stdout).hexdigest()


def _number(value: object) -> float | None:
    if isinstance(value, (int, float)) and not isinstance(value, bool):
        return float(value)
    return None


def _classify_corrected_software_interruption() -> CorrectedSoftwareInterruption:
    """Classify a corrected checkpoint defect from its exact raw evidence."""

    failure_raw, failure = _failure_record()
    message = _failure_message(failure)
    failure_time, _ = _timestamp(failure)
    details = failure.get("details")
    source = failure.get("source")
    if (
        set(failure)
        != {
            "details",
            "evidence_version",
            "message",
            "pid",
            "source",
            "state",
            "time",
        }
        or message != CORRECTED_CHECKPOINT_REASON
        or failure.get("state") != "failed"
        or failure.get("evidence_version") != 1
        or failure_time is None
        or not isinstance(failure.get("pid"), int)
        or isinstance(failure.get("pid"), bool)
        or failure.get("pid", 0) <= 0
        or not isinstance(details, dict)
        or set(details) != CORRECTED_CHECKPOINT_DETAIL_FIELDS
        or not isinstance(source, dict)
        or source
        != {
            "component": "ram-tetris",
            "path": CORRECTED_CHECKPOINT_SOURCE_PATH,
            "revision": CORRECTED_CHECKPOINT_SOURCE_REVISION,
            "sha256": CORRECTED_CHECKPOINT_SOURCE_SHA256,
            "version": "0.4.30",
        }
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the latch is not an eligible corrected software "
            "interruption."
        )

    temperatures = details.get("last_temperatures_mc")
    interval = _number(details.get("checkpoint_interval_ms"))
    deadline = _number(details.get("checkpoint_deadline_ms"))
    age = _number(details.get("checkpoint_age_ms"))
    last_age = _number(details.get("last_checkpoint_age_ms"))
    elapsed = _number(details.get("checkpoint_elapsed_ms"))
    duration = _number(details.get("last_checkpoint_duration_ms"))
    started = _number(details.get("checkpoint_started_unix"))
    completed = _number(details.get("last_checkpoint_completed_unix"))
    progress = details.get("writer_progress_count")
    if (
        details.get("failure_kind") != "checkpoint-expired"
        or interval != 250.0
        or deadline != 2000.0
        or age is None
        or age <= interval
        or last_age is None
        or last_age <= interval
        or elapsed is None
        or elapsed < 0
        or elapsed > deadline
        or duration is None
        or duration < 0
        or duration > deadline
        or started is None
        or completed is None
        or started > completed
        or completed > failure_time
        or not isinstance(progress, int)
        or isinstance(progress, bool)
        or progress < 0
        or details.get("kernel_evidence_status") != "captured"
        or details.get("kernel_messages") != []
        or not isinstance(temperatures, dict)
        or set(temperatures) != set(TRANSIENT_SPD_ENDPOINTS)
        or any(
            not isinstance(value, int) or isinstance(value, bool) or value <= 0
            for value in temperatures.values()
        )
        or classify_reason(message).code != "LGT-TET-001"
    ):
        raise RecoveryBlocked(
            "Recovery blocked: checkpoint evidence is not the reviewed corrected "
            "software failure."
        )

    if (
        _source_blob_sha256(
            CORRECTED_CHECKPOINT_SOURCE_REVISION,
            CORRECTED_CHECKPOINT_SOURCE_PATH,
        )
        != CORRECTED_CHECKPOINT_SOURCE_SHA256
    ):
        raise RecoveryBlocked(
            "Recovery blocked: corrected software source provenance changed."
        )
    _verify_corrected_source_revision(CORRECTED_CHECKPOINT_MINIMUM_REVISION)
    return CorrectedSoftwareInterruption(
        failure_raw=failure_raw,
        incident_reference=_incident_reference(failure_raw),
        latch_sha256=hashlib.sha256(failure_raw).hexdigest(),
        original_reason=message,
        failure_time=failure_time,
        source_revision=CORRECTED_CHECKPOINT_SOURCE_REVISION,
        source_path=CORRECTED_CHECKPOINT_SOURCE_PATH,
        source_sha256=CORRECTED_CHECKPOINT_SOURCE_SHA256,
    )


def _classify_shutdown_race_incident() -> ShutdownRaceIncident:
    """Authorize only the exact old-boot SDK latch created during shutdown."""

    failure_raw, failure = _failure_record()
    digest = hashlib.sha256(failure_raw).hexdigest()
    failure_time, _ = _timestamp(failure)
    source = failure.get("source")
    if (
        digest != SHUTDOWN_RACE_LATCH_SHA256
        or _incident_reference(failure_raw) != SHUTDOWN_RACE_REFERENCE
        or set(failure)
        != {
            "details",
            "evidence_version",
            "message",
            "pid",
            "source",
            "state",
            "time",
        }
        or _failure_message(failure) != SHUTDOWN_RACE_REASON
        or failure.get("pid") != SHUTDOWN_RACE_WRITER_PID
        or failure.get("state") != "failed"
        or failure.get("evidence_version") != 1
        or failure_time != SHUTDOWN_RACE_FAILURE_TIME
        or source
        != {
            "component": "ram-tetris",
            "path": SHUTDOWN_RACE_SOURCE_PATH,
            "revision": SHUTDOWN_RACE_SOURCE_REVISION,
            "sha256": SHUTDOWN_RACE_SOURCE_SHA256,
            "version": "0.4.31",
        }
    ):
        raise RecoveryBlocked(
            "Recovery blocked: the latch is not the reviewed old-boot shutdown race."
        )
    if (
        _source_blob_sha256(SHUTDOWN_RACE_SOURCE_REVISION, SHUTDOWN_RACE_SOURCE_PATH)
        != SHUTDOWN_RACE_SOURCE_SHA256
    ):
        raise RecoveryBlocked(
            "Recovery blocked: shutdown-race source provenance changed."
        )
    return ShutdownRaceIncident(
        failure_raw=failure_raw,
        incident_reference=SHUTDOWN_RACE_REFERENCE,
        latch_sha256=digest,
        original_reason=SHUTDOWN_RACE_REASON,
        failure_time=SHUTDOWN_RACE_FAILURE_TIME,
        source_revision=SHUTDOWN_RACE_SOURCE_REVISION,
        source_path=SHUTDOWN_RACE_SOURCE_PATH,
        source_sha256=SHUTDOWN_RACE_SOURCE_SHA256,
    )


