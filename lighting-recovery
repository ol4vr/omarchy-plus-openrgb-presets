        text=True,
        timeout=10,
    )
    if result.returncode != 0 or result.stderr.strip():
        raise RecoveryBlocked(
            "Recovery blocked: historical shutdown journal is unreadable."
        )
    return result.stdout


def _shutdown_race_historical_evidence() -> bytes:
    journal = _shutdown_race_journal_slice(kernel=False)
    kernel = _shutdown_race_journal_slice(kernel=True)
    required = (
