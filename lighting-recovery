def _classify_transient_spd_incident() -> TransientSpdIncident:
    """Classify an exact raw latch without using its display-code mapping."""

    failure_raw, failure = _failure_record()
    message = _failure_message(failure)
    reason = TRANSIENT_SPD_REASON.fullmatch(message)
    failure_time, _ = _timestamp(failure)
    if reason is None or failure.get("state") != "failed" or failure_time is None:
        raise RecoveryBlocked(
            "Recovery blocked: the latch is not an eligible transient SPD failure."
        )
    endpoint = reason.group(1)
    if endpoint not in TRANSIENT_SPD_ENDPOINTS:
        raise RecoveryBlocked(
            "Recovery blocked: the SPD failure endpoint is not approved."
        )

    details = failure.get("details")
    source = failure.get("source")
    if failure.get("evidence_version") == 1 and isinstance(details, dict):
        if (
            details.get("failure_kind") != "spd5118-temperature"
            or details.get("endpoint") != endpoint
            or details.get("sensor") != f"{endpoint}/hwmon/temp1_input"
            or details.get("read_state") not in TRANSIENT_SPD_STRUCTURED_READ_STATES
            or details.get("exception_type") != "OSError"
            or not isinstance(source, dict)
            or source.get("component") != "ram-tetris"
            or source.get("path") != "ram-tetris"
            or not isinstance(source.get("version"), str)
            or not source.get("version")
            or not isinstance(source.get("revision"), str)
            or not isinstance(source.get("sha256"), str)
        ):
            raise RecoveryBlocked(
                "Recovery blocked: structured SPD evidence is not an approved "
                "transient read failure."
            )
        source_revision = source["revision"]
        source_path = source["path"]
        source_sha256 = source["sha256"]
        _verify_corrected_source_revision(source_revision)
        if (
            not re.fullmatch(r"[0-9a-f]{64}", source_sha256)
            or _source_blob_sha256(source_revision, source_path) != source_sha256
        ):
            raise RecoveryBlocked(
                "Recovery blocked: structured SPD source provenance changed."
            )
        classification = "structured-kernel-read-error"
    else:
        if set(failure) != {"message", "pid", "state", "time"}:
            raise RecoveryBlocked(
                "Recovery blocked: legacy SPD evidence has an unknown schema."
            )
        _verify_corrected_source_revision(LEGACY_TRANSIENT_SPD_REVISION)
        if (
            _source_blob_sha256(
                LEGACY_TRANSIENT_SPD_REVISION,
                LEGACY_TRANSIENT_SPD_SOURCE_PATH,
            )
            != LEGACY_TRANSIENT_SPD_SOURCE_SHA256
        ):
            raise RecoveryBlocked(
                "Recovery blocked: legacy v0.4.27 source provenance changed."
            )
        source_revision = LEGACY_TRANSIENT_SPD_REVISION
        source_path = LEGACY_TRANSIENT_SPD_SOURCE_PATH
        source_sha256 = LEGACY_TRANSIENT_SPD_SOURCE_SHA256
        classification = "legacy-read-or-parse-error"

    return TransientSpdIncident(
        failure_raw=failure_raw,
        incident_reference=_incident_reference(failure_raw),
        latch_sha256=hashlib.sha256(failure_raw).hexdigest(),
        original_reason=message,
        endpoint=endpoint,
        failure_time=failure_time,
        classification=classification,
        source_revision=source_revision,
        source_path=source_path,
        source_sha256=source_sha256,
    )


def _timestamp(value: dict[str, object]) -> tuple[float | None, str]:
    timestamp = value.get("time")
    if not isinstance(timestamp, (int, float)) or isinstance(timestamp, bool):
        return None, "Unknown"
    try:
        rendered = datetime.fromtimestamp(float(timestamp), UTC).isoformat(
            timespec="seconds"
        )
    except (OverflowError, OSError, ValueError):
        return None, "Unknown"
    return float(timestamp), rendered.replace("+00:00", "Z")


